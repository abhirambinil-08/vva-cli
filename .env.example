# Required: NVIDIA NIM API Key (Bearer token)
NVIDIA_API_KEY="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"
# Optional: Target LLM model hosted on NVIDIA NIM
# Recommended active models:
#   - nvidia/llama-3.1-nemotron-70b-instruct (Default high-precision)
#   - mistralai/mistral-large-2-instruct
#   - mistralai/mistral-7b-instruct-v0.3
#   - openai/gpt-oss-20b
NVIDIA_MODEL="openai/gpt-oss-20b"

# Optional: NVIDIA NIM API endpoint base URL
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"