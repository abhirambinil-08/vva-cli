nil1@gmail.com',\\n        date: '2026-10-19 09:12:30 UTC',\\n        message: 'Implement JWT authentication and refresh token rotation',\\n        branch: 'main',\\n        diffSummary: {\\n          filesChanged: 2,\\n          insertions: 64,\\n          deletions: 8,\\n        },\\n        changedFiles: [\\n          {\\n            file: 'src/auth/jwt.js',\\n            status: 'A', // Added file\\n            additions: 44,\\n            deletions: 0,\\n            content: `import jwt from 'jsonwebtoken';\\nimport crypto from 'crypto';\\n\\nconst JWT_SECRET = process.env.JWT_SECRET || 'dev_secret_key_vva';\\nconst REFRESH_SECRET = process.env.REFRESH_SECRET || 'dev_refresh_key_vva';\\n\\nexport function signAccessToken(payload) {\\n  return jwt.sign(payload, JWT_SECRET, {\\n    expiresIn: '15m',\\n    algorithm: 'HS256'\\n  });\\n}\\n\\nexport function signRefreshToken(userId) {\\n  const token = crypto.randomBytes(40).toString('hex');\\n  return {\\n    refreshToken: token,\\n    expiresAt: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000)\\n  };\\n}\\n\\nexport function verifyAccessToken(token) {\\n  try {\\n    return jwt.verify(token, JWT_SECRET);\\n  } catch (err) {\\n    return null;\\n  }\\n}`,\\n            diff: `@@ -0,0 +1,44 @@\\n+import jwt from 'jsonwebtoken';\\n+import crypto from 'crypto';\\n+\\n+const JWT_SECRET = process.env.JWT_SECRET || 'dev_secret_key_vva';\\n+const REFRESH_SECRET = process.env.REFRESH_SECRET || 'dev_refresh_key_vva';\\n+\\n+export function signAccessToken(payload) {\\n+  return jwt.sign(payload, JWT_SECRET, { expiresIn: '15m', algorithm: 'HS256' });\\n+}\\n+\\n+export function signRefreshToken(userId) {\\n+  const token = crypto.randomBytes(40).toString('hex');\\n+  return { refreshToken: token, expiresAt: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000) };\\n+}`\\n          },\\n          {\\n            file: 'src/auth/login.js',\\n            status: 'M',\\n            additions: 20,\\n            deletions: 8,\\n            content: `import bcrypt from 'bcrypt';\\nimport { signAccessToken, signRefreshToken } from './jwt.js';\\nimport { db } from '../db.js';\\n\\nexport async function loginHandler(req, res) {\\n  const { email, password } = req.body;\\n  const user = await db('users').where({ email }).first();\\n\\n  if (!user || !(await bcrypt.compare(password, user.password_hash))) {\\n    return res.status(401).json({ error: 'Invalid credentials' });\\n  }\\n\\n  const accessToken = signAccessToken({ id: user.id, role: user.role });\\n  const { refreshToken, expiresAt } = signRefreshToken(user.id);\\n\\n  await db('refresh_tokens').insert({ user_id: user.id, token: refreshToken, expires_at: expiresAt });\\n\\n  return res.json({ accessToken, refreshToken });\\n}`,\\n            diff: `@@ -6,8 +6,20 @@ export async function loginHandler(req, res) {\\n   if (!user || !(await bcrypt.compare(password, user.password_hash))) {\\n     return res.status(401).json({ error: 'Invalid credentials' });\\n   }\\n-  req.session.userId = user.id;\\n-  return res.json({ status: 'ok' });\\n+  const accessToken = signAccessToken({ id: user.id, role: user.role });\\n+  const { refreshToken, expiresAt } = signRefreshToken(user.id);\\n+  await db('refresh_tokens').insert({ user_id: user.id, token: refreshToken, expires_at: expiresAt });\\n+  return res.json({ accessToken, refreshToken });\\n }`\\n          }\\n        ]\\n      }\\n    ]\\n  }\\n];\\n\\nexport const INITIAL_VVA_CONFIG = {\\n  version: '1.0.0-rc1',\\n  defaultFormat: 'all' as const,\\n  outputDir: '.vva/output',\\n  aiProvider: 'nvidia' as const,\\n  aiModel: 'meta/llama-3.1-70b-instruct',\\n  maxDiffSizeBytes: 1048576, // 1MB payload cap\\n  includePreviousVersionOnDelete: true,\\n  team: {\\n    leadOrchestration: 'Abhiram Binil (Person 1)',\\n    aiEngine: 'Vishnu G Pillai (Person 2)',\\n    documentEngine: 'Vinay Bisht (Person 3)'\\n  }\\n};\"\n    },\n    {\n      \"file\": \"src/index.css\",\n      \"status\": \"A\",\n      \"additions\": 0,\n      \"deletions\": 0,\n      \"content\": \"@import \\\"tailwindcss\\\";\\n\\n@layer base {\\n  :root {\\n    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\\n    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\\n  }\\n  \\n  body {\\n    font-family: var(--font-sans);\\n  }\\n  \\n  code, pre, kbd, samp {\\n    font-family: var(--font-mono);\\n  }\\n}\\n\\n/* Custom scrollbars for code and logs */\\n::-webkit-scrollbar {\\n  width: 6px;\\n  height: 6px;\\n}\\n::-webkit-scrollbar-track {\\n  background: rgba(15, 23, 42, 0.6);\\n}\\n::-webkit-scrollbar-thumb {\\n  background: rgba(71, 85, 105, 0.4);\\n  border-radius: 3px;\\n}\\n::-webkit-scrollbar-thumb:hover {\\n  background: rgba(100, 116, 139, 0.6);\\n}\"\n    },\n    {\n      \"file\": \"src/main.tsx\",\n      \"status\": \"A\",\n      \"additions\": 0,\n      \"deletions\": 0,\n      \"content\": \"import {createRoot} from 'react-dom/client';\\nimport App from './App.tsx';\\nimport './index.css';\\n\\ncreateRoot(document.getElementById('root')!).render(<App />);\"\n    },\n    {\n      \"file\": \"src/types/vva.ts\",\n      \"status\": \"A\",\n      \"additions\": 0,\n      \"deletions\": 0,\n      \"content\": \"export type FileStatus = 'A' | 'M' | 'D';\\n\\nexport interface ChangedFile {\\n  file: string;\\n  status: FileStatus; // A = Added, M = Modified, D = Deleted\\n  additions: number;\\n  deletions: number;\\n  content: string; // Committed file content or pre-deletion content\\n  diff: string; // The specific patch\\n}\\n\\nexport interface GitCommit {\\n  hash: string;\\n  shortHash: string;\\n  parentHash?: string;\\n  author: string;\\n  email: string;\\n  date: string;\\n  message: string;\\n  branch: string;\\n  changedFiles: ChangedFile[];\\n  diffSummary: {\\n    filesChanged: number;\\n    insertions: number;\\n    deletions: number;\\n  };\\n}\\n\\nexport interface Repository {\\n  id: string;\\n  name: string;\\n  description: string;\\n  path: string;\\n  currentBranch: string;\\n  branches: string[];\\n  commits: GitCommit[];\\n}\\n\\nexport interface ProjectDataJSON {\\n  vvaVersion: string;\\n  timestamp: string;\\n  repository: string;\\n  repositoryPath: string;\\n  branch: string;\\n  analyzedCommit: string;\\n  parentCommit: string | null;\\n  author: {\\n    name: string;\\n    email: string;\\n    date: string;\\n  };\\n  commitMessage: string;\\n  summary: {\\n    filesChanged: number;\\n    insertions: number;\\n    deletions: number;\\n  };\\n  changedFiles: {\\n    file: string;\\n    status: FileStatus;\\n    additions: number;\\n    deletions: number;\\n    content: string;\\n  }[];\\n  diff: string;\\n}\\n\\nexport interface AIStructuredResponse {\\n  title: string;\\n  summary: string;\\n  purposeAndRationale: string;\\n  changedComponents: string[];\\n  technicalChanges: string[];\\n  technologies: string[];\\n  architecturalImpact: string;\\n  observationsAndLimitations: string[];\\n  confidenceScore: number;\\n  model: string;\\n  processingTimeMs: number;\\n}\\n\\nexport interface GeneratedDocument {\\n  id: string;\\n  type: 'pdf' | 'docx' | 'pptx';\\n  filename: string;\\n  title: string;\\n  commitHash: string;\\n  repository: string;\\n  generatedAt: string;\\n  fileSizeBytes: number;\\n  content: any;\\n}\\n\\nexport interface VVAConfig {\\n  version: string;\\n  defaultFormat: 'pdf' | 'docx' | 'pptx' | 'all';\\n  outputDir: string;\\n  aiProvider: 'nvidia' | 'gemini';\\n  aiModel: string;\\n  maxDiffSizeBytes: number;\\n  includePreviousVersionOnDelete: boolean;\\n  team: {\\n    leadOrchestration: string;\\n    aiEngine: string;\\n    documentEngine: string;\\n  };\\n}\"\n    },\n    {\n      \"file\": \"src/utils/docxExporter.ts\",\n      \"status\": \"A\",\n      \"additions\": 0,\n      \"deletions\": 0,\n      \"content\": \"import { ProjectDataJSON, AIStructuredResponse } from '../types/vva';\\n\\nexport function exportWordDocx(\\n  projectData: ProjectDataJSON,\\n  aiAnalysis: AIStructuredResponse\\n): void {\\n  const content = `\\n    <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>\\n    <head>\\n      <meta charset=\\\"utf-8\\\">\\n      <title>${aiAnalysis.title}</title>\\n      <style>\\n        body { font-family: 'Calibri', 'Segoe UI', sans-serif; line-height: 1.5; color: #1e293b; padding: 40px; }\\n        h1 { color: #0f172a; border-bottom: 2px solid #0284c7; padding-bottom: 6px; font-size: 24pt; margin-bottom: 4px; }\\n        .subtitle { color: #64748b; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px; }\\n        .meta-box { background-color: #f8fafc; border: 1px solid #cbd5e1; padding: 14px; margin-bottom: 24px; border-radius: 4px; }\\n        .meta-table { width: 100%; border-collapse: collapse; font-size: 10pt; }\\n        .meta-table td { padding: 4px 8px; vertical-align: top; }\\n        .meta-label { font-weight: bold; color: #475569; width: 120px; }\\n        h2 { color: #1e3a8a; font-size: 14pt; margin-top: 20px; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; }\\n        p { font-size: 11pt; margin-bottom: 10px; }\\n        ul { margin-top: 4px; padding-left: 20px; }\\n        li { font-size: 10.5pt; margin-bottom: 6px; }\\n        .code-file { font-family: 'Consolas', monospace; font-size: 9.5pt; background: #f1f5f9; padding: 2px 6px; border-radius: 3px; }\\n        .tag { font-weight: bold; font-size: 8.5pt; padding: 2px 6px; }\\n        .tag-A { color: #15803d; }\\n        .tag-M { color: #0369a1; }\\n        .tag-D { color: #b91c1c; }\\n        .footer { margin-top: 40px; border-top: 1px solid #cbd5e1; padding-top: 10px; font-size: 9pt; color: #94a3b8; text-align: center; }\\n      </style>\\n    </head>\\n    <body>\\n      <h1>${aiAnalysis.title}</h1>\\n      <div class=\\\"subtitle\\\">VVA Project Technical Synopsis &amp; Implementation Report</div>\\n\\n      <div class=\\\"meta-box\\\">\\n        <table class=\\\"meta-table\\\">\\n          <tr>\\n            <td class=\\\"meta-label\\\">Project Repository:</td>\\n            <td><strong>${projectData.repository}</strong> (${projectData.branch})</td>\\n            <td class=\\\"meta-label\\\">Author:</td>\\n            <td>${projectData.author.name} &lt;${projectData.author.email}&gt;</td>\\n          </tr>\\n          <tr>\\n            <td class=\\\"meta-label\\\">Analyzed Commit:</td>\\n            <td><code>${projectData.analyzedCommit}</code></td>\\n            <td class=\\\"meta-label\\\">Commit Date:</td>\\n            <td>${projectData.author.date}</td>\\n          </tr>\\n          <tr>\\n            <td class=\\\"meta-label\\\">Parent Commit:</td>\\n            <td><code>${projectData.parentCommit || 'Root Commit (none)'}</code></td>\\n            <td class=\\\"meta-label\\\">Diff Summary:</td>\\n            <td>${projectData.summary.filesChanged} file(s) changed, +${projectData.summary.insertions} / -${projectData.summary.deletions}</td>\\n          </tr>\\n        </table>\\n      </div>\\n\\n      <h2>1. Project Synopsis &amp; Intent</h2>\\n      <p>${aiAnalysis.summary}</p>\\n      <p><strong>Rationale:</strong> ${aiAnalysis.purposeAndRationale}</p>\\n\\n      <h2>2. Technical Changes Implemented</h2>\\n      <ul>\\n        ${aiAnalysis.technicalChanges.map(change => `<li>${change}</li>`).join('')}\\n      </ul>\\n\\n      <h2>3. Code Components Affected (Git State Trace)</h2>\\n      <ul>\\n        ${projectData.changedFiles.map(f => `\\n          <li>\\n            <span class=\\\"tag tag-${f.status}\\\">[${f.status === 'A' ? 'ADDED' : f.status === 'M' ? 'MODIFIED' : 'DELETED'}]</span>\\n            <span class=\\\"code-file\\\">${f.file}</span>\\n            — ${f.additions} insertions(+), ${f.deletions} deletions(-)\\n          </li>\\n        `).join('')}\\n      </ul>\\n\\n     