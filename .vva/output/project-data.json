hangedFiles(resolvedCommitHash, repoRoot);\\n\\n  const warnings = [];\\n\\n  // Collect commit-specific file contents\\n  const changedFiles = [];\\n  for (const item of changedFilesMeta) {\\n    const isDeleted = item.status === 'D';\\n    let content = await getFileContentAtCommit(resolvedCommitHash, item.file, isDeleted, repoRoot);\\n\\n    // Safeguard against huge single files\\n    if (content.length > 500 * 1024) {\\n      content = content.slice(0, 500 * 1024) + '\\\\n\\\\n[VVA Warning: File content truncated exceeding 500KB]';\\n      warnings.push(`File ${item.file} content truncated for payload safety.`);\\n    }\\n\\n    // Determine line count delta\\n    let additions = 0;\\n    let deletions = 0;\\n    try {\\n      const numstatRaw = await execGit(['diff-tree', '--numstat', resolvedCommitHash, '--', item.file], repoRoot);\\n      const [addStr, delStr] = numstatRaw.split('\\\\t');\\n      additions = addStr && addStr !== '-' ? parseInt(addStr, 10) : 0;\\n      deletions = delStr && delStr !== '-' ? parseInt(delStr, 10) : 0;\\n    } catch {\\n      // Fallback\\n    }\\n\\n    changedFiles.push({\\n      file: item.file,\\n      status: item.status,\\n      additions,\\n      deletions,\\n      content\\n    });\\n  }\\n\\n  // Collect unified diff\\n  let diff = await getCommitDiff(resolvedCommitHash, repoRoot);\\n  const maxDiffBytes = options.maxDiffSizeBytes || DEFAULT_MAX_DIFF_BYTES;\\n  if (Buffer.byteLength(diff, 'utf8') > maxDiffBytes) {\\n    diff = diff.slice(0, maxDiffBytes) + '\\\\n\\\\n[VVA Warning: Diff patch truncated due to maxDiffSizeBytes limit]';\\n    warnings.push(`Unified diff exceeded ${maxDiffBytes} bytes and was safely truncated.`);\\n  }\\n\\n  return {\\n    vvaVersion: '1.0.0',\\n    timestamp: new Date().toISOString(),\\n    repository: repoName,\\n    repositoryPath: repoRoot,\\n    branch,\\n    analyzedCommit: resolvedCommitHash,\\n    parentCommit: parentHash,\\n    author: {\\n      name: metadata.author,\\n      email: metadata.email,\\n      date: metadata.date\\n    },\\n    commitMessage: metadata.message,\\n    summary: {\\n      filesChanged: stats.filesChanged || changedFiles.length,\\n      insertions: stats.insertions,\\n      deletions: stats.deletions\\n    },\\n    changedFiles,\\n    diff,\\n    ...(warnings.length > 0 ? { warnings } : {})\\n  };\\n}\"\n+    },\n+    {\n+      \"file\": \"src/core/git.js\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import { execFile } from 'node:child_process';\\nimport { promisify } from 'node:util';\\nimport path from 'node:path';\\n\\nconst execFileAsync = promisify(execFile);\\n\\n/**\\n * Executes a Git command safely using argument arrays to prevent shell injection.\\n * @param {string[]} args Git subcommands and arguments\\n * @param {string} cwd Working directory\\n * @returns {Promise<string>} stdout output\\n */\\nexport async function execGit(args, cwd = process.cwd()) {\\n  try {\\n    const { stdout } = await execFileAsync('git', args, {\\n      cwd,\\n      maxBuffer: 20 * 1024 * 1024, // 20MB buffer for diffs\\n      env: { ...process.env, LANG: 'C.UTF-8' }\\n    });\\n    return stdout.trim();\\n  } catch (error) {\\n    throw new Error(`Git command failed [git ${args.join(' ')}]: ${error.stderr || error.message}`);\\n  }\\n}\\n\\n/**\\n * Checks if a directory is inside a Git working tree.\\n */\\nexport async function isGitRepo(cwd = process.cwd()) {\\n  try {\\n    const res = await execGit(['rev-parse', '--is-inside-work-tree'], cwd);\\n    return res === 'true';\\n  } catch {\\n    return false;\\n  }\\n}\\n\\n/**\\n * Retrieves the absolute top-level directory of the Git repository.\\n */\\nexport async function getRepoRoot(cwd = process.cwd()) {\\n  return await execGit(['rev-parse', '--show-toplevel'], cwd);\\n}\\n\\n/**\\n * Retrieves the current branch name (or HEAD detached hash).\\n */\\nexport async function getCurrentBranch(cwd = process.cwd()) {\\n  try {\\n    const branch = await execGit(['rev-parse', '--abbrev-ref', 'HEAD'], cwd);\\n    return branch !== 'HEAD' ? branch : await execGit(['rev-parse', '--short', 'HEAD'], cwd);\\n  } catch {\\n    return 'unknown';\\n  }\\n}\\n\\n/**\\n * Retrieves parent commit hash if available.\\n */\\nexport async function getParentCommit(commitHash, cwd = process.cwd()) {\\n  try {\\n    return await execGit(['rev-parse', '--verify', '--quiet', `${commitHash}^`], cwd);\\n  } catch {\\n    // Initial/root commit has no parent\\n    return null;\\n  }\\n}\\n\\n/**\\n * Retrieves detailed commit metadata for a specific commit hash.\\n */\\nexport async function getCommitDetails(commitHash, cwd = process.cwd()) {\\n  const delimiter = '---VVA_DELIM---';\\n  const format = `%H${delimiter}%h${delimiter}%an${delimiter}%ae${delimiter}%ad${delimiter}%B`;\\n  const raw = await execGit(['show', '-s', `--format=${format}`, '--date=iso-strict', commitHash], cwd);\\n  \\n  const [hash, shortHash, authorName, authorEmail, date, ...msgParts] = raw.split(delimiter);\\n  return {\\n    hash: hash.trim(),\\n    shortHash: shortHash.trim(),\\n    author: authorName.trim(),\\n    email: authorEmail.trim(),\\n    date: date.trim(),\\n    message: msgParts.join(delimiter).trim()\\n  };\\n}\\n\\n/**\\n * Retrieves changed files with their status flags (A, M, D, R) for a commit.\\n */\\nexport async function getCommitChangedFiles(commitHash, cwd = process.cwd()) {\\n  const isRoot = !(await getParentCommit(commitHash, cwd));\\n  const diffArgs = isRoot\\n    ? ['diff-tree', '--no-commit-id', '--name-status', '-r', '--root', commitHash]\\n    : ['diff-tree', '--no-commit-id', '--name-status', '-r', commitHash];\\n\\n  const raw = await execGit(diffArgs, cwd);\\n  if (!raw) return [];\\n\\n  const lines = raw.split('\\\\n').filter(Boolean);\\n  return lines.map(line => {\\n    const parts = line.split('\\\\t');\\n    const rawStatus = parts[0];\\n    const filePath = parts[1];\\n    \\n    // Normalize status: A, M, D, R\\n    let status = 'M';\\n    if (rawStatus.startsWith('A')) status = 'A';\\n    else if (rawStatus.startsWith('D')) status = 'D';\\n    else if (rawStatus.startsWith('R')) status = 'R';\\n\\n    return {\\n      status,\\n      file: filePath\\n    };\\n  });\\n}\\n\\n/**\\n * Retrieves the committed version of a file at a specific commit.\\n * For deleted files, inspects the parent commit.\\n */\\nexport async function getFileContentAtCommit(commitHash, filePath, isDeleted = false, cwd = process.cwd()) {\\n  try {\\n    const targetRef = isDeleted ? `${commitHash}^:${filePath}` : `${commitHash}:${filePath}`;\\n    return await execGit(['show', targetRef], cwd);\\n  } catch (error) {\\n    return `[VVA Warning: Could not retrieve committed content for ${filePath}: ${error.message}]`;\\n  }\\n}\\n\\n/**\\n * Retrieves the exact unified patch for a commit.\\n */\\nexport async function getCommitDiff(commitHash, cwd = process.cwd()) {\\n  const isRoot = !(await getParentCommit(commitHash, cwd));\\n  const args = isRoot\\n    ? ['show', '--format=', '--patch', '--root', commitHash]\\n    : ['show', '--format=', '--patch', commitHash];\\n\\n  return await execGit(args, cwd);\\n}\\n\\n/**\\n * Retrieves insertion and deletion stats for a commit.\\n */\\nexport async function getCommitStats(commitHash, cwd = process.cwd()) {\\n  const isRoot = !(await getParentCommit(commitHash, cwd));\\n  const args = isRoot\\n    ? ['diff-tree', '--shortstat', '--root', commitHash]\\n    : ['diff-tree', '--shortstat', commitHash];\\n\\n  try {\\n    const raw = await execGit(args, cwd);\\n    // e.g., \\\" 2 files changed, 28 insertions(+), 4 deletions(-)\\\"\\n    const filesMatch = raw.match(/(\\\\d+)\\\\s+file/);\\n    const insMatch = raw.match(/(\\\\d+)\\\\s+insertion/);\\n    const delMatch = raw.match(/(\\\\d+)\\\\s+deletion/);\\n\\n    return {\\n      filesChanged: filesMatch ? parseInt(filesMatch[1], 10) : 0,\\n      insertions: insMatch ? parseInt(insMatch[1], 10) : 0,\\n      deletions: delMatch ? parseInt(delMatch[1], 10) : 0\\n    };\\n  } catch {\\n    return { filesChanged: 0, insertions: 0, deletions: 0 };\\n  }\\n}\"\n+    },\n+    {\n+      \"file\": \"src/core/python.js\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import { execFile } from 'node:child_process';\\nimport { promisify } from 'node:util';\\nimport path from 'node:path';\\nimport fs from 'node:fs/promises';\\nimport { fileURLToPath } from 'node:url';\\n\\nconst execFileAsync = promisify(execFile);\\n\\n// src/core/python.js -> VVA package root\\nconst VVA_PACKAGE_ROOT = path.resolve(\\n  path.dirname(fileURLToPath(import.meta.url)),\\n  '../..'\\n);\\n\\n/**\\n * Discovers the active Python binary (python3 or python).\\n */\\nexport async function getPythonBinary() {\\n  try {\\n    await execFileAsync('python3', ['--version']);\\n    return 'python3';\\n  } catch {\\n    try {\\n      await execFileAsync('python', ['--version']);\\n      return 'python';\\n    } catch {\\n      throw new Error(\\n        'Python 3 is required but neither \\\"python3\\\" nor \\\"python\\\" was found in PATH.'\\n      );\\n    }\\n  }\\n}\\n\\n/**\\n * Runs an internal VVA Python script while using the target repository\\n * as the working directory.\\n *\\n * @param {string} scriptRelativePath Path relative to the VVA package root.\\n * @param {string[]} args Command-line arguments.\\n * @param {string} cwd Target repository working directory.\\n */\\nexport async function invokePythonModule(\\n  scriptRelativePath,\\n  args = [],\\n  cwd = process.cwd()\\n) {\\n  const pythonBin = await getPythonBinary();\\n\\n  // Internal scripts belong to VVA, not the target repository.\\n  const scriptPath = path.resolve(VVA_PACKAGE_ROOT, scriptRelativePath);\\n\\n  try {\\n    await fs.access(scriptPath);\\n  } catch {\\n    throw new Error(`VVA Python module not found at: ${scriptPath}`);\\n  }\\n\\n  try {\\n    const { stdout, stderr } = await execFileAsync(\\n      pythonBin,\\n      [scriptPath, ...args],\\n      {\\n        cwd,\\n        maxBuffer: 20 * 1024 * 1024,\\n        env: {\\n          ...process.env,\\n          PYTHONUNBUFFERED: '1'\\n        }\\n      }\\n    );\\n\\n    if (stderr?.trim()) {\\n      process.stderr.write(`[VVA Python warning] ${stderr.trim()}\\\\n`);\\n    }\\n\\n    return stdout.trim();\\n  } catch (error) {\\n    throw new Error(\\n      `Python execution failed for ${scriptRelativePath}: ${\\n        error.stderr || error.message\\n      }`\\n    );\\n  }\\n}\"\n+    },\n+    {\n+      \"file\": \"src/data/mockRepositories.ts\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import { Repository } from '../types/vva';\\n\\nexport const SAMPLE_REPOSITORIES: Repository[] = [\\n  {\\n    id: 'minidesk',\\n    name: 'MiniDesk',\\n    description: 'Cloud ticket-management and customer support orchestrator',\\n    path: '/workspace/projects/minidesk',\\n    currentBranch: 'main',\\n    branches: ['main', 'feature/ticket-filter', 'fix/validation-bug'],\\n    commits: [\\n      {\\n        hash: 'e8f190c74b88d423984501a239b03947e5b290df',\\n        shortHash: 'e8f190c',\\n        parentHash: '7a2c89b418d193d5089f2a44bb012c85e2b92134',\\n        author: 'Abhiram Binil',\\n        email: 'Abhirambinil1@gmail.com',\\n        date: '2026-10-19 10:45:00 UTC',\\n        message: 'Add ticket filtering and status query parameters',\\n        branch: 'main',\\n        diffSummary: {\\n          filesChanged: 2,\\n          insertions: 38,\\n          deletions: 4,\\n        },\\n        changedFiles: [\\n          {\\n            file: 'src/tickets/ticket.controller.js',\\n            status: 'M',\\n            additions: 26,\\n            deletions: 4,\\n            content: `import { TicketService } from '../services/ticket.service.js';\\nimport { validateFilterQuery } from '../middleware