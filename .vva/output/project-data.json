ssName=\\\"flex items-center gap-1\\\">\\n                  {slides.map((_, i) => (\\n                    <button\\n                      key={i}\\n                      onClick={() => setCurrentSlide(i)}\\n                      className={`w-2.5 h-2.5 rounded-full transition-colors ${\\n                        i === currentSlide ? 'bg-amber-500' : 'bg-slate-700 hover:bg-slate-600'\\n                      }`}\\n                    />\\n                  ))}\\n                </div>\\n                <button\\n                  onClick={() => setCurrentSlide(prev => Math.min(slides.length - 1, prev + 1))}\\n                  disabled={currentSlide === slides.length - 1}\\n                  className=\\\"p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded disabled:opacity-30 transition-colors\\\"\\n                >\\n                  <ChevronRight className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* Slide Screen (16:9 Aspect Ratio) */}\\n            <div className=\\\"w-full aspect-[16/9] bg-slate-950 border-2 border-slate-800 rounded-xl shadow-2xl flex flex-col overflow-hidden relative\\\">\\n              {/* Slide Top Banner */}\\n              <div className=\\\"flex items-center justify-between px-6 py-3 bg-slate-900 border-b border-slate-800 text-xs\\\">\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-3 h-3 rounded-sm bg-amber-500\\\" />\\n                  <span className=\\\"font-bold text-white tracking-wide\\\">VVA Presentation Deck</span>\\n                </div>\\n                <span className=\\\"text-slate-500 font-mono text-[11px]\\\">{projectData.repository} · {projectData.branch}</span>\\n              </div>\\n\\n              {/* Slide Body */}\\n              <div className=\\\"flex-1 overflow-y-auto\\\">\\n                {slides[currentSlide].content}\\n              </div>\\n\\n              {/* Slide Footer */}\\n              <div className=\\\"flex items-center justify-between px-6 py-2.5 bg-slate-900/60 border-t border-slate-800/80 text-[11px] text-slate-500\\\">\\n                <span>VVA · Version &amp; Workflow Automator</span>\\n                <span>Slide {currentSlide + 1} / {slides.length}</span>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </div>\\n  );\\n};\"\n    },\n    {\n      \"file\": \"src/components/GitCollectorView.tsx\",\n      \"status\": \"A\",\n      \"additions\": 0,\n      \"deletions\": 0,\n      \"content\": \"import React, { useState } from 'react';\\nimport { GitBranch, GitCommit as GitCommitIcon, FileCode, Plus, Minus, Copy, Check, Info, FilePlus, FileEdit, Trash2, ShieldAlert } from 'lucide-react';\\nimport { Repository, GitCommit, ChangedFile, ProjectDataJSON, VVAConfig } from '../types/vva';\\nimport { buildProjectDataJSON } from '../utils/orchestrator';\\n\\ninterface GitCollectorViewProps {\\n  repositories: Repository[];\\n  currentRepo: Repository;\\n  onSelectRepo: (repo: Repository) => void;\\n  selectedCommit: GitCommit;\\n  onSelectCommit: (commit: GitCommit) => void;\\n  vvaConfig: VVAConfig;\\n  onAddNewCommit: (newCommit: GitCommit) => void;\\n}\\n\\nexport const GitCollectorView: React.FC<GitCollectorViewProps> = ({\\n  repositories,\\n  currentRepo,\\n  onSelectRepo,\\n  selectedCommit,\\n  onSelectCommit,\\n  vvaConfig,\\n  onAddNewCommit,\\n}) => {\\n  const [activeFileIndex, setActiveFileIndex] = useState<number>(0);\\n  const [viewMode, setViewMode] = useState<'diff' | 'committedContent' | 'projectJson'>('diff');\\n  const [copiedJson, setCopiedJson] = useState(false);\\n  const [showNewCommitModal, setShowNewCommitModal] = useState(false);\\n\\n  // Custom Commit Creator state\\n  const [newMsg, setNewMsg] = useState('Refactor authentication middleware');\\n  const [newFile, setNewFile] = useState('src/middleware/auth.js');\\n  const [newStatus, setNewStatus] = u