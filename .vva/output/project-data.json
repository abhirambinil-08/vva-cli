es as PptInches, Pt as PptPt\n+from pptx.dml.color import RGBColor as PptRGBColor\n+\n+\n+def safe_name(value):\n+    return re.sub(r\"[^A-Za-z0-9._-]+\", \"_\", str(value)).strip(\"_\") or \"vva\"\n+\n+\n+def as_list(value):\n+    if isinstance(value, list):\n+        return [str(item) for item in value]\n+    if value:\n+        return [str(value)]\n+    return []\n+\n+\n+def load_json(path):\n+    with Path(path).open(\"r\", encoding=\"utf-8\") as file:\n+        data = json.load(file)\n+    if not isinstance(data, dict):\n+        raise ValueError(f\"Expected a JSON object in {path}\")\n+    return data\n+\n+\n+def make_sections(ai, project):\n+    return [\n+        (\"Executive Summary\", [ai.get(\"summary\", \"Not provided.\")]),\n+        (\"Purpose and Rationale\", [ai.get(\"purposeAndRationale\", \"Not provided.\")]),\n+        (\"Changed Components\", as_list(ai.get(\"changedComponents\"))),\n+        (\"Technical Changes\", as_list(ai.get(\"technicalChanges\"))),\n+        (\"Technologies\", as_list(ai.get(\"technologies\"))),\n+        (\"Architectural Impact\", [ai.get(\"architecturalImpact\", \"Not provided.\")]),\n+        (\"Observations and Limitations\", as_list(ai.get(\"observationsAndLimitations\"))),\n+        (\"Commit Information\", [\n+            f\"Repository: {project.get('repository', 'Unknown')}\",\n+            f\"Branch: {project.get('branch', 'Unknown')}\",\n+            f\"Commit: {project.get('analyzedCommit', 'Unknown')}\",\n+            f\"Commit message: {project.get('commitMessage', 'Not provided')}\",\n+        ]),\n+    ]\n+\n+\n+def create_pdf(ai, project, path):\n+    styles = getSampleStyleSheet()\n+    styles.add(ParagraphStyle(\n+        name=\"VVASection\",\n+        parent=styles[\"Heading2\"],\n+        textColor=colors.HexColor(\"#176B68\"),\n+        spaceBefore=12,\n+        spaceAfter=6,\n+    ))\n+    styles.add(ParagraphStyle(\n+        name=\"VVABody\",\n+        parent=styles[\"BodyText\"],\n+        alignment=TA_LEFT,\n+        leading=15,\n+        spaceAfter=6,\n+    ))\n+\n+    def footer(canvas, doc):\n+        canvas.saveState()\n+        canvas.setFont(\"Helvetica\", 8)\n+        canvas.setFillColor(colors.grey)\n+        canvas.drawString(20 * mm, 12 * mm, \"VVA — Version & Workflow Automator\")\n+        canvas.drawRightString(190 * mm, 12 * mm, f\"Page {doc.page}\")\n+        canvas.restoreState()\n+\n+    doc = SimpleDocTemplate(\n+        str(path),\n+        pagesize=A4,\n+        rightMargin=20 * mm,\n+        leftMargin=20 * mm,\n+        topMargin=20 * mm,\n+        bottomMargin=20 * mm,\n+        title=str(ai.get(\"title\", \"VVA Technical Report\")),\n+    )\n+\n+    story = [\n+        Paragraph(\"VVA Technical Report\", styles[\"Title\"]),\n+        Spacer(1, 6 * mm),\n+        Paragraph(str(ai.get(\"title\", \"Untitled Analysis\")), styles[\"Heading1\"]),\n+        Spacer(1, 4 * mm),\n+    ]\n+\n+    for heading, items in make_sections(ai, project):\n+        story.append(Paragraph(heading, styles[\"VVASection\"]))\n+        if not items:\n+            items = [\"No details provided.\"]\n+        if len(items) == 1:\n+            story.append(Paragraph(items[0], styles[\"VVABody\"]))\n+        else:\n+            bullets = [\n+                ListItem(Paragraph(item, styles[\"VVABody\"]))\n+                for item in items\n+            ]\n+            story.append(ListFlowable(bullets, bulletType=\"bullet\"))\n+        story.append(Spacer(1, 2 * mm))\n+\n+    doc.build(story, onFirstPage=footer, onLaterPages=footer)\n+\n+\n+def create_docx(ai, project, path):\n+    doc = Document()\n+    doc.add_heading(\"VVA Technical Synopsis\", level=0)\n+    doc.add_heading(str(ai.get(\"title\", \"Untitled Analysis\")), level=1)\n+\n+    for heading, items in make_sections(ai, project):\n+        doc.add_heading(heading, level=2)\n+        if not items:\n+            doc.add_paragraph(\"No details provided.\")\n+        elif len(items) == 1:\n+            doc.add_paragraph(items[0])\n+        else:\n+            for item in items:\n+                doc.add_paragraph(item, style=\"List Bullet\")\n+\n+    for section in doc.sections:\n+        section.top_margin = Inches(0.7)\n+        section.bottom_margin = Inches(0.7)\n+\n+    doc.save(str(path))\n+\n+\n+def create_pptx(ai, project, path):\n+    prs = Presentation()\n+    prs.core_properties.title = str(ai.get(\"title\", \"VVA Presentation\"))\n+\n+    slide = prs.slides.add_slide(prs.slide_layouts[0])\n+    slide.shapes.title.text = str(ai.get(\"title\", \"VVA Project Report\"))\n+    slide.placeholders[1].text = (\n+        f\"Repository: {project.get('repository', 'Unknown')}\\n\"\n+        f\"Commit: {project.get('analyzedCommit', 'Unknown')}\"\n+    )\n+\n+    sections = make_sections(ai, project)\n+\n+    for heading, items in sections:\n+        if not items:\n+            items = [\"No details provided.\"]\n+\n+        # Split longer lists across multiple slides.\n+        chunks = [items[i:i + 5] for i in range(0, len(items), 5)]\n+\n+        for chunk in chunks:\n+            slide = prs.slides.add_slide(prs.slide_layouts[1])\n+            slide.shapes.title.text = heading\n+            frame = slide.placeholders[1].text_frame\n+            frame.clear()\n+\n+            for index, item in enumerate(chunk):\n+                paragraph = (\n+                    frame.paragraphs[0]\n+                    if index == 0\n+                    else frame.add_paragraph()\n+                )\n+                paragraph.text = item\n+                paragraph.font.size = PptPt(20)\n+                paragraph.font.color.rgb = PptRGBColor(45, 55, 72)\n+\n+    prs.save(str(path))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser(description=\"VVA document generation engine\")\n+    parser.add_argument(\"--ai-input\", required=True)\n+    parser.add_argument(\"--project-input\", required=True)\n+    parser.add_argument(\"--output-dir\", required=True)\n+    parser.add_argument(\"--format\", choices=[\"pdf\", \"docx\", \"pptx\", \"all\"], default=\"all\")\n+    args = parser.parse_args()\n+\n+    ai = load_json(args.ai_input)\n+    project = load_json(args.project_input)\n+\n+    output_dir = Path(args.output_dir).resolve()\n+    output_dir.mkdir(parents=True, exist_ok=True)\n+\n+    repository = safe_name(project.get(\"repository\", \"vva\"))\n+    commit = safe_name(str(project.get(\"analyzedCommit\", \"unknown\"))[:7])\n+\n+    generators = {\n+        \"pdf\": (\n+            f\"{repository}_{commit}_report.pdf\",\n+            create_pdf,\n+        ),\n+        \"docx\": (\n+            f\"{repository}_{commit}_synopsis.docx\",\n+            create_docx,\n+        ),\n+        \"pptx\": (\n+            f\"{repository}_{commit}_presentation.pptx\",\n+            create_pptx,\n+        ),\n+    }\n+\n+    formats = list(generators) if args.format == \"all\" else [args.format]\n+    results = []\n+\n+    for fmt in formats:\n+        filename, generator = generators[fmt]\n+        output_path = output_dir / filename\n+        generator(ai, project, output_path)\n+\n+        if not output_path.is_file() or output_path.stat().st_size == 0:\n+            raise RuntimeError(f\"Document generation failed: {output_path}\")\n+\n+        results.append({\n+            \"format\": fmt,\n+            \"filename\": filename,\n+            \"path\": str(output_path),\n+            \"sizeBytes\": output_path.stat().st_size,\n+        })\n+\n+    print(json.dumps(results))\n+\n+\n+if __name__ == \"__main__\":\n+    try:\n+        main()\n+    except Exception as exc:\n+        print(f\"VVA Document Engine error: {exc}\", file=sys.stderr)\n+        sys.exit(1)\ndiff --git a/index.html b/index.html\nnew file mode 100644\nindex 0000000..4f0fdec\n--- /dev/null\n+++ b/index.html\n@@ -0,0 +1,20 @@\n+<!doctype html>\n+<html lang=\"en\">\n+  <head>\n+    <meta charset=\"UTF-8\" />\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n+    <title>VVA — Version &amp; Workflow Automator</title>\n+    <meta name=\"description\" content=\"AI-powered Git workflow orchestrator converting developer activity into technical reports, DOCX synopses, and presentations.\" />\n+    <meta property=\"og:title\" content=\"VVA — Version &amp; Workflow Automator\" />\n+    <meta property=\"og:description\" content=\"AI-powered Git workflow orchestrator converting developer activity into technical reports, DOCX synopses, and presentations.\" />\n+    <meta property=\"og:type\" content=\"website\" />\n+    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n+    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n+    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n+    <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\" />\n+  </head>\n+  <body class=\"bg-slate-950 text-slate-100 antialiased font-sans selection:bg-indigo-500/30 selection:text-indigo-200\">\n+    <div id=\"root\"></div>\n+    <script type=\"module\" src=\"/src/main.tsx\"></script>\n+  </body>\n+</html>\ndiff --git a/metadata.json b/metadata.json\nnew file mode 100644\nindex 0000000..7911202\n--- /dev/null\n+++ b/metadata.json\n@@ -0,0 +1,8 @@\n+{\n+  \"name\": \"VVA — Version & Workflow Automator\",\n+  \"description\": \"AI-powered Git workflow orchestrator converting developer activity into technical reports, DOCX synopses, and presentations.\",\n+  \"requestFramePermissions\": [],\n+  \"majorCapabilities\": [\n+    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n+  ]\n+}\ndiff --git a/package.json b/package.json\nnew file mode 100644\nindex 0000000..a0e5449\n--- /dev/null\n+++ b/package.json\n@@ -0,0 +1,41 @@\n+{\n+  \"name\": \"vva-orchestrator\",\n+  \"private\": true,\n+  \"version\": \"0.0.0\",\n+  \"type\": \"module\",\n+  \"scripts\": {\n+    \"dev\": \"vite --port=3000 --host=0.0.0.0\",\n+    \"build\": \"vite build\",\n+    \"preview\": \"vite preview\",\n+    \"clean\": \"rm -rf dist server.js\",\n+    \"lint\": \"tsc --noEmit\",\n+    \"vva\": \"node src/cli.js\"\n+  },\n+  \"bin\": {\n+    \"vva\": \"./bin/vva.js\"\n+  },\n+  \"dependencies\": {\n+    \"@google/genai\": \"^2.4.0\",\n+    \"@tailwindcss/vite\": \"^4.3.3\",\n+    \"@vitejs/plugin-react\": \"^6.1.1\",\n+    \"dotenv\": \"^17.2.3\",\n+    \"express\": \"^4.21.2\",\n+    \"jspdf\": \"^4.2.1\",\n+    \"lucide-react\": \"^0.546.0\",\n+    \"motion\": \"^12.23.24\",\n+    \"react\": \"^19.0.1\",\n+    \"react-dom\": \"^19.0.1\",\n+    \"vite\": \"^8.3.0\"\n+  },\n+  \"devDependencies\": {\n+    \"@types/express\": \"^4.17.21\",\n+    \"@types/node\": \"^22.14.0\",\n+    \"@types/react\": \"^19.3.0\",\n+    \"@types/react-dom\": \"^19.3.0\",\n+    \"autoprefixer\": \"^10.4.21\",\n+    \"esbuild\": \"^0.28.2\",\n+    \"tailwindcss\": \"^4.3.3\",\n+    \"tsx\": \"^4.21.0\",\n+    \"typescript\": \"^7.0.2\"\n+  }\n+}\ndiff --git a/public/assets/aistudio/Paste_October_19__2026_-_11_34PM_90cde589 b/public/assets/aistudio/Paste_October_19__2026_-_11_34PM_90cde589\nnew file mode 100644\nindex 0000000..04cea02\n--- /dev/null\n+++ b/public/assets/aistudio/Paste_October_19__2026_-_11_34PM_90cde589\n@@ -0,0 +1,357 @@\n+VVA — Version & Workflow Automator\n+Complete Project Description · Concept, Architecture, Workflow, Features, Team Responsibilities and Future Scope\n+1. Project overview\n+VVA (Version & Workflow Automator) is an AI-powered Git workflow orchestrator designed to automatically convert a developer's software development activity into meaningful technical documentation.\n+The central idea is to connect three things that normally operate separately:\n+- Git and development workflows — record what changed in a software project.\n+- Artificial intelligence — analyze the changes and explain what the developer accomplished.\n+- Document generation — convert the analysis into professional reports, project synopses, presentations and other technical documents.\n+VVA acts as the coordination layer connecting these components. Instead of requiring developers to manually inspect their Git history, remember what they implemented, write explanations and prepare documents, VVA aims to automate much of that process.\n+The project is intended to work with a developer's existing Git-based workflow. Developers can continue writing code and committing changes normally, while VVA collects relevant information and coordinates its processing.\n+The key distinction: VVA is not simply an AI report generator. It is a workflow orchestrator that connects Git data collection, commit-specific code analysis, AI processing and document generation through a single command-line application.\n+2. The problem VVA solves\n+Software development produces a large amount of useful information over time. Every commit can record a change, a bug fix, a new feature or an improvement. The actual code changes are preserved in Git, but turning this history into understandable technical documentation often requires additional work.\n+For example, a developer might make the following commits:\n+Commit 1: Create user authentication\n+Commit 2: Connect the database\n+Commit 3: Add JWT authorization\n+Commit 4: Fix login validation\n+Commit 5: Implement dashboard filtering\n+\n+\n+Although the repository contains this history, preparing a project report may still require the developer to:\n+- Review multiple commits and modified files.\n+- Identify which features were implemented.\n+- Examine the actual code changes.\n+- Explain the purpose and technical significance of those changes.\n+- Organize the information into a report or presentation.\n+- Repeat this process whenever documentation needs updating.\n+Commit messages alone may not provide enough detail to explain the work accurately. A commit may modify several files, introduce a complex feature or contain both additions and deletions.\n+VVA addresses this problem by collecting the underlying Git information, passing it to an AI engine for analysis, and coordinating the creation of documentation from the resulting structured information.\n+The intended benefit is to reduce repetitive documentation work, improve consistency and make development progress easier to understand.\n+3. The main idea: how VVA works\n+The complete concept follows this pipeline:\n+1. Developer works normally\n+Writes code, modifies files and commits changes through Git\n+\n+2. Git data collector\n+Collects commits, authors, changed files, committed file versions and diffs\n+\n+3. VVA orchestrator\n+Organizes project data and coordinates the processing modules\n+\n+4. AI analysis engine\n+Analyzes code changes and produces structured technical explanations\n+\n+5. Document generation engine\n+Uses the structured analysis to prepare formatted documents\n+\n+6. Final output\n+PDF reports, DOCX documentation, synopses and PowerPoint presentations\n+\n+\n+The developer should not need to manually copy code into an AI chatbot or independently move information between several tools for the standard workflow.\n+The goal is to make the process available through VVA's CLI commands.\n+4. The Git collection system\n+Git is the source of truth for the development history VVA analyzes.\n+VVA must collect more than the repository name or the latest commit message. It should capture enough information to establish what changed, when it changed and which version of the code was associated with the change.\n+Information collected\n+Data\tPurpose\n+Repository name and path\tIdentify the project being analyzed\n+Current branch\tEstablish the development context\n+Commit hash\tUniquely identify a commit\n+Author and date\tRecord who made the change and when\n+Commit message\tCapture the developer's stated intent\n+Changed file paths\tIdentify affected parts of the project\n+File status\tDistinguish added, modified and deleted files\n+Commit-specific file versions\tProvide the code associated with the selected commit\n+Git diff\tShow the exact additions and deletions\n+Recent commit history\tProvide context about recent development\n+VVA can use Git operations such as git log, git diff, git show and related commands to collect this information.\n+Why commit-specific file versions matter\n+Consider this example:\n+Commit A: Add login functionality\n+Commit B: Modify login validation\n+Commit C: Fix a login bug\n+\n+\n+If VVA generates documentation for Commit B, it must analyze the changes introduced by Commit B, rather than accidentally using the newest version from Commit C.\n+That means VVA needs two related pieces of information:\n+- The diff: what changed in the selected commit.\n+- The committed file version: what the file contained at that commit, or immediately before it if the file was deleted.\n+The distinction is essential because the AI should explain the actual work being documented, not an unrelated later version of the project.\n+Handling file states\n+- Added (A): capture the newly committed file.\n+- Modified (M): capture the committed version and the change from its parent.\n+- Deleted (D): capture the previous version from the parent commit and the deletion diff.\n+The first commit in a repository needs special handling because it has no parent. Renames, binary files, merge commits and large diffs also need careful treatment as the collector becomes more robust.\n+5. The AI analysis engine\n+Once Git data has been collected, VVA sends the relevant project information to the Python AI engine.\n+The planned AI integration uses the NVIDIA API. This component is assigned to Person 2.\n+The AI engine should not merely repeat the commit message. It should interpret the commit message alongside the actual code changes and project context.\n+For example, the collected input might contain:\n+Commit: Implement JWT authentication\n+\n+Changed files:\n+- src/auth/login.js\n+- src/auth/jwt.js\n+\n+Diff:\n+[Actual code additions and deletions]\n+\n+\n+The AI could produce a structured explanation containing:\n+- Feature or change title.\n+- Summary of the implementation.\n+- Files and components affected.\n+- Technical changes made.\n+- Purpose of the change, where supported by the code and context.\n+- Technologies and relevant implementation details.\n+- Potential limitations or observations, when evidence supports them.\n+The AI should distinguish facts visible in the code from assumptions about the developer's intent. For example, it should not claim that a feature is secure or fully tested merely because a commit mentions authentication.\n+Structured output\n+The AI should return JSON rather than an unstructured paragraph. A simplified example is:\n+\n+{\n+  \"title\": \"JWT Authentication\",\n+  \"summary\": \"Added JWT-related authentication logic.\",\n+  \"changedComponents\": [\n+    \"src/auth/login.js\",\n+    \"src/auth/jwt.js\"\n+  ],\n+  \"technicalChanges\": [\n+    \"Updated login authentication logic\",\n+    \"Added JWT-related functionality\"\n+  ],\n+  \"technologies\": [\n+    \"JavaScript\",\n+    \"JSON Web Tokens\"\n+  ]\n+}\n+\n+\n+\n+This is an illustrative output contract, not a claim that the current AI engine already produces these exact fields.\n+Structured output allows the document generator to place information into the correct sections without having to interpret an arbitrary text response.\n+6. The document generation engine\n+The third component takes the AI-generated structured data and turns it into professional documents. This is assigned to Person 3.\n+Its responsibility is different from the AI engine:\n+- The AI engine explains the development work.\n+- The document engine formats that explanation into a requested document.\n+- The Node.js orchestrator coordinates the overall process.\n+Planned output formats include:\n+\n+PDF technical report\n+Project details, development summary, implemented features, technical changes and relevant results.\n+\n+\n+\n+DOCX documentation or synopsis\n+Editable project documentation suitable for academic or software-development use.\n+\n+\n+\n+PowerPoint presentation\n+Slides summarizing the project, features, technical implementation and development progress.\n+\n+\n+\n+Meeting summaries and progress reports are also possible extensions of the concept. They should be generated from appropriate input data; VVA's Git history alone cannot reliably reconstruct an actual meeting conversation.\n+The document engine should use reusable templates so the output has consistent headings, formatting, spacing and metadata.\n+7. VVA as an orchestrator\n+Orchestration is the central architectural idea behind the project.\n+VVA is not intended to replace Git, the AI model or the document-generation library. Instead, it coordinates them.\n+Its Node.js layer should be responsible for:\n+1. Receiving a CLI command.\n+2. Identifying the target Git repository.\n+3. Collecting the relevant development data.\n+4. Validating and saving the input as structured JSON.\n+5. Launching the appropriate Python module.\n+6. Passing input to the AI engine and receiving its response.\n+7. Validating the AI output.\n+8. Sending that output to the document generator.\n+9. Saving the generated files in the configured output location.\n+10. Reporting success or errors to the developer.\n+The orchestration layer should also handle situations where a repository is invalid, a commit cannot be resolved, Python fails, the AI API is unavailable, or document generation fails.\n+Intended architecture\n+#chatgpt-mermaid-_r_dci_{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:16px;fill:rgb(237, 237, 237);}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#chatgpt-mermaid-_r_dci_ .edge-animatio