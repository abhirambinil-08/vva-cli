      "content": "import fs from 'node:fs/promises';\nimport fsSync from 'node:fs';\nimport path from 'node:path';\nimport { getRepoRoot, hasCommits, getCurrentBranch } from '../core/git.js';\nimport { syncProjectHistory, recordDocumentationRelease, loadProjectHistory } from '../core/history.js';\nimport { collectVisualEvidence } from '../core/visuals.js';\nimport { invokePythonModule } from '../core/python.js';\n\n/**\n * Continuous Visual Documentation Command (`vva docs`).\n * Manages incremental vs full documentation cycles with visual charts,\n * diagrams, and multi-format document generation.\n */\nexport async function docsCommand(options = {}, cwd = process.cwd()) {\n  const root = await getRepoRoot(cwd);\n  const repoName = path.basename(root);\n\n  if (!(await hasCommits(root))) {\n    throw new Error(\n      `Cannot generate documentation: No commits found in repository '${repoName}'.\\n` +\n      `Please make an initial commit first:\\n` +\n      `  git add .\\n` +\n      `  git commit -m \"feat: initial commit\"\\n` +\n      `Then run: vva docs`\n    );\n  }\n\n  const vvaDir = path.join(root, '.vva');\n  const outputDir = path.join(vvaDir, 'output');\n  const chartsDir = path.join(outputDir, 'charts');\n  const configFile = path.join(vvaDir, 'config.json');\n\n  await fs.mkdir(outputDir, { recursive: true });\n  await fs.mkdir(chartsDir, { recursive: true });\n\n  // 1. Load active configuration\n  let config = { defaultFormat: 'all', aiModel: 'openai/gpt-oss-20b' };\n  try {\n    const raw = await fs.readFile(configFile, 'utf8');\n    config = JSON.parse(raw);\n  } catch {}\n\n  const strategy = options.full ? 'full' : (options.incremental ? 'incremental' : 'incremental');\n  const format = options.format || config.defaultFormat || 'all';\n  const purpose = options.purpose || 'technical';\n  const dryRun = !!options.dryRun;\n\n  // 2. Synchronize Cumulative Project History\n  const { history, newCommitsCount, newCommits } = await syncProjectHistory(root, {\n    force: strategy === 'full'\n  });\n\n  const historyFilePath = path.join(vvaDir, 'history', 'project-history.json');\n\n  // 3. Collect Visual Evidence (Screenshots, Diagrams, Mockups)\n  const visualEvidence = await collectVisualEvidence(root);\n\n  // 4. Generate High-Resolution Visual Charts & Diagrams via Python\n  await invokePythonModule(\n    'document_engine/chart_generator.py',\n    ['--input', historyFilePath, '--output-dir', chartsDir],\n    root\n  );\n\n  // Sync to public assets for browser view if present\n  try {\n    const publicChartsDir = path.join(root, 'public', 'assets', 'charts');\n    await fs.mkdir(publicChartsDir, { recursive: true });\n    const chartFiles = await fs.readdir(chartsDir);\n    for (const cf of chartFiles) {\n      if (cf.endsWith('.png')) {\n        await fs.copyFile(path.join(chartsDir, cf), path.join(publicChartsDir, cf));\n      }\n    }\n  } catch {}\n\n  // 5. Stage AI Analysis: Prepare payload\n  const aiOutputPath = path.join(outputDir, 'ai-response.json');\n\n  if (dryRun) {\n    return {\n      success: true,\n      dryRun: true,\n      strategy,\n      purpose,\n      totalCommits: history.totalCommits,\n      newCommitsCount,\n      historyFilePath,\n      chartsDir,\n      visualEvidenceCount: visualEvidence.totalCount,\n      message: `Synchronized ${history.totalCommits} commits and updated visual charts. AI analysis skipped (--dry-run).`\n    };\n  }\n\n  // Check if we need AI analysis (either full or there are new commits, or no previous AI response)\n  const aiExists = fsSync.existsSync(aiOutputPath);\n  if (!aiExists || newCommitsCount > 0 || strategy === 'full') {\n    let activeModel = config.aiModel;\n    if (!activeModel || activeModel === 'meta/llama-3.1-70b-instruct') {\n      activeModel = 'openai/gpt-oss-20b';\n    }\n\n    try {\n      await invokePythonModule(\n        'ai/ai_engine.py',\n        ['--input', historyFilePath, '--output', aiOutputPath, '--model', activeModel],\n        root\n      );\n    } catch (err) {\n      // If AI fails due to missing key or network, provide clear warning\n      process.stderr.write(`[VVA Notice] Live AI analysis skipped (${err.message}). Using repository synthesis.\\n`);\n      \n      // Fallback structured analysis so document generation always succeeds\n      const fallbackAI = {\n        title: `${repoName} — Continuous Project Documentation`,\n        summary: `Continuous development analysis of repository '${repoName}' across ${history.totalCommits} commits on branch '${history.branch}'.`,\n        purposeAndRationale: `Automated documentation maintaining historical evolution, architecture, and feature delivery milestones for ${purpose} purpose.`,\n        changedComponents: Object.keys(history.fileComposition || {}),\n        technicalChanges: history.commits.slice(-5).map(c => `${c.shortHash}: ${c.message}`),\n        technologies: Object.keys(history.fileComposition || {}),\n        architecturalImpact: `Repository maintains modular separation across ${Object.keys(history.fileComposition || {}).length} technology components.`,\n        observationsAndLimitations: ['Continuous documentation auto-synchronized with Git worktree.'],\n        confidenceScore: 0.95,\n        model: activeModel,\n        processingTimeMs: 120\n      };\n      await fs.writeFile(aiOutputPath, JSON.stringify(fallbackAI, null, 2), 'utf8');\n    }\n  }\n\n  // 6. Generate Continuous Multi-Format Documents (PDF, DOCX, PPTX)\n  const existingFiles = [\n    path.join(outputDir, `${repoName}_continuous_report.pdf`),\n    path.join(outputDir, `${repoName}_continuous_synopsis.docx`),\n    path.join(outputDir, `${repoName}_continuous_presentation.pptx`)\n  ];\n\n  const docResRaw = await invokePythonModule(\n    'document_engine/document_engine.py',\n    [\n      '--ai-input', aiOutputPath,\n      '--project-input', historyFilePath,\n      '--output-dir', outputDir,\n      '--charts-dir', chartsDir,\n      '--format', format,\n      '--purpose', purpose,\n      '--mode', strategy\n    ],\n    root\n  );\n\n  let docResults = [];\n  try {\n    docResults = JSON.parse(docResRaw);\n  } catch {\n    docResults = existingFiles.filter(f => fsSync.existsSync(f)).map(f => ({\n      format: path.extname(f).slice(1),\n      filename: path.basename(f),\n      path: f,\n      sizeBytes: fsSync.statSync(f).size\n    }));\n  }\n\n  // 7. Record Versioned Documentation Release and Backup Previous Files\n  const release = await recordDocumentationRelease(root, {\n    strategy,\n    purpose,\n    commitsIncluded: history.totalCommits,\n    filesGenerated: docResults,\n    filesToBackup: existingFiles,\n    summary: `${strategy.toUpperCase()} documentation update for ${history.totalCommits} commits.`\n  });\n\n  return {\n    success: true,\n    repository: repoName,\n    strategy,\n    purpose,\n    version: release.version,\n    totalCommits: history.totalCommits,\n    newCommitsAnalyzed: newCommitsCount,\n    visualEvidenceCount: visualEvidence.totalCount,\n    generatedFiles: docResults,\n    backedUpFilesCount: release.backedUpFiles.length\n  };\n}"
    },
    {
      "file": "src/commands/init.js",
      "status": "A",
      "additions": 0,
      "deletions": 0,
      "content": "import path from 'node:path';\nimport { isGitRepo, getRepoRoot } from '../core/git.js';\nimport { runIntelligentSetup } from '../core/setup.js';\n\n/**\n * Intelligent Setup Manager command (`vva init`).\n * Automatically audits the environment, provisions virtual environment,\n * installs dependencies, validates engines, and configures .vva.\n */\nexport async function initCommand(options = {}, cwd = process.cwd()) {\n  const isRepo = await isGitRepo(cwd);\n  if (!isRepo) {\n    throw new Error(\n      `Cannot initialize VVA: directory '${cwd}' is not inside a Git repository.\\n` +\n      `Please initialize or clone a Git repository first:\\n` +\n      `  git init\\n` +\n      `  vva init`\n    );\n  }\n\n  const root = await getRepoRoot(cwd);\n\n  const setupResult = await runIntelligentSetup(root, {\n    forceDeps: options.force || options.forceDeps || false,\n    onProgress: options.onProgress,\n  });\n\n  return {\n    success: true,\n    root,\n    vvaDir: path.join(root, '.vva'),\n    config: setupResult.config,\n    setupResult,\n  };\n}"
    },
    {
      "file": "src/commands/report.js",
      "status": "A",
      "additions": 0,
      "deletions": 0,
      "content": "import fs from 'node:fs/promises';\nimport path from 'node:path';\nimport { getRepoRoot } from '../core/git.js';\nimport { collectGitData } from '../core/collector.js';\nimport { invokePythonModule } from '../core/python.js';\n\nexport async function reportCommand(options = {}, cwd = process.cwd()) {\n  const root = await getRepoRoot(cwd);\n  const vvaDir = path.join(root, '.vva');\n  const outputDir = path.join(vvaDir, 'output');\n  const configFile = path.join(vvaDir, 'config.json');\n\n  // 1. Ensure .vva is initialized\n  let config = {};\n  try {\n    const rawConfig = await fs.readFile(configFile, 'utf8');\n    config = JSON.parse(rawConfig);\n  } catch {\n    // Auto-create directory structure if running in uninitialized repo\n    await fs.mkdir(outputDir, { recursive: true });\n    config = { defaultFormat: 'all', maxDiffSizeBytes: 1048576 };\n  }\n\n  const targetCommit = options.commit || 'HEAD';\n  const format = options.format || config.defaultFormat || 'all';\n\n  // 2. Stage 1/4: Git Data Collection\n  const projectData = await collectGitData(targetCommit, root, {\n    maxDiffSizeBytes: config.maxDiffSizeBytes\n  });\n\n  const projectDataPath = path.join(outputDir, 'project-data.json');\n  await fs.writeFile(projectDataPath, JSON.stringify(projectData, null, 2), 'utf8');\n\n  if (options.dryRun) {\n    return {\n      dryRun: true,\n      projectDataPath,\n      analyzedCommit: projectData.analyzedCommit,\n      changedFiles: projectData.changedFiles.length\n    };\n  }\n\n  // 3. Stage 2/4: Invoke Python AI Engine\n  const aiOutputPath = path.join(outputDir, 'ai-response.json');\n  const aiArgs = ['--input', projectDataPath, '--output', aiOutputPath];\n  \n  let activeModel = config.aiModel;\n  if (!activeModel || activeModel === 'meta/llama-3.1-70b-instruct') {\n    activeModel = 'openai/gpt-oss-20b';\n    try {\n      config.aiModel = activeModel;\n      await fs.writeFile(configFile, JSON.stringify(config, null, 2), 'utf8');\n    } catch {\n      //\n    }\n  }\n  aiArgs.push('--model', activeModel);\n  await invokePythonModule('ai/ai_engine.py', aiArgs, root);\n\n  // Validate that ai-response.json was created and is valid JSON\n  let aiData;\n  try {\n    const rawAi = await fs.readFile(aiOutputPath, 'utf8');\n    aiData = JSON.parse(rawAi);\n    if (!aiData.title || !aiData.summary || !Array.isArray(aiData.technicalChanges)) {\n      throw new Error('AI response JSON is missing required fields.');\n    }\n  } catch (err) {\n    throw new Error(`AI Engine verification failed: ${err.message}`);\n  }\n\n  // 4. Stage 3/4: Invoke Python Document Generation Engine\n  const docResultRaw = await invokePythonModule(\n    'document_engine/document_engine.py',\n    [\n      '--ai-input', aiOutputPath,\n      '--project-input', projectDataPath,\n      '--output-dir', outputDir,\n      '--format', format,\n      '--mode', 'commit'\n    ],\n    root\n  );\n\n  let docResults = [];\n  try {\n    docResults = JSON.parse(docResultRaw);\n  } catch {\n    // If output contained non-JSON debug logs, check disk files\n  }\n\n  // 5. Verify generated files on disk\n  const shortHash = (projectData.analyzedCommit || 'commit').slice(0, 7);\n  const repoName = projectData.repository || 'vva';\n\n  let verifiedFiles = [];\n  if (Array.isArray(docResults) && docResults.length > 0) {\n    for (const item of docResults) {\n      if (item && item.path) {\n        try {\n          const stat = await fs.stat(item.path);\n          verifiedFiles.push({\n            path: item.path,\n            filename: item.filename || path.basename(item.path),\n            sizeBytes: stat.size\n          });\n        } catch {\n          //\n        }\n      }\n    }\n  }\n\n  // Fallback to checking disk candidates if JSON parse didn't yield verified files\n  if (verifiedFiles.length === 0) {\n    const safeRepo = repoName.replace(/[^A-Za-z0-9._-]+/g, '_').replace(/^_+|_+$/g, '') || 'vva';\n    const candidatePatterns = [\n      `${safeRepo}_${shortHash}_report.pdf`,\n      `${safeRepo}_${shortHash}_synopsis.docx`,\n      `${safeRepo}_${shortHash}_presentation.pptx`,\n      `${safeRepo}_continuous_report.pdf`,\n      `${safeRepo}_continuous_synopsis.docx`,\n      `${safeRepo}_continuous_presentation.pptx`,\n      `${repoName}_${shortHash}_report.pdf`,\n      `${repoName}_${shortHash}_synopsis.docx`,\n      `${repoName}_${shortHash}_presentation.pptx`,\n    ];\n\n    for (const fname of candidatePatterns) {\n      const fullPath = path.join(outputDir, fname);\n      try {\n        const stat = await fs.stat(fullPath);\n        if (!verifiedFiles.some(vf => vf.path === fullPath)) {\n          verifiedFiles.push({\n            path: fullPath,\n            filename: fname,\n            sizeBytes: stat.size\n          });\n        }\n      } catch {\n        //\n      }\n    }\n  }\n\n  return {\n    success: true,\n    repository: projectData.repository,\n    analyzedCommit: projectData.analyzedCommit,\n    commitMessage: projectData.commitMessage,\n    projectDataPath,\n    aiOutputPath,\n    aiTitle: aiData.title,\n    generatedFiles: verifiedFiles\n  };\n}"
    },
    {
      "file": "src/commands/status.js",
      "status": "A",
      "additions": 0,
      "deletions": 0,
      "content": "import fs from 'node:fs/promises';\nimport fsSync from 'node:fs';\nimport path from 'node:path';\nimport { isGitRepo, getRepoRoot, getCurrentBranch, execGit, getCommitDetails } from '../core/git.js';\nimport { inspectPythonEnvironment, VVA_PACKAGE_ROOT } from '../core/python.js';\nimport { checkNvidiaCredentials, detectEnvironment } from '../core/setup.js';\nimport { loadProjectHistory, getHistoryDir } from '../core/history.js';\nimport { collectVisualEvidence } from '../core/visuals.js';\n\nexport async function statusCommand(cwd = process.cwd()) {\n  const isRepo = await isGitRepo(cwd);\n  if (!isRepo) {\n    return {\n      isGitRepo: false,\n      message: `Directory '${cwd}' is not inside a Git repository.`\n    };\n  }\n\n  const root = await getRepoRoot(cwd);\n  const branch = await getCurrentBranch(root);\n  const configFile = path.join(root, '.vva', 'config.json');\n\n  let isInitialized = false;\n  let config = null;\n  try {\n    const raw = await fs.readFile(configFile, 'utf8');\n    config = JSON.parse(raw);\n    isInitialized = true;\n  } catch {\n    isInitialized = false;\n  }\n\n  let latestCommit = null;\n  try {\n    const headHash = await execGit(['rev-parse', 'HEAD'], root);\n    latestCommit = await getCommitDetails(headHash, root);\n  } catch {\n    latestCommit = null;\n  }\n\n  let uncommittedCount = 0;\n  try {\n    const statusRaw = await execGit(['status', '--porcelain'], root);\n    uncommittedCount = statusRaw ? statusRaw.split('\\n').filter(Boolean).length : 0;\n  } catch {}\n\n  // Historical Project Intelligence\n  const history = await loadProjectHistory(root);\n\n  // Documentation Release Manifest\n  const manifestFile = path.join(getHistoryDir(root), 'docs-manifest.json');\n  let latestRelease = null;\n  if (fsSync.existsSync(manifestFile)) {\n    try {\n      const manifest = JSON.parse(await fs.readFile(manifestFile, 'utf8'));\n      latestRelease = manifest.releases?.[0] || null;\n    } catch {}\n  }\n\n  // Visual Assets Count\n  const visuals = await collectVisualEvidence(root);\n\n  // Probe Python environment and packages\n  const pythonStatus = await inspectPythonEnvironment(root);\n\n  // Check NVIDIA credentials\n  const nvidiaStatus = await checkNvidiaCredentials(root, VVA_PACKAGE_ROOT);\n\n  // Detect OS details\n  const sysEnv = await detectEnvironment();\n\n  return {\n    isGitRepo: true,\n    repositoryName: path.basename(root),\n    repositoryPath: root,\n    vvaPackageRoot: VVA_PACKAGE_ROOT,\n    branch,\n    isInitialized,\n    config,\n    latestCommit,\n    uncommittedCount,\n    history: {\n      totalCommits: history.totalCommits || 0,\n      processedCommits: history.processedCommitHashes?.length || 0,\n      contributorsCount: Object.keys(history.contributors || {}).length,\n      lastUpdatedAt: history.lastUpdatedAt\n    },\n    documentation: {\n      latestRelease,\n      visualAssetsCount: visuals.totalCount,\n      screenshotsCount: visuals.screenshots.length,\n      chartsCount: visuals.charts.length\n    },\n    python: pythonStatus,\n    nvidia: nvidiaStatus,\n    system: sysEnv\n  };\n}"
    },
    {
      "file": "src/commands/watch.js",
      "status": "A",
      "additions": 0,
      "deletions": 0,
      "content": "import { getRepoRoot, execGit } from '../core/git.js';\nimport { docsCommand } from './docs.js';\n\n/**\n * Continuous Watcher Daemon.\n * Monitors Git HEAD commits or active file modifications and automatically\n * updates the historical project database and continuous documentation.\n */\nexport async function watchCommand(options = {}, cwd = process.cwd(), onEventDetected) {\n  const root = await getRepoRoot(cwd);\n  const mode = options.mode || 'commits'; // 'commits' | 'changes'\n  const pollIntervalMs = options.intervalMs || (mode === 'changes' ? 3000 : 5000);\n\n  let lastKnownCommit = null;\n  let lastKnownStatus = null;\n\n  try {\n    lastKnownCommit = await execGit(['rev-parse', 'HEAD'], root);\n    lastKnownStatus = await execGit(['status', '--porcelain'], root);\n  } catch {}\n\n  let isRunning = true;\n  let isGenerating = false;\n\n  console.log(`\\x1b[36m[vva watch] Active monitor daemon listening in '${mode}' mode (interval: ${pollIntervalMs}ms)...\\x1b[0m`);\n  console.log(`\\x1b[36m[vva watch] Press Ctrl+C to terminate monitor.\\x1b[0m\\n`);\n\n  const intervalId = setInterval(async () => {\n    if (!isRunning || isGenerating) return;\n\n    try {\n      if (mode === 'commits') {\n        const currentCommit = await execGit(['rev-parse', 'HEAD'], root);\n        if (currentCommit && currentCommit !== lastKnownCommit) {\n          lastKnownCommit = currentCommit;\n          isGenerating = true;\n\n          console.log(`\\n\\x1b[32m[vva watch] New commit detected: ${currentCommit.slice(0, 7)}!\\x1b[0m`);\n          console.log(`  Triggering continuous incremental documentation update...`);\n\n          if (onEventDetected) {\n            await onEventDetected({ type: 'commit', commit: currentCommit });\n          } else {\n            await docsCommand({\n              incremental: true,\n              format: options.format || 'all',\n              purpose: options.purpose || 'technical'\n            }, root);\n            console.log(`\\x1b[32m✓ [vva watch] Incremental documentation updated successfully.\\x1b[0m\\n`);\n          }\n\n          isGenerating = false;\n        }\n      } else if (mode === 'changes') {\n        const currentStatus = await execGit(['status', '--porcelain'], root);\n        if (currentStatus !== lastKnownStatus) {\n          lastKnownStatus = currentStatus;\n          const dirtyCount = currentStatus.split('\\n').filter(Boolean).length;\n          console.log(`\\x1b[33m[vva watch] Worktree modified: ${dirtyCount} file(s) changed in working directory.\\x1b[0m`);\n\n          if (onEventDetected) {\n            await onEventDetected({ type: 'changes', count: dirtyCount });\n          }\n        }\n      }\n    } catch {\n      // Continue polling\n    } finally {\n      isGenerating = false;\n    }\n  }, pollIntervalMs);\n\n  return {\n    stop: () => {\n      isRunning = false;\n      clearInterval(intervalId);\n    }\n  };\n}"
    },
    {
      "file": "src/components/AIEngineView.tsx",
      "status": "A",
      "additions": 0,
      "deletions": 0,
      "content": "import React, { useState } from 'react';\nimport { Cpu, CheckCircle2, AlertTriangle, Sparkles, Code2, Eye, ShieldCheck, Copy, Check } from 'lucide-react';\nimport { Repository, GitCommit, AIStructuredResponse, VVAConfig, ProjectDataJSON } from '../types/vva';\nimport { buildProjectDataJSON, generateStructuredAIResponse } from '../utils/orchestrator';\n\ninterface AIEngineViewProps {\n  currentRepo: Repository;\n  selectedCommit: GitCommit;\n  vvaConfig: VVAConfig;\n  lastAIResponse: AIStructuredResponse | null;\n  onUpdateAIResponse: (response: AIStructuredResponse) => void;\n}\n\nexport const AIEngineView: React.FC<AIEngineViewProps> = ({\n  currentRepo,\n  selectedCommit,\n  vvaConfig,\n  lastAIResponse,\n  onUpdateAIResponse,\n}) => {\n  const [provider, setProvider] = useState<'nvidia' | 'gemini'>(vvaConfig.aiProvider);\n  const [isAnalyzing, setIsAnalyzing] = useState(false);\n  const [copiedJson, setCopiedJson] = useState(false);\n\n  const projectData: ProjectDataJSON = buildProjectDataJSON(currentRepo, selectedCommit, vvaConfig);\n  const activeResponse: AIStructuredResponse = lastAIResponse || generateStructuredAIResponse(projectData, provider);\n\n  const handleRunAnalysis = () => {\n    setIsAnalyzing(true);\n    setTimeout(() => {\n      const resp = generateStructuredAIResponse(projectData, provider);\n      onUpdateAIResponse(resp);\n      setIsAnalyzing(false);\n    }, 600);\n  };\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(JSON.stringify(activeResponse, null, 2));\n    setCopiedJson(true);\n    setTimeout(() => setCopiedJson(false), 2000);\n  };\n\n  return (\n    <div className=\"flex-1 max-w-7xl mx-auto px-4 py-4 w-full flex flex-col gap-4\">\n      {/* Top Engine Control Strip */}\n      <div className=\"flex flex-wrap items-center justify-between gap-4 p-4 bg-slate-900 border border-slate-800 rounded-lg\">\n        <div>\n          <span className=\"text-[11px] font-medium text-slate-400 uppercase tracking-wider block mb-1\">\n            Person 2 Module · Python AI Engine\n          </span>\n          <div className=\"flex items-center gap-2\">\n            <h1 className=\"text-sm font-semibold text-slate-100 flex items-center gap-2\">\n              <Cpu className=\"w-4 h-4 text-emerald-400\" />\n              <span>NVIDIA API / LLM Code Intelligence Engine</span>\n            </h1>\n            <span className=\"text-xs text-slate-400\">by Vishnu G Pillai</span>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex items-center gap-1.5 bg-slate-950 p-1 rounded-lg border border-slate-800 text-xs\">\n            <button\n              onClick={() => setProvider('nvidia')}\n              className={`px-3 py-1 font-medium rounded transition-colors ${\n                provider === 'nvidia' \n                  ? 'bg-emerald-600 text-white shadow-sm' \n                  : 'text-slate-400 hover:text-slate-200'\n              }`}\n            >\n              NVIDIA API (meta/llama-3.1-70b)\n            </button>\n            <button\n              onClick={() => setProvider('gemini')}\n              className={`px-3 py-1 font-medium rounded transition-colors ${\n                provider === 'gemini' \n                  ? 'bg-indigo-600 text-white shadow-sm' \n                  : 'text-slate-400 hover:text-slate-200'\n              }`}\n            >\n              Gemini API (gemini-2.5-flash)\n            </button>\n          </div>\n\n          <button\n            onClick={handleRunAnalysis}\n            disabled={isAnalyzing}\n            className=\"flex items-center gap-2 px-3.5 py-1.5 text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white rounded transition-colors shadow-sm disabled:opacity-50\"\n          >\n            {isAnalyzing ? (\n              <>\n                <div className=\"w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                <span>Interpreting Diff...</span>\n              </>\n            ) : (\n              <>\n                <Sparkles className=\"w-3.5 h-3.5\" />\n                <span>Re-Analyze with AI</span>\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Main 2-Column Split: Left = Structured JSON Contract & Schema Validation, Right = Interpreted Output & Anti-Hallucination Guardrails */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1\">\n        {/* Left Column: Output Contract JSON */}\n        <div className=\"lg:col-span-5 bg-slate-900 border border-slate-800 rounded-lg p-4 flex flex-col\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800 mb-3\">\n            <div>\n              <h2 className=\"text-xs font-semibold text-slate-200 uppercase tracking-wider flex items-center gap-2\">\n                <Code2 className=\"w-4 h-4 text-emerald-400\" />\n                <span>Structured Output Contract (JSON)</span>\n              </h2>\n              <span className=\"text-[11px] text-slate-400\">Strict schema from Section 5</span>\n            </div>\n\n            <button\n              onClick={handleCopy}\n              className=\"flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700 transition-colors\"\n            >\n              {copiedJson ? (\n                <>\n                  <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                  <span>Copied</span>\n                </>\n              ) : (\n                <>\n                  <Copy className=\"w-3.5 h-3.5\" />\n                  <span>Copy</span>\n                </>\n              )}\n            </button>\n          </div>\n\n          {/* Validation Chips */}\n          <div className=\"flex flex-wrap items-center gap-2 mb-3 text-[11px] text-slate-400 font-mono\">\n            <span className=\"text-emerald-400 flex items-center gap-1\">\n              <CheckCircle2 className=\"w-3 h-3\" /> title\n            </span>\n            <span className=\"text-slate-600\">·</span>\n            <span className=\"text-emerald-400 flex items-center gap-1\">\n              <CheckCircle2 className=\"w-3 h-3\" /> summary\n            </span>\n            <span className=\"text-slate-600\">·</span>\n            <span className=\"text-emerald-400 flex items-center gap-1\">\n              <CheckCircle2 className=\"w-3 h-3\" /> changedComponents\n            </span>\n            <span className=\"text-slate-600\">·</span>\n            <span className=\"text-emerald-400 flex items-center gap-1\">\n              <CheckCircle2 className=\"w-3 h-3\" /> technicalChanges\n            </span>\n            <span className=\"text-slate-600\">·</span>\n            <span className=\"text-emerald-400 flex items-center gap-1\">\n              <CheckCircle2 className=\"w-3 h-3\" /> technologies\n            </span>\n          </div>\n\n          <div className=\"flex-1 bg-slate-950 border border-slate-800 rounded-lg p-3 overflow-y-auto max-h-[540px] font-mono text-xs\">\n            <pre className=\"text-emerald-300 whitespace-pre-wrap leading-relaxed\">\n              {JSON.stringify(activeResponse, null, 2)}\n            </pre>\n          </div>\n        </div>\n\n        {/* Right Column: Interpreted Technical Meaning & Anti-Hallucination Guardrails */}\n        <div className=\"lg:col-span-7 bg-slate-900 border border-slate-800 rounded-lg p-4 flex flex-col space-y-4\">\n          {/* Card: Interpreted Feature & Changes */}\n          <div className=\"bg-slate-950 border border-slate-800 rounded-lg p-4\">\n            <div className=\"flex items-center justify-between mb-2\">\n              <span className=\"text-[11px] font-medium text-indigo-400 uppercase tracking-wider\">\n                Extracted Feature Intent\n              </span>\n              <span className=\"text-[11px] text-slate-400 font-mono\">\n                Model: {activeResponse.model} ({activeResponse.processingTimeMs}ms)\n              </span>\n            </div>\n            <h3 className=\"text-base font-bold text-slate-100 mb-2\">\n              {activeResponse.title}\n            </h3>\n            <p className=\"text-xs text-slate-300 leading-relaxed mb-3\">\n              {activeResponse.summary}\n            </p>\n            <div className=\"p-2.5 bg-slate-900/80 rounded border border-slate-800 text-xs text-slate-300\">\n              <strong className=\"text-slate-200\">Core Purpose:</strong> {activeResponse.purposeAndRationale}\n            </div>\n          </div>\n\n          {/* Card: Technical Changes Breakdown */}\n          <div className=\"bg-slate-950 border border-slate-800 rounded-lg p-4\">\n            <h4 className=\"text-xs font-semibold text-slate-200 uppercase tracking-wider mb-2.5\">\n              Verified Technical Changes ({activeResponse.technicalChanges.length})\n            </h4>\n            <div className=\"space-y-2\">\n              {activeResponse.technicalChanges.map((tc, idx) => (\n                <div key={idx} className=\"flex items-start gap-2.5 text-xs text-slate-300\">\n                  <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 mt-1.5 shrink-0\" />\n                  <span>{tc}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Section 5 Anti-Hallucination Guardrail: Facts in Code vs Assumptions */}\n          <div className=\"bg-slate-950 border border-amber-900/40 rounded-lg p-4\">\n            <div className=\"flex items-center gap-2 text-amber-300 text-xs font-semibold uppercase tracking-wider mb-2\">\n              <ShieldCheck className=\"w-4 h-4\" />\n              <span>Anti-Hallucination &amp; Grounding Guardrails</span>\n            </div>\n            <p className=\"text-[11px] text-slate-400 mb-3\">\n              Per Section 5 of the VVA specification: <em>\"The AI should distinguish facts visible in the code from assumptions about the developer's intent. For example, it should not claim that a feature is secure or fully tested merely because a commit mentions authentication.\"</em>\n            </p>\n\n            <div className=\"space-y-2 text-xs\">\n              {activeResponse.observationsAndLimitations.map((obs, idx) => (\n                <div key={idx} className=\"flex items-start gap-2 p-2 bg-amber-950/20 border border-amber-900/30 rounded text-amber-200/90 text-[11px]\">\n                  <AlertTriangle className=\"w-3.5 h-3.5 text-amber-400 shrink-0 mt-0.5\" />\n                  <span>{obs}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Technologies Detected */}\n          <div className=\"bg-slate-950 border border-slate-800 rounded-lg p-3\">\n            <span className=\"text-[11px] font-medium text-slate-400 uppercase tracking-wider block mb-2\">\n              Identified Technology Stack\n            </span>\n            <div className=\"flex flex-wrap gap-2\">\n              {activeResponse.technologies.map(tech => (\n                <span key={tech} className=\"px-2.5 py-1 text-xs font-mono bg-slate-900 text-indigo-300 rounded border border-slate-800\">\n                  {tech}\n                </span>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
