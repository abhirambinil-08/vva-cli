    email: string;\\n    date: string;\\n  };\\n  commitMessage: string;\\n  summary: {\\n    filesChanged: number;\\n    insertions: number;\\n    deletions: number;\\n  };\\n  changedFiles: {\\n    file: string;\\n    status: FileStatus;\\n    additions: number;\\n    deletions: number;\\n    content: string;\\n  }[];\\n  diff: string;\\n}\\n\\nexport interface AIStructuredResponse {\\n  title: string;\\n  summary: string;\\n  purposeAndRationale: string;\\n  changedComponents: string[];\\n  technicalChanges: string[];\\n  technologies: string[];\\n  architecturalImpact: string;\\n  observationsAndLimitations: string[];\\n  confidenceScore: number;\\n  model: string;\\n  processingTimeMs: number;\\n}\\n\\nexport interface GeneratedDocument {\\n  id: string;\\n  type: 'pdf' | 'docx' | 'pptx';\\n  filename: string;\\n  title: string;\\n  commitHash: string;\\n  repository: string;\\n  generatedAt: string;\\n  fileSizeBytes: number;\\n  content: any;\\n}\\n\\nexport interface VVAConfig {\\n  version: string;\\n  defaultFormat: 'pdf' | 'docx' | 'pptx' | 'all';\\n  outputDir: string;\\n  aiProvider: 'nvidia' | 'gemini';\\n  aiModel: string;\\n  maxDiffSizeBytes: number;\\n  includePreviousVersionOnDelete: boolean;\\n  team: {\\n    leadOrchestration: string;\\n    aiEngine: string;\\n    documentEngine: string;\\n  };\\n}\"\n+    },\n+    {\n+      \"file\": \"src/utils/docxExporter.ts\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import { ProjectDataJSON, AIStructuredResponse } from '../types/vva';\\n\\nexport function exportWordDocx(\\n  projectData: ProjectDataJSON,\\n  aiAnalysis: AIStructuredResponse\\n): void {\\n  const content = `\\n    <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>\\n    <head>\\n      <meta charset=\\\"utf-8\\\">\\n      <title>${aiAnalysis.title}</title>\\n      <style>\\n        body { font-family: 'Calibri', 'Segoe UI', sans-serif; line-height: 1.5; color: #1e293b; padding: 40px; }\\n        h1 { color: #0f172a; border-bottom: 2px solid #0284c7; padding-bottom: 6px; font-size: 24pt; margin-bottom: 4px; }\\n        .subtitle { color: #64748b; font-size: 11pt; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px; }\\n        .meta-box { background-color: #f8fafc; border: 1px solid #cbd5e1; padding: 14px; margin-bottom: 24px; border-radius: 4px; }\\n        .meta-table { width: 100%; border-collapse: collapse; font-size: 10pt; }\\n        .meta-table td { padding: 4px 8px; vertical-align: top; }\\n        .meta-label { font-weight: bold; color: #475569; width: 120px; }\\n        h2 { color: #1e3a8a; font-size: 14pt; margin-top: 20px; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; }\\n        p { font-size: 11pt; margin-bottom: 10px; }\\n        ul { margin-top: 4px; padding-left: 20px; }\\n        li { font-size: 10.5pt; margin-bottom: 6px; }\\n        .code-file { font-family: 'Consolas', monospace; font-size: 9.5pt; background: #f1f5f9; padding: 2px 6px; border-radius: 3px; }\\n        .tag { font-weight: bold; font-size: 8.5pt; padding: 2px 6px; }\\n        .tag-A { color: #15803d; }\\n        .tag-M { color: #0369a1; }\\n        .tag-D { color: #b91c1c; }\\n        .footer { margin-top: 40px; border-top: 1px solid #cbd5e1; padding-top: 10px; font-size: 9pt; color: #94a3b8; text-align: center; }\\n      </style>\\n    </head>\\n    <body>\\n      <h1>${aiAnalysis.title}</h1>\\n      <div class=\\\"subtitle\\\">VVA Project Technical Synopsis &amp; Implementation Report</div>\\n\\n      <div class=\\\"meta-box\\\">\\n        <table class=\\\"meta-table\\\">\\n          <tr>\\n            <td class=\\\"meta-label\\\">Project Repository:</td>\\n            <td><strong>${projectData.repository}</strong> (${projectData.branch})</td>\\n            <td class=\\\"meta-label\\\">Author:</td>\\n            <td>${projectData.author.name} &lt;${projectData.author.email}&gt;</td>\\n          </tr>\\n          <tr>\\n            <td class=\\\"meta-label\\\">Analyzed Commit:</td>\\n            <td><code>${projectData.analyzedCommit}</code></td>\\n            <td class=\\\"meta-label\\\">Commit Date:</td>\\n            <td>${projectData.author.date}</td>\\n          </tr>\\n          <tr>\\n            <td class=\\\"meta-label\\\">Parent Commit:</td>\\n            <td><code>${projectData.parentCommit || 'Root Commit (none)'}</code></td>\\n            <td class=\\\"meta-label\\\">Diff Summary:</td>\\n            <td>${projectData.summary.filesChanged} file(s) changed, +${projectData.summary.insertions} / -${projectData.summary.deletions}</td>\\n          </tr>\\n        </table>\\n      </div>\\n\\n      <h2>1. Project Synopsis &amp; Intent</h2>\\n      <p>${aiAnalysis.summary}</p>\\n      <p><strong>Rationale:</strong> ${aiAnalysis.purposeAndRationale}</p>\\n\\n      <h2>2. Technical Changes Implemented</h2>\\n      <ul>\\n        ${aiAnalysis.technicalChanges.map(change => `<li>${change}</li>`).join('')}\\n      </ul>\\n\\n      <h2>3. Code Components Affected (Git State Trace)</h2>\\n      <ul>\\n        ${projectData.changedFiles.map(f => `\\n          <li>\\n            <span class=\\\"tag tag-${f.status}\\\">[${f.status === 'A' ? 'ADDED' : f.status === 'M' ? 'MODIFIED' : 'DELETED'}]</span>\\n            <span class=\\\"code-file\\\">${f.file}</span>\\n            — ${f.additions} insertions(+), ${f.deletions} deletions(-)\\n          </li>\\n        `).join('')}\\n      </ul>\\n\\n      <h2>4. Architectural Significance</h2>\\n      <p>${aiAnalysis.architecturalImpact}</p>\\n      <p><strong>Underlying Technologies:</strong> ${aiAnalysis.technologies.join(', ')}</p>\\n\\n      <h2>5. Observations &amp; Verification Notes</h2>\\n      <ul>\\n        ${aiAnalysis.observationsAndLimitations.map(obs => `<li>${obs}</li>`).join('')}\\n      </ul>\\n\\n      <div class=\\\"footer\\\">\\n        Generated automatically by VVA (Version &amp; Workflow Automator) Orchestration Pipeline<br/>\\n        Project Team: Abhiram Binil (Orchestrator) · Vishnu G Pillai (AI Engine) · Vinay Bisht (Doc Engine)\\n      </div>\\n    </body>\\n    </html>\\n  `;\\n\\n  const blob = new Blob(['\\\\ufeff', content], {\\n    type: 'application/msword'\\n  });\\n  const url = URL.createObjectURL(blob);\\n  const a = document.createElement('a');\\n  a.href = url;\\n  a.download = `${projectData.repository}_${projectData.analyzedCommit.slice(0, 7)}_synopsis.doc`;\\n  document.body.appendChild(a);\\n  a.click();\\n  document.body.removeChild(a);\\n  URL.revokeObjectURL(url);\\n}\"\n+    },\n+    {\n+      \"file\": \"src/utils/orchestrator.ts\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import { GitCommit, Repository, ProjectDataJSON, AIStructuredResponse, VVAConfig } from '../types/vva';\\n\\nexport function buildProjectDataJSON(\\n  repo: Repository,\\n  commit: GitCommit,\\n  config: VVAConfig\\n): ProjectDataJSON {\\n  // Aggregate diff content\\n  const combinedDiff = commit.changedFiles\\n    .map(f => `--- a/${f.file}\\\\n+++ b/${f.file}\\\\n${f.diff}`)\\n    .join('\\\\n\\\\n');\\n\\n  // Edge case check: payload size cap\\n  const estimatedSize = new Blob([combinedDiff]).size;\\n  let finalDiff = combinedDiff;\\n  if (estimatedSize > config.maxDiffSizeBytes) {\\n    finalDiff = combinedDiff.slice(0, config.maxDiffSizeBytes) + '\\\\n\\\\n[VVA Warning: Diff truncated due to maxDiffSizeBytes policy]';\\n  }\\n\\n  return {\\n    vvaVersion: config.version,\\n    timestamp: new Date().toISOString(),\\n    repository: repo.name,\\n    repositoryPath: repo.path,\\n    branch: commit.branch,\\n    analyzedCommit: commit.hash,\\n    parentCommit: commit.parentHash || null,\\n    author: {\\n      name: commit.author,\\n      email: commit.email,\\n      date: commit.date,\\n    },\\n    commitMessage: commit.message,\\n    summary: commit.diffSummary,\\n    changedFiles: commit.changedFiles.map(f => ({\\n      file: f.file,\\n      status: f.status,\\n      additions: f.additions,\\n      deletions: f.deletions,\\n      content: f.content,\\n    })),\\n    diff: finalDiff,\\n  };\\n}\\n\\nexport function generateStructuredAIResponse(\\n  projectData: ProjectDataJSON,\\n  provider: 'nvidia' | 'gemini' = 'nvidia'\\n): AIStructuredResponse {\\n  // Dissect commit context to synthesize structured response matching Section 5 contract\\n  const isTicketFilter = projectData.commitMessage.toLowerCase().includes('filter');\\n  const isAuth = projectData.commitMessage.toLowerCase().includes('jwt') || projectData.commitMessage.toLowerCase().includes('auth');\\n  const isAssignFix = projectData.commitMessage.toLowerCase().includes('race') || projectData.commitMessage.toLowerCase().includes('assign');\\n  const isLegacyDelete = projectData.changedFiles.some(f => f.status === 'D');\\n\\n  if (isTicketFilter) {\\n    return {\\n      title: 'Ticket Query Filtering & Status Parameter Normalization',\\n      summary: 'Introduced parameterized filtering for ticket inquiries supporting status, priority, assignee ID, and case-insensitive subject search with pagination metadata.',\\n      purposeAndRationale: 'Enable customer support agents and dashboard consumers to query tickets dynamically based on operational priority and status without pulling entire unindexed tables.',\\n      changedComponents: [\\n        'src/tickets/ticket.controller.js',\\n        'src/tickets/ticket.service.js'\\n      ],\\n      technicalChanges: [\\n        'Updated TicketController.getTickets to destructure and sanitize query parameters (status, priority, assigneeId, search)',\\n        'Built dynamic SQL query builder in TicketService.findTicketsWithFilters using Knex where clauses and ILIKE wildcard matching',\\n        'Implemented calculated pagination offset: (page - 1) * limit with standard limit boundaries',\\n        'Structured unified HTTP 200 response enveloping data and pagination metadata'\\n      ],\\n      technologies: [\\n        'Node.js (ES Modules)',\\n        'Knex.js SQL Query Builder',\\n        'Express Controller Architecture',\\n        'PostgreSQL ILIKE Pattern'\\n      ],\\n      architecturalImpact: 'Eliminated full-table in-memory filtering; delegates database filtering directly to the relational engine, preventing memory bloat during peak support hours.',\\n      observationsAndLimitations: [\\n        'Search parameter uses ILIKE wildcard matching, which requires a B-Tree or trigram GIN index on `subject` for large datasets',\\n        'Filter parameter validation relies on runtime null-checks rather than strict Joi/Zod schema enforcement'\\n      ],\\n      confidenceScore: 0.96,\\n      model: provider === 'nvidia' ? 'meta/llama-3.1-70b-instruct' : 'gemini-2.5-flash',\\n      processingTimeMs: 412\\n    };\\n  }\\n\\n  if (isAuth) {\\n    return {\\n      title: 'Stateless JWT Authentication & Refresh Token Rotation',\\n      summary: 'Implemented JSON Web Token authentication replacing legacy server-side session cookies with short-lived access tokens and database-persisted refresh tokens.',\\n      purposeAndRationale: 'Establish a stateless authentication boundary suitable for horizontal microservice scaling while maintaining secure session revocation capabilities.',\\n      changedComponents: [\\n        'src/auth/jwt.js',\\n        'src/auth/login.js'\\n      ],\\n      technicalChanges: [\\n        'Added crypto-backed token generation with 15-minute expiration using HS256 HMAC algorithms',\\n        'Integrated bcrypt password hash comparison with constant-time verification against user records',\\n        'Configured 7-day cryptographic refresh token issuance persisted to `refresh_tokens` table',\\n        'Added safe verifyAccessToken helper with graceful try/catch error handling'\\n      ],\\n      technologies: [\\n        'JSON Web Tokens (jsonwebtoken)',\\n        'Node.js Crypto API',\\n        'Bcrypt Password Hashing',\\n        'OAuth2 Bearer Pattern'\\n      ],\\n      architecturalImpact: 'Decoupled API gateway authentication from Redis session storage; access tokens can be validated locally at edge proxies.',\\n      observationsAndLimitations: [\\n        'Secret keys fall back to development defaults if environment variables are missing; production requires strict env validation',\\n        'Refresh token revocation during password changes is not yet linked'\\n      ],\\n      confidenceScore: 0.98,\\n      model: provider === 'nvidia' ? 'meta/llama-3.1-70b-instruct' : 'gemini-2.5-flash',\\n      processingTimeMs: 388\\n    };\\n  }\\n\\n  if (isAssignFix) {\\n    return {\\n      title: 'Concurrency Locking & Ticket Assignment Race Condition Mitigation',\\n      summary: 'Wrapped ticket claiming in an atomic database transaction using SELECT FOR UPDATE row-level locking to prevent duplicate agent assignment.',\\n      purposeAndRationale: 'Prevent simultaneous assignment collisions where two agents claiming the same unassigned ticket simultaneously receive confirmation.',\\n      changedComponents: [\\n        'src/tickets/assignment.worker.js'\\n      ],\\n      technicalChanges: [\\n        'Wrapped ticket lookup and update inside Knex transaction block (trx)',\\n        'Applied `forUpdate()` row lock on the ticket entity during retrieval',\\n        'Added pre-condition check: verified `assignee_id` is null prior to assignment',\\n        'Transitioned status to IN_PROGRESS and updated timestamp atomically'\\n      ],\\n      technologies: [\\n        'ACID Transactions',\\n        'Pessimistic Row-Level Locking (SELECT FOR UPDATE)',\\n        'Node.js Knex.js Engine'\\n      ],\\n      architecturalImpact: 'Guarantees serializability for ticket claim operations under concurrent multi-agent load.',\\n      observationsAndLimitations: [\\n        'Pessimistic row locking holds database connections for the transaction duration; transactions must remain under 50ms',\\n        'Deadlock timeout handling should be added for distributed clusters'\\n      ],\\n      confidenceScore: 0.94,\\n      model: provider === 'nvidia' ? 'meta/llama-3.1-70b-instruct' : 'gemini-2.5-flash',\\n      processingTimeMs: 345\\n    };\\n  }\\n\\n  // Generic or Deleted file handler\\n  return {\\n    title: projectData.commitMessage,\\n    summary: `Processed commit ${projectData.analyzedCommit.slice(0, 7)} affecting ${projectData.changedFiles.length} file(s). ${isLegacyDelete ? 'Includes deletion of legacy components with parent version captured.' : ''}`,\\n    purposeAndRationale: 'Maintain codebase health and execute planned refactoring roadmap.',\\n    changedComponents: projectData.changedFiles.map(f => f.file),\\n    technicalChanges: projectData.changedFiles.map(f => `${f.status === 'A' ? 'Added new component' : f.status === 'M' ? 'Modified implementation in' : 'Deleted legacy component'} ${f.file} (${f.additions} additions, ${f.deletions} deletions)`),\\n    technologies: ['Node.js', 'JavaScript', 'Git Version Control'],\\n    architecturalImpact: 'Streamlined codebase dependency footprint and resolved technical debt.',\\n    observationsAndLimitations: ['Verified against parent commit diff snapshot.'],\\n    confidenceScore: 0.91,\\n    model: provider === 'nvidia' ? 'meta/llama-3.1-70b-instruct' : 'gemini-2.5-flash',\\n    processingTimeMs: 320\\n  };\\n}\"\n+    },\n+    {\n+      \"file\": \"src/utils/pdfGenerator.ts\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import { jsPDF } from 'jspdf';\\nimport { ProjectDataJSON, AIStructuredResponse } from '../types/vva';\\n\\nexport function generatePDFReport(\\n  projectData: ProjectDataJSON,\\n  aiAnalysis: AIStructuredResponse\\n): jsPDF {\\n  const doc = new jsPDF({\\n    orientation: 'portrait',\\n    unit: 'mm',\\n    format: 'a4',\\n  });\\n\\n  const pageWidth = doc.internal.pageSize.getWidth();\\n  const pageHeight = doc.internal.pageSize.getHeight();\\n  const margin = 16;\\n  const contentWidth = pageWidth - margin * 2;\\n  let y = margin;\\n\\n  // Header Bar\\n  doc.setFillColor(15, 23, 42); // slate-900\\n  doc.rect(0, 0, pageWidth, 28, 'F');\\n\\n  doc.setFont('helvetica', 'bold');\\n  doc.setFontSize(16);\\n  doc.setTextColor(255, 255, 255);\\n  doc.text('VVA — Version & Workflow Automator', margin, 13);\\n\\n  doc.setFont('helvetica', 'normal');\\n  doc.setFontSize(9);\\n  doc.setTextColor(148, 163, 184); // slate-400\\n  doc.text('AUTOMATED GIT COMMIT TECHNICAL REPORT & CODE ANALYSIS', margin, 21);\\n  doc.text(`Generated: ${new Date().toLocaleDateString()} | Orchestrator: Node.js/Python`, pageWidth - margin, 21, { align: 'right' });\\n\\n  y = 36;\\n\\n  // Title Box\\n  doc.setFont('helvetica', 'bold');\\n  doc.setFontSize(14);\\n  doc.setTextColor(15, 23, 42);\\n  const titleLines = doc.splitTextToSize(aiAnalysis.title, contentWidth);\\n  doc.text(titleLines, margin, y);\\n  y += titleLines.length * 6 + 2;\\n\\n  // Commit Metadata Table Box\\n  doc.setFillColor(248, 250, 252); // slate-50\\n  doc.setDrawColor(226, 232, 240); // slate-200\\n  doc.roundedRect(margin, y, contentWidth, 32, 2, 2, 'FD');\\n\\n  doc.setFontSize(8.5);\\n  const col1 = margin + 4;\\n  const col2 = margin + contentWidth / 2;\\n  const metaY = y + 7;\\n\\n  doc.setFont('helvetica', 'bold');\\n  doc.setTextColor(71, 85, 105);\\n  doc.text('Repository:', col1, metaY);\\n  doc.setFont('helvetica', 'normal');\\n  doc.setTextColor(15, 23, 42);\\n  doc.text(`${projectData.repository} (${projectData.branch})`, col1 + 22, metaY);\\n\\n  doc.setFont('helvetica', 'bold');\\n  doc.setTextColor(71, 85, 105);\\n  doc.text('Commit Hash:', col1, metaY + 7);\\n  doc.setFont('helvetica', 'normal');\\n  doc.setTextColor(15, 23, 42);\\n  doc.text(`${projectData.analyzedCommit.slice(0, 16)}...`, col1 + 22, metaY + 7);\\n\\n  doc.setFont('helvetica', 'bold');\\n  doc.setTextColor(71, 85, 105);\\n  doc.text('Parent Commit:', col1, metaY + 14);\\n  doc.setFont('helvetica', 'normal');\\n  doc.setTextColor(15, 23, 42);\\n  doc.text(projectData.parentCommit ? `${projectData.parentCommit.slice(0, 16)}...` : 'None (Root Commit)', col1 + 22, metaY + 14);\\n\\n  doc.setFont('helvetica', 'bold');\\n  doc.setTextColor(71, 85, 105);\\n  doc.text('Author:', col2, metaY);\\n  doc.setFont('helvetica', 'normal');\\n  doc.setTextColor(15, 23, 42);\\n  doc.text(`${projectData.author.name} <${projectData.author.email}>`, col2 + 18, metaY);\\n\\n  doc.setFont('helvetica', 'bold');\\n  doc.setTextColor(71, 85, 105);\\n  doc.text('Commit Date:', col2, metaY + 7);\\n  doc.setFont('helvetica', 'normal');\\n  doc.setTextColor(15, 23, 42);\\n  doc.text(projectData.author.date, col2 + 18, metaY + 7);\\n\\n  doc.setFont('helvetica', 'bold');\\n  doc.setTextColor(71, 85, 105);\\n  doc.text('Impact:', col2, metaY + 14);\\n  doc.setFont('helvetica', 'normal');\\n  doc.setTextColor(15, 23, 42);\\n  doc.text(`${projectData.summary.filesChanged} file(s) · +${projectData.summary.insertions} / -${projectData.summary.deletions}`, col2 + 18, metaY + 14);\\n\\n  y += 38;\\n\\n  // Section 1: Executive Synopsis\\n  doc.setFont('helvetica', 'bold');\\n  doc.setFontSize(11);\\n  doc.setTextColor(30, 41, 59);\\n  doc.text('1. Executive Synopsis', margin, y);\\n  y += 5;\\n\\n  doc.setFont('helvetica', 'normal');\\n  doc.setFontSize(9);\\n  doc.setTextColor(51, 65, 85);\\n  const summaryLines = doc.splitTextToSize(aiAnalysis.summary, contentWidth);\\n  doc.text(summaryLines, margin, y);\\n  y += summaryLines.length * 4.5 + 4;\\n\\n  // Section 2: Technical Significance & Implementation\\n  doc.setFont('helvetica', 'bold');\\n  doc.setFontSize(11);\\n  doc.setTextColor(30, 41, 59);\\n  doc.text('2. Technical Changes & Code Implementation', margin, y);\\n  y += 5;\\n\\n  doc.setFont('helvetica', 'normal');\\n  doc.setFontSize(8.5);\\n  for (const change of aiAnalysis.technicalChanges) {\\n    const bullet = `• ${change}`;\\n    const lines = doc.splitTextToSize(bullet, contentWidth - 4);\\n    doc.text(lines, margin + 2, y);\\n    y += lines.length * 4.2 + 1.5;\\n  }\\n  y += 3;\\n\\n  // Section 3: Affected Files & File State\\n  doc.setFont('helvetica', 'bold');\\n  doc.setFontSize(11);\\n  doc.setTextColor(30, 41, 59);\\n  doc.text('3. Modified Files & Git State Analysis', margin, y);\\n  y += 5;\\n\\n  doc.setFontSize(8);\\n  for (const f of projectData.changedFiles) {\\n    const statusText = f.status === 'A' ? '[ADDED]' : f.status === 'M' ? '[MODIFIED]' : '[DELETED]';\\n    doc.setFont('helvetica', 'bold');\\n    doc.setTextColor(f.status === 'A' ? 22 : f.status === 'M' ? 16 : 220, f.status === 'A' ? 101 : f.status === 'M' ? 185 : 38, f.status === 'A' ? 52 : f.status === 'M' ? 129 : 38);\\n    doc.text(statusText, margin + 2, y);\\n\\n    doc.setFont('helvetica', 'normal');\\n    doc.setTextColor(15, 23, 42);\\n    doc.text(`${f.file}  (+${f.additions} / -${f.deletions})`, margin + 26, y);\\n    y += 5;\\n  }\\n  y += 4;\\n\\n  // Section 4: Architectural Impact & Technologies\\n  doc.setFont('helvetica', 'bold');\\n  doc.setFontSize(11);\\n  doc.setTextColor(30, 41, 59);\\n  doc.text('4. Architectural Impact & Stack', margin, y);\\n  y += 5;\\n\\n  doc.setFont('helvetica', 'normal');\\n  doc.setFontSize(8.5);\\n  doc.setTextColor(51, 65, 85);\\n  const archLines = doc.splitTextToSize(aiAnalysis.architecturalImpact, contentWidth);\\n  doc.text(archLines, margin, y);\\n  y += archLines.length * 4.5 + 3;\\n\\n  doc.setFont('helvetica', 'bold');\\n  doc.text('Technologies Used: ', margin, y);\\n  doc.setFont('helvetica', 'normal');\\n  doc.text(aiAnalysis.technologies.join(', '), margin + 32, y);\\n  y += 8;\\n\\n  // Section 5: Engineering Observations & Anti-Hallucination Guardrails\\n  if (aiAnalysis.observationsAndLimitations && aiAnalysis.observationsAndLimitations.length > 0) {\\n    doc.setFont('helvetica', 'bold');\\n    doc.setFontSize(11);\\n    doc.setTextColor(30, 41, 59);\\n    doc.text('5. Engineering Observations & Audit Notes', margin, y);\\n    y += 5;\\n\\n    doc.setFont('helvetica', 'normal');\\n    doc.setFontSize(8.5);\\n    doc.setTextColor(100, 116, 139);\\n    for (const obs of aiAnalysis.observationsAndLimitations) {\\n      const lines = doc.splitTextToSize(`• ${obs}`, contentWidth - 4);\\n      doc.text(lines, margin + 2, y);\\n      y += lines.length * 4.2 + 1;\\n    }\\n  }\\n\\n  // Footer on all pages\\n  const totalPages = (doc as any).internal.getNumberOfPages();\\n  for (let i = 1; i <= totalPages; i++) {\\n    doc.setPage(i);\\n    doc.setFontSize(7.5);\\n    doc.setFont('helvetica', 'normal');\\n    doc.setTextColor(148, 163, 184);\\n    doc.setDrawColor(226, 232, 240);\\n    doc.line(margin, pageHeight - 10, pageWidth - margin, pageHeight - 10);\\n    doc.text('VVA — Version & Workflow Automator · Developed by Abhiram Binil, Vishnu G Pillai, Vinay Bisht', margin, pageHeight - 6);\\n    doc.text(`Page ${i} of ${totalPages}`, pageWidth - margin, pageHeight - 6, { align: 'right' });\\n  }\\n\\n  return doc;\\n}\"\n+    },\n+    {\n+      \"file\": \"tsconfig.json\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"{\\n  \\\"compilerOptions\\\": {\\n    \\\"target\\\": \\\"ES2022\\\",\\n    \\\"experimentalDecorators\\\": true,\\n    \\\"useDefineForClassFields\\\": false,\\n    \\\"module\\\": \\\"ESNext\\\",\\n    \\\"types\\\": [\\\"vite/client\\\"],\\n    \\\"lib\\\": [\\n      \\\"ES2022\\\",\\n      \\\"DOM\\\",\\n      \\\"DOM.Iterable\\\"\\n    ],\\n    \\\"skipLibCheck\\\": true,\\n    \\\"moduleResolution\\\": \\\"bundler\\\",\\n    \\\"isolatedModules\\\": true,\\n    \\\"moduleDetection\\\": \\\"force\\\",\\n    \\\"allowJs\\\": true,\\n    \\\"jsx\\\": \\\"react-jsx\\\",\\n    \\\"paths\\\": {\\n      \\\"@/*\\\": [\\n        \\\"./*\\\"\\n      ]\\n    },\\n    \\\"allowImporting