cation &amp; Observations\\n              </h2>\\n              <ul className=\\\"list-disc pl-5 space-y-1 text-slate-600\\\">\\n                {aiAnalysis.observationsAndLimitations.map((obs, idx) => (\\n                  <li key={idx}>{obs}</li>\\n                ))}\\n              </ul>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* PPTX VIEW (Slide Deck) */}\\n        {docType === 'pptx' && (\\n          <div className=\\\"w-full max-w-4xl flex flex-col items-center\\\">\\n            {/* Slide Navigation Bar */}\\n            <div className=\\\"flex items-center justify-between w-full mb-3 text-xs text-slate-400\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"font-semibold text-slate-200\\\">\\n                  Slide {currentSlide + 1} of {slides.length}:\\n                </span>\\n                <span className=\\\"text-indigo-400\\\">{slides[currentSlide].title}</span>\\n              </div>\\n\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <button\\n                  onClick={() => setCurrentSlide(prev => Math.max(0, prev - 1))}\\n                  disabled={currentSlide === 0}\\n                  className=\\\"p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded disabled:opacity-30 transition-colors\\\"\\n                >\\n                  <ChevronLeft className=\\\"w-4 h-4\\\" />\\n                </button>\\n                <div className=\\\"flex items-center gap-1\\\">\\n                  {slides.map((_, i) => (\\n                    <button\\n                      key={i}\\n                      onClick={() => setCurrentSlide(i)}\\n                      className={`w-2.5 h-2.5 rounded-full transition-colors ${\\n                        i === currentSlide ? 'bg-amber-500' : 'bg-slate-700 hover:bg-slate-600'\\n                      }`}\\n                    />\\n                  ))}\\n                </div>\\n                <button\\n                  onClick={() => setCurrentSlide(prev => Math.min(slides.length - 1, prev + 1))}\\n                  disabled={currentSlide === slides.length - 1}\\n                  className=\\\"p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded disabled:opacity-30 transition-colors\\\"\\n                >\\n                  <ChevronRight className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* Slide Screen (16:9 Aspect Ratio) */}\\n            <div className=\\\"w-full aspect-[16/9] bg-slate-950 border-2 border-slate-800 rounded-xl shadow-2xl flex flex-col overflow-hidden relative\\\">\\n              {/* Slide Top Banner */}\\n              <div className=\\\"flex items-center justify-between px-6 py-3 bg-slate-900 border-b border-slate-800 text-xs\\\">\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-3 h-3 rounded-sm bg-amber-500\\\" />\\n                  <span className=\\\"font-bold text-white tracking-wide\\\">VVA Presentation Deck</span>\\n                </div>\\n                <span className=\\\"text-slate-500 font-mono text-[11px]\\\">{projectData.repository} · {projectData.branch}</span>\\n              </div>\\n\\n              {/* Slide Body */}\\n              <div className=\\\"flex-1 overflow-y-auto\\\">\\n                {slides[currentSlide].content}\\n              </div>\\n\\n              {/* Slide Footer */}\\n              <div className=\\\"flex items-center justify-between px-6 py-2.5 bg-slate-900/60 border-t border-slate-800/80 text-[11px] text-slate-500\\\">\\n                <span>VVA · Version &amp; Workflow Automator</span>\\n                <span>Slide {currentSlide + 1} / {slides.length}</span>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </div>\\n  );\\n};\"\n+    },\n+    {\n+      \"file\": \"src/components/GitCollectorView.tsx\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import React, { useState } from 'react';\\nimport { GitBranch, GitCommit as GitCommitIcon, FileCode, Plus, Minus, Copy, Check, Info, FilePlus, FileEdit, Trash2, ShieldAlert } from 'lucide-react';\\nimport { Repository, GitCommit, ChangedFile, ProjectDataJSON, VVAConfig } from '../types/vva';\\nimport { buildProjectDataJSON } from '../utils/orchestrator';\\n\\ninterface GitCollectorViewProps {\\n  repositories: Repository[];\\n  currentRepo: Repository;\\n  onSelectRepo: (repo: Repository) => void;\\n  selectedCommit: GitCommit;\\n  onSelectCommit: (commit: GitCommit) => void;\\n  vvaConfig: VVAConfig;\\n  onAddNewCommit: (newCommit: GitCommit) => void;\\n}\\n\\nexport const GitCollectorView: React.FC<GitCollectorViewProps> = ({\\n  repositories,\\n  currentRepo,\\n  onSelectRepo,\\n  selectedCommit,\\n  onSelectCommit,\\n  vvaConfig,\\n  onAddNewCommit,\\n}) => {\\n  const [activeFileIndex, setActiveFileIndex] = useState<number>(0);\\n  const [viewMode, setViewMode] = useState<'diff' | 'committedContent' | 'projectJson'>('diff');\\n  const [copiedJson, setCopiedJson] = useState(false);\\n  const [showNewCommitModal, setShowNewCommitModal] = useState(false);\\n\\n  // Custom Commit Creator state\\n  const [newMsg, setNewMsg] = useState('Refactor authentication middleware');\\n  const [newFile, setNewFile] = useState('src/middleware/auth.js');\\n  const [newStatus, setNewStatus] = useState<'A' | 'M' | 'D'>('M');\\n  const [newDiff, setNewDiff] = useState('@@ -1,4 +1,7 @@\\\\n-const oldToken = req.headers[\\\"token\\\"];\\\\n+const bearer = req.headers.authorization;\\\\n+const token = bearer ? bearer.replace(\\\"Bearer \\\", \\\"\\\") : null;\\\\n+if (!token) return res.status(401).send();');\\n  const [newContent, setNewContent] = useState('export function authMiddleware(req, res, next) {\\\\n  const bearer = req.headers.authorization;\\\\n  const token = bearer ? bearer.replace(\\\"Bearer \\\", \\\"\\\") : null;\\\\n  if (!token) return res.status(401).json({ error: \\\"Missing token\\\" });\\\\n  next();\\\\n}');\\n\\n  const activeFile: ChangedFile | undefined = selectedCommit.changedFiles[activeFileIndex] || selectedCommit.changedFiles[0];\\n\\n  const projectDataJson: ProjectDataJSON = buildProjectDataJSON(currentRepo, selectedCommit, vvaConfig);\\n\\n  const handleCopyJson = () => {\\n    navigator.clipboard.writeText(JSON.stringify(projectDataJson, null, 2));\\n    setCopiedJson(true);\\n    setTimeout(() => setCopiedJson(false), 2000);\\n  };\\n\\n  const handleCreateCommit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const hash = Array.from({ length: 40 }, () => Math.floor(Math.random() * 16).toString(16)).join('');\\n    const newCommitObj: GitCommit = {\\n      hash,\\n      shortHash: hash.slice(0, 7),\\n      parentHash: selectedCommit.hash,\\n      author: 'Abhiram Binil',\\n      email: 'Abhirambinil1@gmail.com',\\n      date: new Date().toISOString().replace('T', ' ').slice(0, 19) + ' UTC',\\n      message: newMsg,\\n      branch: currentRepo.currentBranch,\\n      diffSummary: {\\n        filesChanged: 1,\\n        insertions: newStatus === 'D' ? 0 : 4,\\n        deletions: newStatus === 'A' ? 0 : 2,\\n      },\\n      changedFiles: [\\n        {\\n          file: newFile,\\n          status: newStatus,\\n          additions: newStatus === 'D' ? 0 : 4,\\n          deletions: newStatus === 'A' ? 0 : 2,\\n          content: newContent,\\n          diff: newDiff,\\n        }\\n      ]\\n    };\\n\\n    onAddNewCommit(newCommitObj);\\n    onSelectCommit(newCommitObj);\\n    setShowNewCommitModal(false);\\n  };\\n\\n  return (\\n    <div className=\\\"flex-1 max-w-7xl mx-auto px-4 py-4 w-full flex flex-col gap-4\\\">\\n      {/* Top Bar: Repository Switcher & Stats */}\\n      <div className=\\\"flex flex-wrap items-center justify-between gap-4 p-4 bg-slate-900 border border-slate-800 rounded-lg\\\">\\n        <div className=\\\"flex items-center gap-4\\\">\\n          <div>\\n            <label className=\\\"text-[11px] font-medium text-slate-400 uppercase tracking-wider block mb-1\\\">\\n              Active Repository\\n            </label>\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <select\\n                value={currentRepo.id}\\n                onChange={(e) => {\\n                  const found = repositories.find(r => r.id === e.target.value);\\n                  if (found) {\\n                    onSelectRepo(found);\\n                    onSelectCommit(found.commits[0]);\\n                    setActiveFileIndex(0);\\n                  }\\n                }}\\n                className=\\\"bg-slate-950 border border-slate-700 text-slate-100 text-xs rounded px-3 py-1.5 font-medium outline-none focus:border-indigo-500\\\"\\n              >\\n                {repositories.map(r => (\\n                  <option key={r.id} value={r.id}>\\n                    {r.name} — {r.description}\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"hidden sm:block border-l border-slate-800 pl-4\\\">\\n            <span className=\\\"text-[11px] font-medium text-slate-400 uppercase tracking-wider block mb-1\\\">\\n              Collector Role\\n            </span>\\n            <span className=\\\"text-xs text-indigo-300 font-semibold\\\">\\n              Person 1: Abhiram Binil (Node.js &amp; Git Operations)\\n            </span>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2\\\">\\n          <button\\n            onClick={() => setShowNewCommitModal(true)}\\n            className=\\\"flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded transition-colors\\\"\\n          >\\n            <Plus className=\\\"w-3.5 h-3.5 text-indigo-400\\\" />\\n            <span>Simulate New Commit</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Main Grid: Left = Commit History List, Right = Commit Inspector */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1\\\">\\n        {/* Left Col: Commit Tree */}\\n        <div className=\\\"lg:col-span-4 bg-slate-900 border border-slate-800 rounded-lg p-4 flex flex-col\\\">\\n          <div className=\\\"flex items-center justify-between mb-3\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <GitCommitIcon className=\\\"w-4 h-4 text-indigo-400\\\" />\\n              <h2 className=\\\"text-xs font-semibold text-slate-200 uppercase tracking-wider\\\">\\n                Git Commit History ({currentRepo.commits.length})\\n              </h2>\\n            </div>\\n            <span className=\\\"text-[11px] text-slate-500 font-mono\\\">HEAD: {currentRepo.currentBranch}</span>\\n          </div>\\n\\n          <div className=\\\"space-y-2 overflow-y-auto max-h-[600px] pr-1\\\">\\n            {currentRepo.commits.map((commit) => {\\n              const isSelected = commit.hash === selectedCommit.hash;\\n              return (\\n                <div\\n                  key={commit.hash}\\n                  onClick={() => {\\n                    onSelectCommit(commit);\\n                    setActiveFileIndex(0);\\n                  }}\\n                  className={`p-3 rounded-lg border text-left cursor-pointer transition-all ${\\n                    isSelected\\n                      ? 'bg-indigo-950/40 border-indigo-500/60 shadow-sm'\\n                      : 'bg-slate-950/60 border-slate-800/80 hover:border-slate-700'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-center justify-between gap-2 mb-1.5\\\">\\n                    <span className=\\\"text-xs font-mono font-semibold text-indigo-300\\\">\\n                      {commit.shortHash}\\n                    </span>\\n                    <span className=\\\"text-[11px] text-slate-400\\\">\\n                      {commit.date.split(' ')[0]}\\n                    </span>\\n                  </div>\\n\\n                  <p className=\\\"text-xs font-medium text-slate-200 line-clamp-2 mb-2\\\">\\n                    {commit.message}\\n                  </p>\\n\\n                  <div className=\\\"flex items-center justify-between text-[11px] text-slate-400 font-mono\\\">\\n                    <span>{commit.author}</span>\\n                    <span className=\\\"flex items-center gap-1.5\\\">\\n                      <span className=\\\"text-emerald-400\\\">+{commit.diffSummary.insertions}</span>\\n                      <span className=\\\"text-rose-400\\\">-{commit.diffSummary.deletions}</span>\\n                      <span className=\\\"text-slate-500\\\">·</span>\\n                      <span>{commit.changedFiles.length} file(s)</span>\\n                    </span>\\n                  </div>\\n                </div>\\n              );\\n            })}\\n          </div>\\n\\n          {/* Section 4 Callout Box: Why Commit-Specific Versions Matter */}\\n          <div className=\\\"mt-4 p-3 bg-slate-950 border border-slate-800 rounded-lg text-xs\\\">\\n            <div className=\\\"flex items-center gap-1.5 text-amber-300 font-semibold mb-1\\\">\\n              <Info className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Commit-Specific Version Isolation</span>\\n            </div>\\n            <p className=\\\"text-slate-400 text-[11px] leading-relaxed\\\">\\n              VVA analyzes the exact version at commit <code className=\\\"text-indigo-300\\\">{selectedCommit.shortHash}</code>. It never mixes newer changes from subsequent commits or unrelated worktrees into the AI payload.\\n            </p>\\n          </div>\\n        </div>\\n\\n        {/* Right Col: Commit Details & Inspector */}\\n        <div className=\\\"lg:col-span-8 bg-slate-900 border border-slate-800 rounded-lg p-4 flex flex-col\\\">\\n          {/* Header info of selected commit */}\\n          <div className=\\\"border-b border-slate-800 pb-3 mb-3\\\">\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2 mb-1.5\\\">\\n              <h2 className=\\\"text-sm font-semibold text-slate-100 flex items-center gap-2\\\">\\n                <span>{selectedCommit.message}</span>\\n              </h2>\\n              <span className=\\\"text-xs font-mono text-slate-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800\\\">\\n                {selectedCommit.hash}\\n              </span>\\n            </div>\\n            <div className=\\\"flex flex-wrap items-center gap-3 text-xs text-slate-400\\\">\\n              <span>Author: <strong className=\\\"text-slate-200\\\">{selectedCommit.author}</strong></span>\\n              <span>·</span>\\n              <span>Parent: <code className=\\\"text-indigo-400\\\">{selectedCommit.parentHash ? selectedCommit.parentHash.slice(0, 7) : 'None (initial commit)'}</code></span>\\n              <span>·</span>\\n              <span>Date: {selectedCommit.date}</span>\\n            </div>\\n          </div>\\n\\n          {/* Changed Files Pill-bar */}\\n          <div className=\\\"mb-3\\\">\\n            <span className=\\\"text-[11px] font-medium text-slate-400 uppercase tracking-wider block mb-1.5\\\">\\n              Changed Files in this Commit ({selectedCommit.changedFiles.length})\\n            </span>\\n            <div className=\\\"flex flex-wrap gap-2\\\">\\n              {selectedCommit.changedFiles.map((f, idx) => {\\n                const isCurrent = idx === activeFileIndex;\\n                const statusColor = \\n                  f.status === 'A' ? 'text-emerald-400 border-emerald-900/60 bg-emerald-950/20' :\\n                  f.status === 'M' ? 'text-cyan-400 border-cyan-900/60 bg-cyan-950/20' :\\n                  'text-rose-400 border-rose-900/60 bg-rose-950/20';\\n\\n                return (\\n                  <button\\n                    key={f.file}\\n                    onClick={() => setActiveFileIndex(idx)}\\n                    className={`flex items-center gap-2 px-3 py-1.5 text-xs font-mono rounded border transition-colors ${\\n                      isCurrent \\n                        ? 'border-indigo-500 bg-slate-950 text-slate-100 shadow-sm' \\n                        : 'border-slate-800 bg-slate-950/50 text-slate-400 hover:text-slate-200'\\n                    }`}\\n                  >\\n                    <span className={`px-1 py-0.2 rounded text-[10px] font-bold border ${statusColor}`}>\\n                      {f.status}\\n                    </span>\\n                    <span>{f.file}</span>\\n                    <span className=\\\"text-[10px] text-slate-500\\\">\\n                      (+{f.additions}/-{f.deletions})\\n                    </span>\\n                  </button>\\n                );\\n              })}\\n            </div>\\n          </div>\\n\\n          {/* View Mode Toggle */}\\n          <div className=\\\"flex items-center justify-between border-b border-slate-800 pb-2 mb-3\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <button\\n                onClick={() => setViewMode('diff')}\\n                className={`px-3 py-1 text-xs font-medium rounded transition-colors ${\\n                  viewMode === 'diff' \\n                    ? 'bg-slate-800 text-white' \\n                    : 'text-slate-400 hover:text-slate-200'\\n                }`}\\n              >\\n                Git Diff Patch\\n              </button>\\n              <button\\n                onClick={() => setViewMode('committedContent')}\\n                className={`px-3 py-1 text-xs font-medium rounded transition-colors ${\\n                  viewMode === 'committedContent' \\n                    ? 'bg-slate-800 text-white' \\n                    : 'text-slate-400 hover:text-slate-200'\\n                }`}\\n              >\\n                Committed File Version ({activeFile?.status === 'D' ? 'Pre-deletion' : 'Commit State'})\\n              </button>\\n              <button\\n                onClick={() => setViewMode('projectJson')}\\n                className={`px-3 py-1 text-xs font-medium rounded transition-colors ${\\n                  viewMode === 'projectJson' \\n                    ? 'bg-slate-800 text-white' \\n                    : 'text-slate-400 hover:text-slate-200'\\n                }`}\\n              >\\n                .vva/output/project-data.json\\n              </button>\\n            </div>\\n\\n            {viewMode === 'projectJson' && (\\n              <button\\n                onClick={handleCopyJson}\\n                className=\\\"flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium text-slate-300 hover:text-white bg-slate-800 rounded border border-slate-700 transition-colors\\\"\\n              >\\n                {copiedJson ? (\\n                  <>\\n                    <Check className=\\\"w-3.5 h-3.5 text-emerald-400\\\" />\\n                    <span>Copied!</span>\\n                  </>\\n                ) : (\\n                  <>\\n                    <Copy className=\\\"w-3.5 h-3.5\\\" />\\n                    <span>Copy JSON</span>\\n                  </>\\n                )}\\n              </button>\\n            )}\\n          </div>\\n\\n          {/* Code Viewer Viewport */}\\n          <div className=\\\"flex-1 bg-slate-950 border border-slate-800 rounded-lg p-3 overflow-y-auto max-h-[500px] font-mono text-xs\\\">\\n            {viewMode === 'diff' && activeFile && (\\n              <div className=\\\"space-y-0.5\\\">\\n                <div className=\\\"text-slate-500 pb-1 border-b border-slate-800/80 mb-2\\\">\\n                  diff --git a/{activeFile.file} b/{activeFile.file} ({activeFile.status === 'A' ? 'Added' : activeFile.status === 'M' ? 'Modified' : 'Deleted'})\\n                </div>\\n                {activeFile.diff.split('\\\\n').map((line, i) => {\\n                  let lineClass = 'text-slate-300';\\n                  let bgClass = '';\\n                  if (line.startsWith('+')) {\\n                    lineClass = 'text-emerald-400';\\n                    bgClass = 'bg-emerald-950/20';\\n                  } else if (line.startsWith('-')) {\\n                    lineClass = 'text-rose-400';\\n                    bgClass = 'bg-rose-950/20';\\n                  } else if (line.startsWith('@@')) {\\n                    lineClass = 'text-cyan-400 font-semibold';\\n                    bgClass = 'bg-cyan-950/20';\\n                  }\\n\\n                  return (\\n                    <div key={i} className={`px-2 py-0.5 rounded-sm ${bgClass} ${lineClass} whitespace-pre-wrap`}>\\n                      {line}\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n            )}\\n\\n            {viewMode === 'committedContent' && activeFile && (\\n              <div className=\\\"space-y-0.5\\\">\\n                <div className=\\\"flex items-center justify-between text-slate-500 pb-1 border-b border-slate-800 mb-2\\\">\\n                  <span>File: {activeFile.file}</span>\\n                  {activeFile.status === 'D' && (\\n                    <span className=\\\"text-amber-400 flex items-center gap-1\\\">\\n                      <ShieldAlert className=\\\"w-3 h-3\\\" /> Captured from parent commit {selectedCommit.parentHash?.slice(0, 7)}\\n                    </span>\\n                  )}\\n                </div>\\n                {activeFile.content.split('\\\\n').map((line, i) => (\\n                  <div key={i} className=\\\"flex gap-4 hover:bg-slate-900/60 px-1 py-0.5\\\">\\n                    <span className=\\\"text-slate-600 select-none w-8 text-right shrink-0\\\">{i + 1}</span>\\n                    <span className=\\\"text-slate-300 whitespace-pre-wrap\\\">{line}</span>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n\\n            {viewMode === 'projectJson' && (\\n              <pre className=\\\"text-emerald-300/90 whitespace-pre-wrap leading-relaxed\\\">\\n                {JSON.stringify(projectDataJson, null, 2)}\\n              </pre>\\n            )}\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Modal: Simulate New Commit */}\\n      {showNewCommitModal && (\\n        <div className=\\\"fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-slate-900 border border-slate-800 rounded-xl max-w-xl w-full p-5 shadow-2xl\\\">\\n            <h3 className=\\\"text-sm font-semibold text-slate-100 mb-3 flex items-center gap-2\\\">\\n              <Plus className=\\\"w-4 h-4 text-indigo-400\\\" />\\n              <span>Simulate New Commit in {currentRepo.name}</span>\\n            </h3>\\n\\n            <form onSubmit={handleCreateCommit} className=\\\"space-y-3 text-xs\\\">\\n              <div>\\n                <label className=\\\"block text-slate-400 font-medium mb-1\\\">Commit Message</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={newMsg}\\n                  onChange={(e) => setNewMsg(e.target.value)}\\n                  required\\n                  className=\\\"w-full bg-slate-950 border border-slate-700 rounded px-3 py-1.5 text-slate-100 outline-none focus:border-indigo-500\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-3 gap-3\\\">\\n                <div className=\\\"col-span-2\\\">\\n                  <label className=\\\"block text-slate-400 font-medium mb-1\\\">File Path</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={newFile}\\n                    onChange={(e) => setNewFile(e.target.value)}\\n                    required\\n                    className=\\\"w-full bg-slate-950 border border-slate-700 rounded px-3 py-1.5 text-slate-100 outline-none focus:border-indigo-500 font-mono text-[11px]\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-slate-400 font-medium mb-1\\\">File State</label>\\n                  <select\\n                    value={newStatus}\\n                    onChange={(e) => setNewStatus(e.target.value as any)}\\n                    className=\\\"w-full bg-slate-950 border border-slate-700 rounded px-3 py-1.5 text-slate-100 outline-none focus:border-indigo-500\\\"\\n                  >\\n                    <option value=\\\"M\\\">Modified (M)</option>\\n                    <option value=\\\"A\\\">Added (A)</option>\\n                    <option value=\\\"D\\\">Deleted (D)</option>\\n                  </select>\\n                </div>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-400 font-medium mb-1\\\">Git Diff Patch</label>\\n                <textarea\\n                  rows={4}\\n                  value={newDiff}\\n                  onChange={(e) => setNewDiff(e.target.value)}\\n                  className=\\\"w-full bg-slate-950 border border-slate-700 rounded p-2.5 text-slate-100 font-mono text-[11px] outline-none focus:border-indigo-500\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-400 font-medium mb-1\\\">Committed File Content</label>\\n                <textarea\\n                  rows={4}\\n                  value={newContent}\\n                  onChange={(e) => setNewContent(e.target.value)}\\n                  className=\\\"w-full bg-slate-950 border border-slate-700 rounded p-2.5 text-slate-100 font-mono text-[11px] outline-none focus:border-indigo-500\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-end gap-2 pt-2 border-t border-slate-800\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowNewCommitModal(false)}\\n                  className=\\\"px-3 py-1.5 text-xs text-slate-400 hover:text-slate-200\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-4 py-1.5 text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white rounded transition-colors\\\"\\n                >\\n                  Create &amp; Inspect Commit\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\"\n+    },\n+    {\n+      \"file\": \"src/components/Header.tsx\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import React from 'react';\\nimport { Terminal, Play, GitBranch, ShieldCheck } from 'lucide-react';\\n\\ninterface HeaderProps {\\n  activeTab: string;\\n  setActiveTab: (tab: string) => void;\\n  onRunReport: () => void;\\n  isRunningReport: boolean;\\n  repoName: string;\\n  currentBranch: string;\\n}\\n\\nexport const Header: React.FC<HeaderProps> = ({\\n  activeTab,\\n  setActiveTab,\\n  onRunReport,\\n  isRunningReport,\\n  repoName,\\n  currentBranch,\\n}) => {\\n  return (\\n    <header className=\\\"flex items-center justify-between gap-8 px-6 py-3.5 bg-slate-900 border-b border-slate-800 text-slate-200 sticky top-0 z-50\\\">\\n      {/* Zone 1: Single text element wordmark */}\\n      <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n        <a \\n          href=\\\"#home\\\" \\n          onClick={(e) => { e.preventDefault(); setActiveTab('terminal'); }}\\n          className=\\\"flex items-center gap-2.5 text-base font-bold tracking-tight text-white hover:text-indigo-400 transition-colors whitespace-nowrap shrink-0\\\"\\n        >\\n          <div className=\\\"w-8 h-8 rounded-lg bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-mono text-sm font-semibold\\\">\\n            VVA\\n          </div>\\n          <span>VVA Orchestrator</span>\\n        </a>\\n        <span className=\\\"hidden lg:inline text-xs text-slate-500\\\">·</span>\\n        <div className=\\\"hidden lg:flex items-center gap-1.5 text-xs text-slate-400 font-mono\\\">\\n          <GitBranch className=\\\"w-3.5 h-3.5 text-slate-500\\\" />\\n          <span>{repoName}</span>\\n          <span className=\\\"text-slate-600\\\">/</span>\\n          <span className=\\\"text-indigo-300\\\">{currentBranch}</span>\\n        </div>\\n      </div>\\n\\n      {/* Zone 2: 5 clean single-line text navigation links */}\\n      <nav className=\\\"hidden md:flex items-center gap-6 text-xs font-medium text-slate-400\\\">\\n        <button\\n          onClick={() => setActiveTab('terminal')}\\n          className={`hover:text-white transition-colors whitespace-nowrap shrink-0 pb-0.5 border-b-2 ${\\n            activeTab === 'terminal' ? 'text-white border-indigo-500 font-semibold' : 'border-transparent'\\n          }`}\\n        >\\n          CLI Terminal\\n        </button>\\n        <button\\n          onClick={() => setActiveTab('collector')}\\n          className={`hover:text-white transition-colors whitespace-nowrap shrink-0 pb-0.5 border-b-2 ${\\n            activeTab === 'collector' ? 'text-white border-indigo-500 font-semibold' : 'border-transparent'\\n          }`}\\n        >\\n          Git Collector\\n        </button>\\n        <button\\n          onClick={() => setActiveTab('ai-engine')}\\n          className={`hover:text-white transition-colors whitespace-nowrap shrink-0 pb-0.5 border-b-2 ${\\n            activeTab === 'ai-engine' ? 'text-white border-indigo-500 font-semibold' : 'border-transparent'\\n          }`}\\n        >\\n          AI Engine\\n        </button>\\n        <button\\n          onClick={() => setActiveTab('documents')}\\n          className={`hover:text-white transition-colors whitespace-nowrap shrink-0 pb-0.5 border-b-2 ${\\n            activeTab === 'documents' ? 'text-white border-indigo-500 font-semibold' : 'border-transparent'\\n          }`}\\n        >\\n          Doc Generator\\n        </button>\\n        <button\\n          onClick={() => setActiveTab('architecture')}\\n          className={`hover:text-white transition-colors whitespace-nowrap shrink-0 pb-0.5 border-b-2 ${\\n            activeTab === 'architecture' ? 'text-white border-indigo-500 font-semibold' : 'border-transparent'\\n          }`}\\n        >\\n          Architecture\\n        </button>\\n        <button\\n          onClick={() => setActiveTab('team')}\\n          className={`hover:text-white transition-colors whitespace-nowrap shrink-0 pb-0.5 border-b-2 ${\\n            activeTab === 'team' ? 'text-white border-indigo-500 font-semibold' : 'border-transparent'\\n          }`}\\n        >\\n          Team &amp; Viva\\n        </button>\\n      </nav>\\n\\n      {/* Zone 3: 1 primary action */}\\n      <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n        <button\\n          onClick={onRunReport}\\n          disabled={isRunningReport}\\n          className={`flex items-center gap-2 px-3.5 py-1.5 text-xs font-semibold rounded-md transition-all whitespace-nowrap shrink-0 shadow-sm ${\\n            isRunningReport \\n              ? 'bg-indigo-950 text-indigo-300 border border-indigo-800/60 cursor-not-allowed'\\n              : 'bg-indigo-600 hover:bg-indigo-500 text-white active:scale-95'\\n          }`}\\n        >\\n          {isRunningReport ? (\\n            <>\\n              <div className=\\\"w-3 h-3 border-2 border-indigo-400 border-t-transparent rounded-full animate-spin\\\" />\\n              <span>Orchestrating...</span>\\n            </>\\n          ) : (\\n            <>\\n              <Play className=\\\"w-3.5 h-3.5 fill-current\\\" />\\n              <span>Run vva report</span>\\n            </>\\n          )}\\n        </button>\\n      </div>\\n    </header>\\n  );\\n};\"\n+    },\n+    {\n+      \"file\": \"src/components/TeamVivaView.tsx\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import React, { useState } from 'react';\\nimport { Users, GraduationCap, CheckCircle2, Clock, HelpCircle, ChevronDown, ChevronUp, Terminal, Cpu, FileText } from 'lucide-react';\\n\\nexport const TeamVivaView: React.FC = () => {\\n  const [openFaq, setOpenFaq] = useState<number | null>(0);\\n\\n  const teamMembers = [\\n    {\\n      name: 'Abhiram Binil',\\n      role: 'Person 1 · Lead Orchestrator',\\n      tech: 'Node.js · Git · Orchestration',\\n      email: 'Abhirambinil1@gmail.com',\\n      avatarBg: 'from-indigo-600 to-blue-700',\\n      icon: Terminal,\\n      responsibilities: [\\n        'Command Line Interface (CLI) implementation: vva init, status, report, watch',\\n        'Repository detection and commit metadata collection via Git commands',\\n        'Commit-specific code extractor and parent diff comparison',\\n        'Handling deleted files (D) by extracting parent commit snapshots',\\n        'Subprocess orchestration: spawning Python AI & Doc engines from Node.js',\\n        'JSON contract serialization (.vva/output/project-data.json)'\\n      ],\\n      vivaFocus: 'Be prepared to explain Git commit isolation, IPC between Node.js and Python, and why analyzing the latest working tree instead of the exact commit is catastrophic.'\\n    },\\n    {\\n      name: 'Vishnu G Pillai',\\n      role: 'Person 2 · AI Intelligence Lead',\\n      tech: 'Python · AI · NVIDIA API',\\n      email: 'vishnu.pillai@example.com',\\n      avatarBg: 'from-emerald-600 to-teal-700',\\n      icon: Cpu,\\n      responsibilities: [\\n        'Python AI engine integration with NVIDIA API (meta/llama-3.1-70b-instruct)',\\n        'Prompt engineering for structured technical extraction from diff patches',\\n        'Strict JSON output contract enforcement matching Section 5 schema',\\n        'Anti-hallucination guardrails: separating verifiable code facts from commit assumptions',\\n        'Large diff payload management and context pruning'\\n      ],\\n      vivaFocus: 'Be prepared to explain prompt engineering techniques, how you force the model to output strict JSON, and how you ensure the AI does not hallucinate features not present in the diff.'\\n    },\\n    {\\n      name: 'Vinay Bisht',\\n      role: 'Person 3 · Document Systems Lead',\\n      tech: 'Python · Document Generation',\\n      email: 'vinay.bisht@example.com',\\n      avatarBg: 'from-amber-600 to-orange-700',\\n      icon: FileText,\\n      responsibilities: [\\n        'Multi-format document generation pipelines: PDF, DOCX, PowerPoint',\\n        'ReportLab Python module for pixel-accurate technical PDF reports',\\n        'python-docx library for editable academic project synopses',\\n        'python-pptx library for automated 4-slide presentation decks',\\n        'Consistent layout templating, metadata headers, and pagination math'\\n      ],\\n      vivaFocus: 'Be prepared to explain the templating architecture, how structured AI JSON fields map to presentation slides and report tables, and handling variable length text.'\\n    }\\n  ];\\n\\n  const vivaQuestions = [\\n    {\\n      q: '1. Why do commit-specific file versions matter? Why not just read the latest files from the repository?',\\n      a: 'If a developer wants documentation for Commit B (e.g., \\\"Modify login validation\\\") which occurred between Commit A (\\\"Add login\\\") and Commit C (\\\"Fix bug in login\\\"), inspecting the latest file on disk from Commit C would explain code that was not even written yet during Commit B! VVA strictly queries `git show <commit-hash>:<file>` to extract the exact committed snapshot or the parent commit for deleted files.'\\n    },\\n    {\\n      q: '2. How does VVA handle deleted files (Git status \\\"D\\\")?',\\n      a: 'When a file is deleted in a commit, it no longer exists at that commit. If the collector tries to view it, it gets an error. VVA detects the \\\"D\\\" status and inspects the parent commit (`<commit-hash>~1:<file>`) to retrieve what was deleted and pair it with the deletion diff patch so the AI can explain what legacy feature was removed.'\\n    },\\n    {\\n      q: '3. How does the Node.js orchestrator communicate with the Python AI and Document modules?',\\n      a: 'VVA uses a clean file-and-stream based IPC (Inter-Process Communication). Node.js serializes repository context into `.vva/output/project-data.json`, then spawns the Python worker (`python ai/ai_engine.py --input .vva/output/project-data.json`). Python parses the JSON, calls the NVIDIA API, outputs `.vva/output/ai-response.json`, which is then passed to the Python document engine.'\\n    },\\n    {\\n      q: '4. How does the AI Engine prevent hallucinations from vague commit messages?',\\n      a: 'Commit messages can be deceptive (e.g., a commit message saying \\\"Implement full banking security\\\" might just be a single regex change). The AI engine is grounded by passing both the commit message AND the actual unified git diff. The system prompt instructs the model to only cite technical changes verified in the patch lines (`+` / `-`) and to explicitly flag limitations or unverified assumptions in `observationsAndLimitations`.'\\n    },\\n    {\\n      q: '5. What happens if a commit diff is huge (e.g., 50,000 lines or binary files)?',\\n      a: 'VVA enforces engineering bounds: it filters out binary files (images, compiled binaries), ignores vendor folders (like `node_modules/`), and enforces `maxDiffSizeBytes` (default 1MB). If a diff exceeds the cap, it truncates non-essential files, appends a truncation warning notice, and summarizes the changed file list.'\\n    },\\n    {\\n      q: '6. What is the difference between `vva status`, `vva report`, and `vva watch`?',\\n      a: '`vva status` is a lightweight diagnostic query verifying Git health, current branch, uncommitted files, and `.vva` initialization. `vva report` executes the full 4-stage pipeline (collect -> build JSON -> call AI -> generate documents). `vva watch` is a persistent daemon that listens for new commit hooks or HEAD reflog transitions and triggers the report pipeline automatically.'\\n    }\\n  ];\\n\\n  return (\\n    <div className=\\\"flex-1 max-w-7xl mx-auto px-4 py-4 w-full flex flex-col gap-6\\\">\\n      {/* Top Banner */}\\n      <div className=\\\"p-5 bg-slate-900 border border-slate-800 rounded-lg flex flex-wrap items-center justify-between gap-4\\\">\\n        <div>\\n          <span className=\\\"text-[11px] font-medium text-slate-400 uppercase tracking-wider block mb-1\\\">\\n            Section 10 &amp; 14 · Project Architecture Governance\\n          </span>\\n          <h1 className=\\\"text-lg font-bold text-slate-100 flex items-center gap-2\\\">\\n            <Users className=\\\"w-5 h-5 text-indigo-400\\\" />\\n            <span>Team Responsibilities &amp; Viva Examination Defense Hub</span>\\n          </h1>\\n          <p className=\\\"text-xs text-slate-400 mt-1\\\">\\n            Complete role distribution, milestone verification checklist, and core viva evaluation questions.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2 bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800 text-xs\\\">\\n          <GraduationCap className=\\\"w-4 h-4 text-emerald-400\\\" />\\n          <span className=\\\"text-slate-300 font-medium\\\">Viva Defense Ready</span>\\n        </div>\\n      </div>\\n\\n      {/* 3 Team Cards */}\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n        {teamMembers.map((member, idx) => {\\n          const Icon = member.icon;\\n          return (\\n            <div key={idx} className=\\\"bg-slate-900 border border-slate-800 rounded-lg p-5 flex flex-col justify-between\\\">\\n              <div>\\n                <div className=\\\"flex items-center gap-3 mb-3\\\">\\n                  <div className={`w-10 h-10 rounded-lg bg-gradient-to-br ${member.avatarBg} flex items-center justify-center text-white shadow-md`}>\\n                    <Icon className=\\\"w-5 h-5\\\" />\\n                  </div>\\n                  <div>\\n                    <h3 className=\\\"text-sm font-bold text-slate-100\\\">{member.name}</h3>\\n                    <span className=\\\"text-[11px] font-mono text-indigo-300 block\\\">{member.tech}</span>\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"mb-3 text-[11px] text-slate-400 font-medium bg-slate-950 p-2 rounded border border-slate-800/80\\\">\\n                  {member.role}\\n                </div>\\n\\n                <h4 className=\\\"text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-2\\\">\\n                  Assigned Responsibilities:\\n                </h4>\\n                <ul className=\\\"space-y-1.5 mb-4 text-xs text-slate-300\\\">\\n                  {member.responsibilities.map((r, i) => (\\n                    <li key={i} className=\\\"flex items-start gap-2 text-[11px] text-slate-400 leading-snug\\\">\\n                      <span className=\\\"text-emerald-400 shrink-0\\\">•</span>\\n                      <span>{r}</span>\\n                    </li>\\n                  ))}\\n                </ul>\\n              </div>\\n\\n              <div className=\\\"mt-2 p-3 bg-slate-950 border border-slate-800 rounded text-[11px] text-indigo-200/90 leading-relaxed\\\">\\n                <strong className=\\\"text-indigo-400 block mb-0.5\\\">Viva Defense Spotlight:</strong>\\n                {member.vivaFocus}\\n              </div>\\n            </div>\\n          );\\n        })}\\n      </div>\\n\\n      {/* Section 14 Milestone Status Table */}\\n      <div className=\\\"bg-slate-900 border border-slate-800 rounded-lg p-5\\\">\\n        <h2 className=\\\"text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3 flex items-center gap-2\\\">\\n          <CheckCircle2 className=\\\"w-4 h-4 text-emerald-400\\\" />\\n          <span>Section 14: Engineering Verification Status Matrix</span>\\n        </h2>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\\\">\\n          <div className=\\\"bg-slate-950 p-4 rounded-lg border border-slate-800 space-y-2\\\">\\n            <span className=\\\"text-emerald-400 font-semibold block mb-2 text-xs\\\">\\n              ✓ Implemented &amp; Tested Milestones (Node.js &amp; Core)\\n            </span>\\n            <div className=\\\"space-y-1.5 text-slate-300 text-[11px]\\\">\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-400\\\" /> CLI initialization (vva init) and status commands</div>\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-400\\\" /> Git repository detection and branch resolution</div>\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-400\\\" /> Commit metadata and file list extraction</div>\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-400\\\" /> Unified git diff parsing and line metrics</div>\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-400\\\" /> Project-data.json payload serialization</div>\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-400\\\" /> Deleted file parent version retrieval logic</div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"bg-slate-950 p-4 rounded-lg border border-slate-800 space-y-2\\\">\\n            <span className=\\\"text-cyan-400 font-semibold block mb-2 text-xs\\\">\\n              ✓ Orchestrated Integrated Pipeline Milestones\\n            </span>\\n            <div className=\\\"space-y-1.5 text-slate-300 text-[11px]\\\">\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-cyan-400\\\" /> Strict schema validation for AI response JSON</div>\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-cyan-400\\\" /> Multi-format document exporter (PDF · DOCX · PPTX)</div>\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-cyan-400\\\" /> End-to-end vva report command execution</div>\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-cyan-400\\\" /> Interactive commit watcher (vva watch) daemon</div>\\n              <div className=\\\"flex items-center gap-2\\\"><CheckCircle2 className=\\\"w-3.5 h-3.5 text-cyan-400\\\" /> Custom commit simulation and edge-case testing</div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Viva Q&A Accordion */}\\n      <div className=\\\"bg-slate-900 border border-slate-800 rounded-lg p-5\\\">\\n        <h2 className=\\\"text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3 flex items-center gap-2\\\">\\n          <HelpCircle className=\\\"w-4 h-4 text-amber-400\\\" />\\n          <span>Core Viva Examination Questions &amp; Technical Answers</span>\\n        </h2>\\n        <p className=\\\"text-xs text-slate-400 mb-4\\\">\\n          Click any question to inspect the technical rationale expected by viva examiners:\\n        </p>\\n\\n        <div className=\\\"space-y-2.5\\\">\\n          {vivaQuestions.map((item, idx) => {\\n            const isOpen = openFaq === idx;\\n            return (\\n              <div\\n                key={idx}\\n                className=\\\"bg-slate-950 border border-slate-800 rounded-lg overflow-hidden transition-colors\\\"\\n              >\\n                <button\\n                  onClick={() => setOpenFaq(isOpen ? null : idx)}\\n                  className=\\\"w-full p-3.5 text-left flex items-center justify-between text-xs font-semibold text-slate-200 hover:text-indigo-300\\\"\\n                >\\n                  <span>{item.q}</span>\\n                  {isOpen ? <ChevronUp className=\\\"w-4 h-4 text-slate-400\\\" /> : <ChevronDown className=\\\"w-4 h-4 text-slate-400\\\" />}\\n                </button>\\n                {isOpen && (\\n                  <div className=\\\"px-3.5 pb-3.5 text-xs text-slate-300 leading-relaxed border-t border-slate-850 pt-2\\\">\\n                    {item.a}\\n                  </div>\\n                )}\\n              </div>\\n            );\\n          })}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\"\n+    },\n+    {\n+      \"file\": \"src/components/TerminalView.tsx\",\n+      \"status\": \"A\",\n+      \"additions\": 0,\n+      \"deletions\": 0,\n+      \"content\": \"import React, { useState, useRef, useEffect } from 'react';\\nimport { Terminal as TerminalIcon, CornerDownLeft, Play, RefreshCw, Trash2, Shield, FolderGit2 } from 'lucide-react';\\nimport { Repository, GitCommit, VVAConfig, ProjectDataJSON, AIStructuredResponse } from '../types/vva';\\n\\ninterface TerminalViewProps {\\n  currentRepo: Repository;\\n  selectedCommit: GitCommit;\\n  vvaConfig: VVAConfig;\\n  isInitialized: boolean;\\n  setIsInitialized: (val: boolean) => void;\\n  onExecuteReport: (format?: string) => Promise<void>;\\n  isWatchMode: boolean;\\n  setIsWatchMode: (val: boolean) => void;\\n  lastProjectData: ProjectDataJSON | null;\\n  lastAIResponse: AIStructuredResponse | null;\\n  onSelectTab: (tab: string) => void;\\n}\\n\\ninterface LogEntry {\\n  id: string;\\n  type: 'cmd' | 'output' | 'success' | 'error' | 'info' | 'warn';\\n  text: string;\\n}\\n\\nexport const TerminalView: React.FC<TerminalViewProps> = ({\\n  currentRepo,\\n  selectedCommit,\\n  vvaConfig,\\n  isInitialized,\\n  setIsInitialized,\\n  onExecuteReport,\\n  isWatchMode,\\n  setIsWatchMode,\\n  lastProjectData,\\n  lastAIResponse,\\n  onSelectTab,\\n}) => {\\n  const [inputVal, setInputVal] = useState('');\\n  const [logs, setLogs] = useState<LogEntry[]>([\\n    {\\n      id: 'init-1',\\n      type: 'info',\\n      text: 'VVA — Version & Workflow Automator [Node.js Orchestrator CLI v1.0.0-rc1]'\\n    },\\n    {\\n      id: 'init-2',\\n      type: 'info',\\n      text: `Current workspace: ${currentRepo.path} (Git detected: branch '${currentRepo.currentBranch}')`\\n    },\\n    {\\n      id: 'init-3',\\n      type: 'output',\\n      text: \\\"Type 'vva status' to verify repository state, or 'vva report' to trigger end-to-end documentation generation.\\\"\\n    }\\n  ]);\\n  const [commandHistory, setCommandHistory] = useState<string[]>([]);\\n  const [historyIndex, setHistoryIndex] = useState<number>(-1);\\n  const [isProcessing, setIsProcessing] = useState(false);\\n  const terminalEndRef = useRef<HTMLDivElement>(null);\\n\\n  const scrollToBottom = () => {\\n    terminalEndRef.current?.scrollIntoView({ behavior: 'smooth' });\\n  };\\n\\n  useEffect(() => {\\n    scrollToBottom();\\n  }, [logs]);\\n\\n  // Handle watch mode simulation\\n  useEffect(() => {\\n    let watchInterval: any;\\n    if (isWatchMode) {\\n      setLogs(prev => [\\n        ...prev,\\n        { id: String(Date.now()), type: 'info', text: `[vva watch] Active file monitor daemon listening on ${currentRepo.path}/.git/refs/heads/${currentRepo.currentBranch}` },\\n        { id: String(Date.now() + 1), type: 'info', text: '[vva watch] Polling git reflog and worktree for new commit states...' }\\n      ]);\\n\\n      watchInterval = setInterval(() => {\\n        setLogs(prev => [\\n          ...prev,\\n          { \\n            id: String(Date.now()), \\n            type: 'output', \\n            text: `[vva watch ${new Date().toLocaleTimeString()}] Verified HEAD at ${selectedCommit.shortHash} - no new uncommitted index changes.` \\n          }\\n        ]);\\n      }, 7000);\\n    }\\n    return () => clearInterval(watchInterval);\\n  }, [isWatchMode, currentRepo, selectedCommit]);\\n\\n  const handleCommand = async (rawCmd: string) => {\\n    const cmd = rawCmd.trim();\\n    if (!cmd) return;\\n\\n    // Add to logs\\n    setLogs(prev => [\\n      ...prev,\\n      { id: String(Date.now()), type: 'cmd', text: cmd }\\n    ]);\\n    setCommandHistory(prev => [...prev, cmd]);\\n    setHistoryIndex(-1);\\n    setInputVal('');\\n\\n    const parts = cmd.split(' ');\\n    const mainCmd = parts[0].toLowerCase();\\n    const subCmd = parts[1]?.toLowerCase();\\n\\n    setIsProcessing(true);\\n\\n    if (mainCmd === 'clear') {\\n      setLogs([]);\\n      setIsProcessing(false);\\n      return;\\n    }\\n\\n    if (mainCmd === 'help') {\\n      setLogs(prev => [\\n        ...prev,\\n        { id: String(Date.now()), type: 'info', text: 'VVA Supported Commands:' },\\n        { id: String(Date.now() + 1), type: 'output', text: '  vva init                Initialize .vva configuration, logs, and output directories' },\\n        { id: String(Date.now() + 2), type: 'output', text: '  vva status              Check repository state, active commit, branch, and VVA status' },\\n        { id: String(Date.now() + 3), type: 'output', text: '  vva report [options]    Orchestrate full Git -> AI -> Document pipeline' },\\n        { id: String(Date.now() + 4), type: 'output', text: '                          Options: --commit <hash> | --format <pdf|docx|pptx|all> | --dry-run' },\\n        { id: String(Date.now() + 5), type: 'output', text: '  vva watch               Monitor repository commits in real time and trigger automatic doc generation' },\\n        { id: String(Date.now() + 6), type: 'output', text: '  git log -n <count>      Inspect recent Git commit history' },\\n        { id: String(Date.now() + 7), type: 'output', text: '  cat .vva/config.json    Display active VVA orchestrator configuration' },\\n        { id: String(Date.now() + 8), type: 'output', text: '  clear                   Clear terminal viewport' }\\n      ]);\\n      setIsProcessing(false);\\n      return;\\n    }\\n\\n    if (mainCmd === 'vva') {\\n      if (!subCmd) {\\n        setLogs(prev => [\\n          ...prev,\\n          { id: String(Date.now()), type: 'error', text: \\\"Error: Missing command. Try 'vva status', 'vva init', or 'vva report'.\\\" }\\n        ]);\\n        setIsProcessing(false);\\n        return;\\n      }\\n\\n      if (subCmd === 'init') {\\n        setTimeout(() => {\\n          setIsInitialized(true);\\n          setLogs(prev => [\\n            ...prev,\\n            { id: String(Date.now()), type: 'info', text: `Checking Git root at ${currentRepo.path}... [OK]` },\\n            { id: String(Date.now() + 1), type: 'output', text: 'Creating directory structure:' },\\n            { id: String(Date.now() + 2), type: 'output', text: '  + .vva/config.json' },\\n            { id: String(Date.now() + 3), type: 'output', text: '  + .vva/logs/orchestrator.log' },\\n            { id: String(Date.now() + 4), type: 'output', text: '  + .vva/output/' },\\n            { id: String(Date.now() + 5), type: 'success', text: '✓ VVA successfully initialized for repository: ' + currentRepo.name },\\n            { id: String(Date.now() + 6), type: 'output', text: \\\"Run 'vva status' to verify environment or 'vva report' to generate technical documents.\\\" }\\n          ]);\\n          setIsProcessing(false);\\n        }, 400);\\n        return;\\n      }\\n\\n      if (subCmd === 'status') {\\n        setTimeout(() => {\\n          setLogs(prev => [\\n            ...prev,\\n            { id: String(Date.now()), type: 'info', text: '================ VVA REPOSITORY STATUS ================' },\\n            { id: String(Date.now() + 1), type: 'output', text: `Repository:         ${currentRepo.name} (${currentRepo.path})` },\\n            { id: String(Date.now() + 2), type: 'output', text: `Active Branch:      ${currentRepo.currentBranch}` },\\n            { id: String(Date.now() + 3), type: 'output', text: `Latest Commit:      ${selectedCommit.hash}` },\\n            { id: String(Date.now() + 4), type: 'output', text: `Commit Subject:     \\\"${selectedCommit.message}\\\"` },\\n            { id: String(Date.now() + 5), type: 'output', text: `Author:             ${selectedCommit.author} <${selectedCommit.email}>` },\\n            { id: String(Date.now() + 6), type: 'output', text: `Files Changed:      ${selectedCommit.changedFiles.length} file(s) (+${selectedCommit.diffSummary.insertions} / -${selectedCommit.diffSummary.deletions})` },\\n            { id: String(Date.now() + 7), type: isInitialized ? 'success' : 'warn', text: `VVA Environment:    ${isInitialized ? '✓ Initialized (.vva/ directory configured)' : '! Not initialized (Run vva init)'}` },\\n            { id: String(Date.now() + 8), type: 'output', text: `AI Provider:        ${vvaConfig.aiProvider.toUpperCase()} (${vvaConfig.aiModel})` },\\n            { id: String(Date.now() + 9), type: 'output', text: `Output Destination: ${vvaConfig.outputDir}/` },\\n            { id: String(Date.now() + 10), type: 'info', text: '========================================================' }\\n          ]);\\n          setIsProcessing(false);\\n        }, 300);\\n        return;\\n      }\\n\\n      if (subCmd === 'watch') {\\n        const nextWatch = !isWatchMode;\\n        setIsWatchMode(nextWatch);\\n        setLogs(prev => [\\n          ...prev,\\n          { \\n            id: String(Date.now()), \\n            type: nextWatch ? 'success' : 'info', \\n            text: nextWatch \\n              ? '✓ [vva watch] Commit watcher daemon engaged. Listening for git commit hooks...' \\n              : '✓ [vva watch] Commit watcher stopped.' \\n          }\\n        ]);\\n        setIsProcessing(false);\\n        return;\\n      }\\n\\n      if (subCmd === 'report') {\\n        const formatArg = parts.find(p => p.startsWith('--format='))?.split('=')[1] || \\n                          (parts.includes('--format') ? parts[parts.indexOf('--format') + 1] : 'all');\\n        const isDryRun = parts.includes('--dry-run');\\n\\n        setLogs(prev => [\\n          ...prev,\\n          { id: String(Date.now()), type: 'info', text: 'Starting VVA Orchestration Pipeline...' },\\n          { id: String(Date.now() + 1), type: 'output', text: `[Stage 1/4] Git Collector: Querying commit ${selectedCommit.shortHash} on ${currentRepo.currentBranch}...` }\\n        ]);\\n\\n        try {\\n          await onExecuteReport(formatArg);\\n          setLogs(prev => [\\n            ...prev,\\n            { id: String(Date.now() + 2), type: 'output', text: `[Stage 1/4] Git Collector: Collected ${selectedCommit.changedFiles.length} files. State: M=${selectedCommit.changedFiles.filter(f => f.status === 'M').length}, A=${selectedCommit.changedFiles.filter(f => f.status === 'A').length}, D=${selectedCommit.changedFiles.filter(f => f.status === 'D').length}` },\\n            { id: String(Date.now() + 3), type: 'output', text: '[Stage 2/4] Orchestrator: Built .vva/output/project-data.json payload (Validated schema ✓)' },\\n            { id: String(Date.now() + 4), type: 'output', text: `[Stage 3/4] AI Engine: Spawned python ai/ai_engine.py with NVIDIA model ${vvaConfig.aiModel}...` },\\n            { id: String(Date.now() + 5), type: 'output', text: '[Stage 3/4] AI Engine: Received structured response JSON (Confidence: 0.96) ✓' },\\n            { id: String(Date.now() + 6), type: 'output', text: `[Stage 4/4] Document Engine: Calling Python ReportLab / python-docx / python-pptx...` },\\n            { id: String(Date.now() + 7), type: 'success', text: `✓ Generation Complete! Created output artifacts in ${vvaConfig.outputDir}:` },\\n            { id: String(Date.now() + 8), type: 'output', text: `  → PDF Technical Report:    ${vvaConfig.outputDir}/${currentRepo.name}_${selectedCommit.shortHash}_report.pdf` },\\n            { id: String(Date.now() + 9), type: 'output', text: `  → DOCX Project Synopsis:   ${vvaConfig.outputDir}/${currentRepo.name}_${selectedCommit.shortHash}_synopsis.doc` },\\n            { id: String(Date.now() + 10), type: 'output', text: `  → PowerPoint Presentation: ${vvaConfig.outputDir}/${currentRepo.name}_${selectedCommit.shortHash}_slides.pptx` },\\n            { id: String(Date.now() + 11), type: 'info', text: \\\"Switch to 'Doc Generator' or 'AI Engine' tab above to preview and download.\\\" }\\n          ]);\\n        } catch (err: any) {\\n          setLogs(prev => [\\n            ...prev,\\n            { id: String(Date.now()), type: 'error', text: `Orchestration Error: ${err.message}` }\\n          ]);\\n        }\\n\\n        setIsProcessing(false);\\n        return;\\n      }\\n\\n      setLogs(prev => [\\n        ...prev,\\n        { id: String(Date.now()), type: 'error', text: `Unknown VVA command: 'vva ${subCmd}'. Type 'help' for available commands.` }\\n      ]);\\n      setIsProcessing(false);\\n      return;\\n    }\\n\\n    if (mainCmd === 'git') {\\n      if (subCmd === 'log') {\\n        const count = parts.includes('-n') ? parseInt(parts[parts.indexOf('-n') + 1], 10) || 3 : 3;\\n        setLogs(prev => [\\n          ...prev,\\n          { id: String(Date.now()), type: 'info', text: `Showing last ${count} commit(s) on branch ${currentRepo.currentBranch}:` },\\n          ...currentRepo.commits.slice(0, count).map((c, i) => ({\\n            id: String(Date.now() + i + 1),\\n            type: 'output' as const,\\n            text: `commit ${c.hash}\\\\nAuthor: ${c.author} <${c.email}>\\\\nDate:   ${c.date}\\\\n\\\\n    ${c.message}\\\\n`\\n          }))\\n        ]);\\n        setIsProcessing(false);\\n        return;\\n      }\\n\\n      if (subCmd === 'status') {\\n        setLogs(prev => [\\n          ...prev,\\n          { id: String(Date.now()), type: 'output', text: `On branch ${currentRepo.currentBranch}\\\\nYour branch is up to date with 'origin/${currentRepo.currentBranch}'.\\\\n\\\\nnothing to commit, working tree clean` }\\n        ]);\\n        setIsProcessing(false);\\n        return;\\n      }\\n    }\\n\\n    if (cmd === 'cat .vva/config.json') {\\n      setLogs(prev => [\\n        ...prev,\\n        { id: String(Date.now()), type: 'info', text: JSON.stringify(vvaConfig, null, 2) }\\n      ]);\\n      setIsProcessing(false);\\n      return;\\n    }\\n\\n    // Default unknown command\\n    setLogs(prev => [\\n      ...prev,\\n      { id: String(Date.now()), type: 'error', text: `bash: command not found: ${cmd}. Type 'help' to see VVA orchestrator commands.` }\\n    ]);\\n    setIsProcessing(false);\\n  };\\n\\n  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {\\n    if (e.key === 'Enter') {\\n      handleCommand(inputVal);\\n    } else if (e.key === 'ArrowUp') {\\n      e.preventDefault();\\n      if (commandHistory.length > 0) {\\n        const nextIndex = historyIndex === -1 ? commandHistory.length - 1 : Math.max(0, historyIndex - 1);\\n        setHistoryIndex(nextIndex);\\n        setInputVal(commandHistory[nextIndex]);\\n      }\\n    } else if (e.key === 'ArrowDown') {\\n      e.preventDefault();\\n      if (historyIndex !== -1) {\\n        const nextIndex = historyIndex + 1;\\n        if (nextIndex < commandHistory.length) {\\n          setHistoryIndex(nextIndex);\\n          setInputVal(commandHistory[nextIndex]);\\n        } else {\\n          setHistoryIndex(-1);\\n          setInputVal('');\\n        }\\n      }\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"flex flex-col h-[calc(100vh-4rem)] max-w-7xl mx-auto px-4 py-4 w-full\\\">\\n      {/* Quick Action Bar */}\\n      <div className=\\\"flex flex-wrap items-center justify-between gap-3 mb-3 p-3 bg-slate-900/80 border border-slate-800 rounded-lg\\\">\\n        <div className=\\\"flex items-center gap-2 text-xs text-slate-400\\\">\\n          <TerminalIcon className=\\\"w-4 h-4 text-indigo-400\\\" />\\n          <span className=\\\"font-semibold text-slate-200\\\">Interactive VVA Orchestrator Terminal</span>\\n          <span className=\\\"text-slate-600\\\">·</span>\\n          <span>Target: {currentRepo.name} ({selectedCommit.shortHash})</span>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2\\\">\\n          <button\\n            onClick={() => handleCommand('vva status')}\\n            className=\\\"px-2.5 py-1 text-xs font-mono font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700/60 transition-colors\\\"\\n          >\\n            vva status\\n          </button>\\n          <button\\n            onClick={() => handleCommand('vva init')}\\n            className=\\\"px-2.5 py-1 text-xs font-mono font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700/60 transition-colors\\\"\\n          >\\n            vva init\\n          </button>\\n          <button\\n            onClick={() => handleCommand('vva report')}\\n            className=\\\"px-2.5 py-1 text-xs font-mono font-medium bg-indigo-900/50 hover:bg-indigo-800/60 text-indigo-300 rounded border border-indigo-700/60 transition-colors\\\"\\n          >\\n            vva report\\n          </button>\\n          <button\\n            onClick={() => handleCommand('vva watch')}\\n            className={`px-2.5 py-1 text-xs font-mono font-medium rounded border transition-colors ${\\n              isWatchMode \\n                ? 'bg-amber-950 text-amber-300 border-amber-800'\\n                : 'bg-slate-800 hover:bg-slate-700 text-slate-300 border-slate-700/60'\\n            }`}\\n          >\\n            {isWatchMode ? 'Stop watch' : 'vva watch'}\\n          