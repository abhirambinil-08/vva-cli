     console.error(`\\\\x1b[31mError: ${res.message}\\\\x1b[0m`);\\n+        process.exit(1);\\n+      }\\n+\\n+      console.log('\\\\x1b[36m=== VVA Repository Status ===\\\\x1b[0m');\\n+      console.log(`Repository:      ${res.repositoryName} (${res.repositoryPath})`);\\n+      console.log(`Current Branch:  ${res.branch}`);\\n+      if (res.latestCommit) {\\n+        console.log(`HEAD Commit:     ${res.latestCommit.shortHash} - \\\"${res.latestCommit.message}\\\"`);\\n+        console.log(`Author:          ${res.latestCommit.author} <${res.latestCommit.email}>`);\\n+        console.log(`Date:            ${res.latestCommit.date}`);\\n+      } else {\\n+        console.log(`HEAD Commit:     No commits found (empty repository)`);\\n+      }\\n+      console.log(`Working Tree:    ${res.uncommittedCount === 0 ? '\\\\x1b[32mClean (0 uncommitted changes)\\\\x1b[0m' : `\\\\x1b[33m${res.uncommittedCount} uncommitted change(s)\\\\x1b[0m`}`);\\n+      console.log(`VVA Environment: ${res.isInitialized ? '\\\\x1b[32mInitialized (.vva/)\\\\x1b[0m' : '\\\\x1b[33mNot initialized (run vva init)\\\\x1b[0m'}`);\\n+      console.log(`Python Runtime:  ${res.pythonReady ? `\\\\x1b[32m${res.pythonBinary}\\\\x1b[0m` : '\\\\x1b[31mNot found\\\\x1b[0m'}`);\\n+      console.log('=============================');\\n+      process.exit(0);\\n+    }\\n+\\n+    if (command === 'report') {\\n+      const commitIndex = args.indexOf('--commit');\\n+      const targetCommit = commitIndex !== -1 ? args[commitIndex + 1] : 'HEAD';\\n+\\n+      const formatIndex = args.indexOf('--format');\\n+      const format = formatIndex !== -1 ? args[formatIndex + 1] : 'all';\\n+\\n+      const dryRun = args.includes('--dry-run');\\n+\\n+      console.log(`\\\\x1b[36m[Stage 1/4] Git Data Collector: Inspecting commit ${targetCommit}...\\\\x1b[0m`);\\n+      const res = await reportCommand({ commit: targetCommit, format, dryRun });\\n+\\n+      if (res.dryRun) {\\n+        console.log(`\\\\x1b[32m✓ Dry-run completed. Saved project data to ${res.projectDataPath}\\\\x1b[0m`);\\n+        console.log(`  Analyzed commit: ${res.analyzedCommit.slice(0, 7)} (${res.changedFiles} files)`);\\n+        process.exit(0);\\n+      }\\n+\\n+      console.log(`\\\\x1b[32m✓ Pipeline Execution Succeeded!\\\\x1b[0m`);\\n+      console.log(`Repository:      ${res.repository}`);\\n+      console.log(`Commit:          ${res.analyzedCommit.slice(0, 7)} (\\\"${res.commitMessage}\\\")`);\\n+      console.log(`Feature Analyzed: \\\"${res.aiTitle}\\\"`);\\n+      console.log(`Project Data:    ${res.projectDataPath}`);\\n+      console.log(`AI Response:     ${res.aiOutputPath}`);\\n+      console.log(`\\\\n\\\\x1b[32mGenerated Artifacts:\\\\x1b[0m`);\\n+      for (const f of res.generatedFiles) {\\n+        console.log(`  → ${f.filename} (${(f.sizeBytes / 1024).toFixed(1)} KB) in ${f.path}`);\\n+      }\\n+      process.exit(0);\\n+    }\\n+\\n+    if (command === 'watch') {\\n+      console.log('\\\\x1b[36m[vva watch] Starting Git commit monitor daemon. Press Ctrl+C to exit.\\\\x1b[0m');\\n+      await watchCommand();\\n+      // Keep process open\\n+      return;\\n+    }\\n+\\n+    console.error(`\\\\x1b[31mUnknown command: '${command}'. Type 'vva help' for usage.\\\\x1b[0m`);\\n+    process.exit(1);\\n+  } catch (error) {\\n+    console.error(`\\\\x1b[31mError: ${error.message}\\\\x1b[0m`);\\n+    process.exit(1);\\n+  }\\n+}\\n+\\n+main();\\ndiff --git a/src/commands/init.js b/src/commands/init.js\\nnew file mode 100644\\nindex 0000000..26e9f9e\\n--- /dev/null\\n+++ b/src/commands/init.js\\n@@ -0,0 +1,49 @@\\n+import fs from 'node:fs/promises';\\n+import path from 'node:path';\\n+import { isGitRepo, getRepoRoot } from '../core/git.js';\\n+import { getPythonBinary } from '../core/python.js';\\n+\\n+export async function initCommand(cwd = process.cwd()) {\\n+  const isRepo = await isGitRepo(cwd);\\n+  if (!isRepo) {\\n+    throw new Error(`Cannot initialize VVA: directory '${cwd}' is not a Git repository. Run 'git init' first.`);\\n+  }\\n+\\n+  const root = await getRepoRoot(cwd);\\n+  const vvaDir = path.join(root, '.vva');\\n+  const logsDir = path.join(vvaDir, 'logs');\\n+  const outputDir = path.join(vvaDir, 'output');\\n+  const configFile = path.join(vvaDir, 'config.json');\\n+\\n+  await fs.mkdir(vvaDir, { recursive: true });\\n+  await fs.mkdir(logsDir, { recursive: true });\\n+  await fs.mkdir(outputDir, { recursive: true });\\n+\\n+  const pythonBin = await getPythonBinary();\\n+\\n+  const defaultConfig = {\\n+    vvaVersion: '1.0.0',\\n+    initializedAt: new Date().toISOString(),\\n+    defaultFormat: 'all',\\n+    outputDir: '.vva/output',\\n+    pythonBinary: pythonBin,\\n+    aiProvider: 'nvidia',\\n+    aiModel: 'meta/llama-3.1-70b-instruct',\\n+    maxDiffSizeBytes: 1048576,\\n+    team: {\\n+      orchestrator: 'Abhiram Binil (Person 1)',\\n+      aiEngine: 'Vishnu G Pillai (Person 2)',\\n+      documentEngine: 'Vinay Bisht (Person 3)'\\n+    }\\n+  };\\n+\\n+  await fs.writeFile(configFile, JSON.stringify(defaultConfig, null, 2), 'utf8');\\n+\\n+  // Also ensure .gitignore ignores .vva logs and heavy artifacts if preferred\\n+  return {\\n+    success: true,\\n+    root,\\n+    vvaDir,\\n+    config: defaultConfig\\n+  };\\n+}\\ndiff --git a/src/commands/report.js b/src/commands/report.js\\nnew file mode 100644\\nindex 0000000..d1fff3f\\n--- /dev/null\\n+++ b/src/commands/report.js\\n@@ -0,0 +1,122 @@\\n+import fs from 'node:fs/promises';\\n+import path from 'node:path';\\n+import { getRepoRoot } from '../core/git.js';\\n+import { collectGitData } from '../core/collector.js';\\n+import { invokePythonModule } from '../core/python.js';\\n+\\n+export async function reportCommand(options = {}, cwd = process.cwd()) {\\n+  const root = await getRepoRoot(cwd);\\n+  const vvaDir = path.join(root, '.vva');\\n+  const outputDir = path.join(vvaDir, 'output');\\n+  const configFile = path.join(vvaDir, 'config.json');\\n+\\n+  // 1. Ensure .vva is initialized\\n+  let config = {};\\n+  try {\\n+    const rawConfig = await fs.readFile(configFile, 'utf8');\\n+    config = JSON.parse(rawConfig);\\n+  } catch {\\n+    // Auto-create directory structure if running in uninitialized repo\\n+    await fs.mkdir(outputDir, { recursive: true });\\n+    config = { defaultFormat: 'all', maxDiffSizeBytes: 1048576 };\\n+  }\\n+\\n+  const targetCommit = options.commit || 'HEAD';\\n+  const format = options.format || config.defaultFormat || 'all';\\n+\\n+  // 2. Stage 1/4: Git Data Collection\\n+  const projectData = await collectGitData(targetCommit, root, {\\n+    maxDiffSizeBytes: config.maxDiffSizeBytes\\n+  });\\n+\\n+  const projectDataPath = path.join(outputDir, 'project-data.json');\\n+  await fs.writeFile(projectDataPath, JSON.stringify(projectData, null, 2), 'utf8');\\n+\\n+  if (options.dryRun) {\\n+    return {\\n+      dryRun: true,\\n+      projectDataPath,\\n+      analyzedCommit: projectData.analyzedCommit,\\n+      changedFiles: projectData.changedFiles.length\\n+    };\\n+  }\\n+\\n+  // 3. Stage 2/4: Invoke Python AI Engine\\n+  const aiOutputPath = path.join(outputDir, 'ai-response.json');\\n+  await invokePythonModule(\\n+    'ai/ai_engine.py',\\n+    ['--input', projectDataPath, '--output', aiOutputPath],\\n+    root\\n+  );\\n+\\n+  // Validate that ai-response.json was created and is valid JSON\\n+  let aiData;\\n+  try {\\n+    const rawAi = await fs.readFile(aiOutputPath, 'utf8');\\n+    aiData = JSON.parse(rawAi);\\n+    if (!aiData.title || !aiData.summary || !Array.isArray(aiData.technicalChanges)) {\\n+      throw new Error('AI response JSON is missing required fields.');\\n+    }\\n+  } catch (err) {\\n+    throw new Error(`AI Engine verification failed: ${err.message}`);\\n+  }\\n+\\n+  // 4. Stage 3/4: Invoke Python Document Generation Engine\\n+  const docResultRaw = await invokePythonModule(\\n+    'document_engine/document_engine.py',\\n+    [\\n+      '--ai-input', aiOutputPath,\\n+      '--project-input', projectDataPath,\\n+      '--output-dir', outputDir,\\n+      '--format', format\\n+    ],\\n+    root\\n+  );\\n+\\n+  let docResults = [];\\n+  try {\\n+    docResults = JSON.parse(docResultRaw);\\n+  } catch {\\n+    // If output contained non-JSON debug logs, check disk files\\n+  }\\n+\\n+  // 5. Verify generated files on disk\\n+  const shortHash = projectData.analyzedCommit.slice(0, 7);\\n+  const repoName = projectData.repository;\\n+  const expectedFiles = [];\\n+\\n+  if (format === 'pdf' || format === 'all') {\\n+    expectedFiles.push(path.join(outputDir, `${repoName}_${shortHash}_report.pdf`));\\n+  }\\n+  if (format === 'docx' || format === 'all') {\\n+    expectedFiles.push(path.join(outputDir, `${repoName}_${shortHash}_synopsis.docx`));\\n+  }\\n+  if (format === 'pptx' || format === 'all') {\\n+    expectedFiles.push(path.join(outputDir, `${repoName}_${shortHash}_presentation.pptx`));\\n+  }\\n+\\n+  const verifiedFiles = [];\\n+  for (const f of expectedFiles) {\\n+    try {\\n+      const stat = await fs.stat(f);\\n+      verifiedFiles.push({\\n+        path: f,\\n+        filename: path.basename(f),\\n+        sizeBytes: stat.size\\n+      });\\n+    } catch {\\n+      // File was not generated\\n+    }\\n+  }\\n+\\n+  return {\\n+    success: true,\\n+    repository: projectData.repository,\\n+    analyzedCommit: projectData.analyzedCommit,\\n+    commitMessage: projectData.commitMessage,\\n+    projectDataPath,\\n+    aiOutputPath,\\n+    aiTitle: aiData.title,\\n+    generatedFiles: verifiedFiles\\n+  };\\n+}\\ndiff --git a/src/commands/status.js b/src/commands/status.js\\nnew file mode 100644\\nindex 0000000..5b6967f\\n--- /dev/null\\n+++ b/src/commands/status.js\\n@@ -0,0 +1,66 @@\\n+import fs from 'node:fs/promises';\\n+import path from 'node:path';\\n+import { isGitRepo, getRepoRoot, getCurrentBranch, execGit, getCommitDetails } from '../core/git.js';\\n+import { getPythonBinary } from '../core/python.js';\\n+\\n+export async function statusCommand(cwd = process.cwd()) {\\n+  const isRepo = await isGitRepo(cwd);\\n+  if (!isRepo) {\\n+    return {\\n+      isGitRepo: false,\\n+      message: `Directory '${cwd}' is not inside a Git repository.`\\n+    };\\n+  }\\n+\\n+  const root = await getRepoRoot(cwd);\\n+  const branch = await getCurrentBranch(root);\\n+  const configFile = path.join(root, '.vva', 'config.json');\\n+\\n+  let isInitialized = false;\\n+  let config = null;\\n+  try {\\n+    const raw = await fs.readFile(configFile, 'utf8');\\n+    config = JSON.parse(raw);\\n+    isInitialized = true;\\n+  } catch {\\n+    isInitialized = false;\\n+  }\\n+\\n+  let latestCommit = null;\\n+  try {\\n+    const headHash = await execGit(['rev-parse', 'HEAD'], root);\\n+    latestCommit = await getCommitDetails(headHash, root);\\n+  } catch {\\n+    latestCommit = null; // Repo might have 0 commits\\n+  }\\n+\\n+  let uncommittedCount = 0;\\n+  try {\\n+    const statusRaw = await execGit(['status', '--porcelain'], root);\\n+    uncommittedCount = statusRaw ? statusRaw.split('\\\\n').filter(Boolean).length : 0;\\n+  } catch {\\n+    //\\n+  }\\n+\\n+  let pythonReady = false;\\n+  let pythonBin = null;\\n+  try {\\n+    pythonBin = await getPythonBinary();\\n+    pythonReady = true;\\n+  } catch {\\n+    pythonReady = false;\\n+  }\\n+\\n+  return {\\n+    isGitRepo: true,\\n+    repositoryName: path.basename(root),\\n+    repositoryPath: root,\\n+    branch,\\n+    isInitialized,\\n+    config,\\n+    latestCommit,\\n+    uncommittedCount,\\n+    pythonReady,\\n+    pythonBinary: pythonBin\\n+  };\\n+}\\ndiff --git a/src/commands/watch.js b/src/commands/watch.js\\nnew file mode 100644\\nindex 0000000..bb461aa\\n--- /dev/null\\n+++ b/src/commands/watch.js\\n@@ -0,0 +1,44 @@\\n+import { getRepoRoot, execGit } from '../core/git.js';\\n+import { reportCommand } from './report.js';\\n+\\n+/**\\n+ * Watcher daemon that monitors Git HEAD ref updates.\\n+ */\\n+export async function watchCommand(options = {}, cwd = process.cwd(), onCommitDetected) {\\n+  const root = await getRepoRoot(cwd);\\n+  let lastKnownCommit = null;\\n+\\n+  try {\\n+    lastKnownCommit = await execGit(['rev-parse', 'HEAD'], root);\\n+  } catch {\\n+    //\\n+  }\\n+\\n+  const pollIntervalMs = options.intervalMs || 4000;\\n+  let isRunning = true;\\n+\\n+  const intervalId = setInterval(async () => {\\n+    if (!isRunning) return;\\n+    try {\\n+      const currentCommit = await execGit(['rev-parse', 'HEAD'], root);\\n+      if (currentCommit && currentCommit !== lastKnownCommit) {\\n+        lastKnownCommit = currentCommit;\\n+        if (onCommitDetected) {\\n+          onCommitDetected(currentCommit);\\n+        } else {\\n+          console.log(`[vva watch] New commit detected: ${currentCommit.slice(0, 7)}. Generating reports...`);\\n+          await reportCommand({ commit: currentCommit, format: options.format || 'all' }, root);\\n+        }\\n+      }\\n+    } catch {\\n+      //\\n+    }\\n+  }, pollIntervalMs);\\n+\\n+  return {\\n+    stop: () => {\\n+      isRunning = false;\\n+      clearInterval(intervalId);\\n+    }\\n+  };\\n+}\\ndiff --git a/src/components/AIEngineView.tsx b/src/components/AIEngineView.tsx\\nnew file mode 100644\\nindex 0000000..4fdba0a\\n--- /dev/null\\n+++ b/src/components/AIEngineView.tsx\\n@@ -0,0 +1,240 @@\\n+import React, { useState } from 'react';\\n+import { Cpu, CheckCircle2, AlertTriangle, Sparkles, Code2, Eye, ShieldCheck, Copy, Check } from 'lucide-react';\\n+import { Repository, GitCommit, AIStructuredResponse, VVAConfig, ProjectDataJSON } from '../types/vva';\\n+import { buildProjectDataJSON, generateStructuredAIResponse } from '../utils/orchestrator';\\n+\\n+interface AIEngineViewProps {\\n+  currentRepo: Repository;\\n+  selectedCommit: GitCommit;\\n+  vvaConfig: VVAConfig;\\n+  lastAIResponse: AIStructuredResponse | null;\\n+  onUpdateAIResponse: (response: AIStructuredResponse) => void;\\n+}\\n+\\n+export const AIEngineView: React.FC<AIEngineViewProps> = ({\\n+  currentRepo,\\n+  selectedCommit,\\n+  vvaConfig,\\n+  lastAIResponse,\\n+  onUpdateAIResponse,\\n+}) => {\\n+  const [provider, setProvider] = useState<'nvidia' | 'gemini'>(vvaConfig.aiProvider);\\n+  const [isAnalyzing, setIsAnalyzing] = useState(false);\\n+  const [copiedJson, setCopiedJson] = useState(false);\\n+\\n+  const projectData: ProjectDataJSON = buildProjectDataJSON(currentRepo, selectedCommit, vvaConfig);\\n+  const activeResponse: AIStructuredResponse = lastAIResponse || generateStructuredAIResponse(projectData, provider);\\n+\\n+  const handleRunAnalysis = () => {\\n+    setIsAnalyzing(true);\\n+    setTimeout(() => {\\n+      const resp = generateStructuredAIResponse(projectData, provider);\\n+      onUpdateAIResponse(resp);\\n+      setIsAnalyzing(false);\\n+    }, 600);\\n+  };\\n+\\n+  const handleCopy = () => {\\n+    navigator.clipboard.writeText(JSON.stringify(activeResponse, null, 2));\\n+    setCopiedJson(true);\\n+    setTimeout(() => setCopiedJson(false), 2000);\\n+  };\\n+\\n+  return (\\n+    <div className=\\\"flex-1 max-w-7xl mx-auto px-4 py-4 w-full flex flex-col gap-4\\\">\\n+      {/* Top Engine Control Strip */}\\n+      <div className=\\\"flex flex-wrap items-center justify-between gap-4 p-4 bg-slate-900 border border-slate-800 rounded-lg\\\">\\n+        <div>\\n+          <span className=\\\"text-[11px] font-medium text-slate-400 uppercase tracking-wider block mb-1\\\">\\n+            Person 2 Module · Python AI Engine\\n+          </span>\\n+          <div className=\\\"flex items-center gap-2\\\">\\n+            <h1 className=\\\"text-sm font-semibold text-slate-100 flex items-center gap-2\\\">\\n+              <Cpu className=\\\"w-4 h-4 text-emerald-400\\\" />\\n+              <span>NVIDIA API / LLM Code Intelligence Engine</span>\\n+            </h1>\\n+            <span className=\\\"text-xs text-slate-400\\\">by Vishnu G Pillai</span>\\n+          </div>\\n+        </div>\\n+\\n+        <div className=\\\"flex items-center gap-3\\\">\\n+          <div className=\\\"flex items-center gap-1.5 bg-slate-950 p-1 rounded-lg border border-slate-800 text-xs\\\">\\n+            <button\\n+              onClick={() => setProvider('nvidia')}\\n+              className={`px-3 py-1 font-medium rounded transition-colors ${\\n+                provider === 'nvidia' \\n+                  ? 'bg-emerald-600 text-white shadow-sm' \\n+                  : 'text-slate-400 hover:text-slate-200'\\n+              }`}\\n+            >\\n+              NVIDIA API (meta/llama-3.1-70b)\\n+            </button>\\n+            <button\\n+              onClick={() => setProvider('gemini')}\\n+              className={`px-3 py-1 font-medium rounded transition-colors ${\\n+                provider === 'gemini' \\n+                  ? 'bg-indigo-600 text-white shadow-sm' \\n+                  : 'text-slate-400 hover:text-slate-200'\\n+              }`}\\n+            >\\n+              Gemini API (gemini-2.5-flash)\\n+            </button>\\n+          </div>\\n+\\n+          <button\\n+            onClick={handleRunAnalysis}\\n+            disabled={isAnalyzing}\\n+            className=\\\"flex items-center gap-2 px-3.5 py-1.5 text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white rounded transition-colors shadow-sm disabled:opacity-50\\\"\\n+          >\\n+            {isAnalyzing ? (\\n+              <>\\n+                <div className=\\\"w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin\\\" />\\n+                <span>Interpreting Diff...</span>\\n+              </>\\n+            ) : (\\n+              <>\\n+                <Sparkles className=\\\"w-3.5 h-3.5\\\" />\\n+                <span>Re-Analyze with AI</span>\\n+              </>\\n+            )}\\n+          </button>\\n+        </div>\\n+      </div>\\n+\\n+      {/* Main 2-Column Split: Left = Structured JSON Contract & Schema Validation, Right = Interpreted Output & Anti-Hallucination Guardrails */}\\n+      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1\\\">\\n+        {/* Left Column: Output Contract JSON */}\\n+        <div className=\\\"lg:col-span-5 bg-slate-900 border border-slate-800 rounded-lg p-4 flex flex-col\\\">\\n+          <div className=\\\"flex items-center justify-between pb-3 border-b border-slate-800 mb-3\\\">\\n+            <div>\\n+              <h2 className=\\\"text-xs font-semibold text-slate-200 uppercase tracking-wider flex items-center gap-2\\\">\\n+                <Code2 className=\\\"w-4 h-4 text-emerald-400\\\" />\\n+                <span>Structured Output Contract (JSON)</span>\\n+              </h2>\\n+              <span className=\\\"text-[11px] text-slate-400\\\">Strict schema from Section 5</span>\\n+            </div>\\n+\\n+            <button\\n+              onClick={handleCopy}\\n+              className=\\\"flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700 transition-colors\\\"\\n+            >\\n+              {copiedJson ? (\\n+                <>\\n+                  <Check className=\\\"w-3.5 h-3.5 text-emerald-400\\\" />\\n+                  <span>Copied</span>\\n+                </>\\n+              ) : (\\n+                <>\\n+                  <Copy className=\\\"w-3.5 h-3.5\\\" />\\n+                  <span>Copy</span>\\n+                </>\\n+              )}\\n+            </button>\\n+          </div>\\n+\\n+          {/* Validation Chips */}\\n+          <div className=\\\"flex flex-wrap items-center gap-2 mb-3 text-[11px] text-slate-400 font-mono\\\">\\n+            <span className=\\\"text-emerald-400 flex items-center gap-1\\\">\\n+              <CheckCircle2 className=\\\"w-3 h-3\\\" /> title\\n+            </span>\\n+            <span className=\\\"text-slate-600\\\">·</span>\\n+            <span className=\\\"text-emerald-400 flex items-center gap-1\\\">\\n+              <CheckCircle2 className=\\\"w-3 h-3\\\" /> summary\\n+            </span>\\n+            <span className=\\\"text-slate-600\\\">·</span>\\n+            <span className=\\\"text-emerald-400 flex items-center gap-1\\\">\\n+              <CheckCircle2 className=\\\"w-3 h-3\\\" /> changedComponents\\n+            </span>\\n+            <span className=\\\"text-slate-600\\\">·</span>\\n+            <span className=\\\"text-emerald-400 flex items-center gap-1\\\">\\n+              <CheckCircle2 className=\\\"w-3 h-3\\\" /> technicalChanges\\n+            </span>\\n+            <span className=\\\"text-slate-600\\\">·</span>\\n+            <span className=\\\"text-emerald-400 flex items-center gap-1\\\">\\n+              <CheckCircle2 className=\\\"w-3 h-3\\\" /> technologies\\n+            </span>\\n+          </div>\\n+\\n+          <div className=\\\"flex-1 bg-slate-950 border border-slate-800 rounded-lg p-3 overflow-y-auto max-h-[540px] font-mono text-xs\\\">\\n+            <pre className=\\\"text-emerald-300 whitespace-pre-wrap leading-relaxed\\\">\\n+              {JSON.stringify(activeResponse, null, 2)}\\n+            </pre>\\n+          </div>\\n+        </div>\\n+\\n+        {/* Right Column: Interpreted Technical Meaning & Anti-Hallucination Guardrails */}\\n+        <div className=\\\"lg:col-span-7 bg-slate-900 border border-slate-800 rounded-lg p-4 flex flex-col space-y-4\\\">\\n+          {/* Card: Interpreted Feature & Changes */}\\n+          <div className=\\\"bg-slate-950 border border-slate-800 rounded-lg p-4\\\">\\n+            <div className=\\\"flex items-center justify-between mb-2\\\">\\n+              <span className=\\\"text-[11px] font-medium text-indigo-400 uppercase tracking-wider\\\">\\n+                Extracted Feature Intent\\n+              </span>\\n+              <span className=\\\"text-[11px] text-slate-400 font-mono\\\">\\n+                Model: {activeResponse.model} ({activeResponse.processingTimeMs}ms)\\n+              </span>\\n+            </div>\\n+            <h3 className=\\\"text-base font-bold text-slate-100 mb-2\\\">\\n+              {activeResponse.title}\\n+            </h3>\\n+            <p className=\\\"text-xs text-slate-300 leading-relaxed mb-3\\\">\\n+              {activeResponse.summary}\\n+            </p>\\n+            <div className=\\\"p-2.5 bg-slate-900/80 rounded border border-slate-800 text-xs text-slate-300\\\">\\n+              <strong className=\\\"text-slate-200\\\">Core Purpose:</strong> {activeResponse.purposeAndRationale}\\n+            </div>\\n+          </div>\\n+\\n+          {/* Card: Technical Changes Breakdown */}\\n+          <div className=\\\"bg-slate-950 border border-slate-800 rounded-lg p-4\\\">\\n+            <h4 className=\\\"text-xs font-semibold text-slate-200 uppercase tracking-wider mb-2.5\\\">\\n+              Verified Technical Changes ({activeResponse.technicalChanges.length})\\n+            </h4>\\n+            <div className=\\\"space-y-2\\\">\\n+              {activeResponse.technicalChanges.map((tc, idx) => (\\n+                <div key={idx} className=\\\"flex items-start gap-2.5 text-xs text-slate-300\\\">\\n+                  <div className=\\\"w-1.5 h-1.5 rounded-full bg-emerald-400 mt-1.5 shrink-0\\\" />\\n+                  <span>{tc}</span>\\n+                </div>\\n+              ))}\\n+            </div>\\n+          </div>\\n+\\n+          {/* Section 5 Anti-Hallucination Guardrail: Facts in Code vs Assumptions */}\\n+          <div className=\\\"bg-slate-950 border border-amber-900/40 rounded-lg p-4\\\">\\n+            <div className=\\\"flex items-center gap-2 text-amber-300 text-xs font-semibold uppercase tracking-wider mb-2\\\">\\n+              <ShieldCheck className=\\\"w-4 h-4\\\" />\\n+              <span>Anti-Hallucination &amp; Grounding Guardrails</span>\\n+            </div>\\n+            <p className=\\\"text-[11px] text-slate-400 mb-3\\\">\\n+              Per Section 5 of the VVA specification: <em>\\\"The AI should distinguish facts visible in the code from assumptions about the developer's intent. For example, it should not claim that a feature is secure or fully tested merely because a commit mentions authentication.\\\"</em>\\n+            </p>\\n+\\n+            <div className=\\\"space-y-2 text-xs\\\">\\n+              {activeResponse.observationsAndLimitations.map((obs, idx) => (\\n+                <div key={idx} className=\\\"flex items-start gap-2 p-2 bg-amber-950/20 border border-amber-900/30 rounded text-amber-200/90 text-[11px]\\\">\\n+                  <AlertTriangle className=\\\"w-3.5 h-3.5 text-amber-400 shrink-0 mt-0.5\\\" />\\n+                  <span>{obs}</span>\\n+                </div>\\n+              ))}\\n+            </div>\\n+          </div>\\n+\\n+          {/* Technologies Detected */}\\n+          <div className=\\\"bg-slate-950 border border-slate-800 rounded-lg p-3\\\">\\n+            <span className=\\\"text-[11px] font-medium text-slate-400 uppercase tracking-wider block mb-2\\\">\\n+              Identified Technology Stack\\n+            </span>\\n+            <div className=\\\"flex flex-wrap gap-2\\\">\\n+              {activeResponse.technologies.map(tech => (\\n+                <span key={tech} className=\\\"px-2.5 py-1 text-xs font-mono bg-slate-900 text-indigo-300 rounded border border-slate-800\\\">\\n+                  {tech}\\n+                </span>\\n+              ))}\\n+            </div>\\n+          </div>\\n+        </div>\\n+      </div>\\n+    </div>\\n+  );\\n+};\\ndiff --git a/src/components/ArchitectureView.tsx b/src/components/ArchitectureView.tsx\\nnew file mode 100644\\nindex 0000000..bffe745\\n--- /dev/null\\n+++ b/src/components/ArchitectureView.tsx\\n@@ -0,0 +1,274 @@\\n+import React, { useState } from 'react';\\n+import { Layers, ArrowRight, GitBranch, Cpu, FileText, Folder, Terminal, CheckCircle2, AlertCircle, FileCode } from 'lucide-react';\\n+\\n+interface StageInfo {\\n+  id: string;\\n+  number: string;\\n+  title: string;\\n+  owner: string;\\n+  technology: string;\\n+  description: string;\\n+  input: string;\\n+  output: string;\\n+  codeSnippet: string;\\n+  errorHandling: string;\\n+}\\n+\\n+export const ArchitectureView: React.FC = () => {\\n+  const [selectedStage, setSelectedStage] = useState<string>('stage-2');\\n+\\n+  const stages: StageInfo[] = [\\n+    {\\n+      id: 'stage-1',\\n+      number: '01',\\n+      title: 'Developer Git Workflow',\\n+      owner: 'Software Developer',\\n+      technology: 'Git CLI / IDE',\\n+      description: 'The developer works normally, modifying code and creating commits. VVA requires no deviation from standard Git practices.',\\n+      input: 'Developer edits, git add ., git commit -m \\\"...\\\"',\\n+      output: 'Git commit hash, updated branch reflog, commit trees',\\n+      codeSnippet: `git add src/tickets/ticket.controller.js\\n+git commit -m \\\"Add ticket filtering and status query parameters\\\"`,\\n+      errorHandling: 'Developer continues regular workflow; commits remain local or remote.'\\n+    },\\n+    {\\n+      id: 'stage-2',\\n+      number: '02',\\n+      title: 'VVA CLI & Orchestration Layer',\\n+      owner: 'Person 1 · Abhiram Binil',\\n+      technology: 'Node.js (ES Modules), Child Process',\\n+      description: 'Coordinates the entire system: verifies repository validity, checks if .vva is initialized, manages CLI arguments, and coordinates data flow between stages.',\\n+      input: 'vva report --commit <hash> --format all',\\n+      output: 'Process execution stream, logging, workflow orchestration',\\n+      codeSnippet: `// src/commands/report.js\\n+import { GitCollector } from '../core/collector.js';\\n+import { runPythonModule } from '../core/python.js';\\n+\\n+export async function reportCommand(options) {\\n+  const repo = await GitCollector.detectRepository();\\n+  const projectData = await GitCollector.collectCommitData(options.commit);\\n+  await saveJson('.vva/output/project-data.json', projectData);\\n+  \\n+  // Invoke Python AI Engine\\n+  await runPythonModule('ai/ai_engine.py', ['--input', '.vva/output/project-data.json']);\\n+  \\n+  // Invoke Python Document Generator\\n+  await runPythonModule('document-engine/document_generator.py', ['--format', options.format]);\\n+}`,\\n+      errorHandling: 'Detects missing .git folders, uncommitted detached HEAD states, missing Python binaries, and reports clear human-readable remediation messages.'\\n+    },\\n+    {\\n+      id: 'stage-3',\\n+      number: '03',\\n+      title: 'Git Data Collector',\\n+      owner: 'Person 1 · Abhiram Binil',\\n+      technology: 'Git CLI (git log, show, diff, rev-parse)',\\n+      description: 'Extracts commit-specific file versions, diffs, author metadata, and detects file status flags (A=Added, M=Modified, D=Deleted). Crucially retrieves the parent revision for deleted files.',\\n+      input: 'Target commit hash, worktree path',\\n+      output: '.vva/output/project-data.json',\\n+      codeSnippet: `// Commit-Specific File Snapshot Extraction\\n+export async function getCommittedFileVersion(commitHash, filePath, status) {\\n+  if (status === 'D') {\\n+    // Deleted file: inspect parent commit (commitHash~1)\\n+    return await execGit(\\\\`show \\\\${commitHash}~1:\\\\${filePath}\\\\`);\\n+  }\\n+  // Added or Modified: inspect target commit\\n+  return await execGit(\\\\`show \\\\${commitHash}:\\\\${filePath}\\\\`);\\n+}`,\\n+      errorHandling: 'Handles initial root commits without parents (`--root` flag), skips binary blobs, truncates massive diffs exceeding 1MB limit.'\\n+    },\\n+    {\\n+      id: 'stage-4',\\n+      number: '04',\\n+      title: 'Python AI Engine',\\n+      owner: 'Person 2 · Vishnu G Pillai',\\n+      technology: 'Python 3.11, NVIDIA API (meta/llama-3.1-70b)',\\n+      description: 'Reads project-data.json, constructs a rigorous system prompt, queries NVIDIA AI endpoint, and enforces strict JSON schema extraction with a