      "file": "src/commands/status.js",
      "status": "A",
      "additions": 0,
      "deletions": 0,
      "content": "import fs from 'node:fs/promises';\nimport path from 'node:path';\nimport { isGitRepo, getRepoRoot, getCurrentBranch, execGit, getCommitDetails } from '../core/git.js';\nimport { getPythonBinary } from '../core/python.js';\n\nexport async function statusCommand(cwd = process.cwd()) {\n  const isRepo = await isGitRepo(cwd);\n  if (!isRepo) {\n    return {\n      isGitRepo: false,\n      message: `Directory '${cwd}' is not inside a Git repository.`\n    };\n  }\n\n  const root = await getRepoRoot(cwd);\n  const branch = await getCurrentBranch(root);\n  const configFile = path.join(root, '.vva', 'config.json');\n\n  let isInitialized = false;\n  let config = null;\n  try {\n    const raw = await fs.readFile(configFile, 'utf8');\n    config = JSON.parse(raw);\n    isInitialized = true;\n  } catch {\n    isInitialized = false;\n  }\n\n  let latestCommit = null;\n  try {\n    const headHash = await execGit(['rev-parse', 'HEAD'], root);\n    latestCommit = await getCommitDetails(headHash, root);\n  } catch {\n    latestCommit = null; // Repo might have 0 commits\n  }\n\n  let uncommittedCount = 0;\n  try {\n    const statusRaw = await execGit(['status', '--porcelain'], root);\n    uncommittedCount = statusRaw ? statusRaw.split('\\n').filter(Boolean).length : 0;\n  } catch {\n    //\n  }\n\n  let pythonReady = false;\n  let pythonBin = null;\n  try {\n    pythonBin = await getPythonBinary();\n    pythonReady = true;\n  } catch {\n    pythonReady = false;\n  }\n\n  return {\n    isGitRepo: true,\n    repositoryName: path.basename(root),\n    repositoryPath: root,\n    branch,\n    isInitialized,\n    config,\n    latestCommit,\n    uncommittedCount,\n    pythonReady,\n    pythonBinary: pythonBin\n  };\n}"
    },
    {
      "file": "src/commands/watch.js",
      "status": "A",
      "additions": 0,
      "deletions": 0,
      "content": "import { getRepoRoot, execGit } from '../core/git.js';\nimport { reportCommand } from './report.js';\n\n/**\n * Watcher daemon that monitors Git HEAD ref updates.\n */\nexport async function watchCommand(options = {}, cwd = process.cwd(), onCommitDetected) {\n  const root = await getRepoRoot(cwd);\n  let lastKnownCommit = null;\n\n  try {\n    lastKnownCommit = await execGit(['rev-parse', 'HEAD'], root);\n  } catch {\n    //\n  }\n\n  const pollIntervalMs = options.intervalMs || 4000;\n  let isRunning = true;\n\n  const intervalId = setInterval(async () => {\n    if (!isRunning) return;\n    try {\n      const currentCommit = await execGit(['rev-parse', 'HEAD'], root);\n      if (currentCommit && currentCommit !== lastKnownCommit) {\n        lastKnownCommit = currentCommit;\n        if (onCommitDetected) {\n          onCommitDetected(currentCommit);\n        } else {\n          console.log(`[vva watch] New commit detected: ${currentCommit.slice(0, 7)}. Generating reports...`);\n          await reportCommand({ commit: currentCommit, format: options.format || 'all' }, root);\n        }\n      }\n    } catch {\n      //\n    }\n  }, pollIntervalMs);\n\n  return {\n    stop: () => {\n      isRunning = false;\n      clearInterval(intervalId);\n    }\n  };\n}"
    },
