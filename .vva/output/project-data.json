      "content": "import { execFile } from 'node:child_process';\nimport { promisify } from 'node:util';\nimport path from 'node:path';\nimport fs from 'node:fs/promises';\nimport { fileURLToPath } from 'node:url';\n\nconst execFileAsync = promisify(execFile);\n\n// src/core/python.js -> VVA package root\nconst VVA_PACKAGE_ROOT = path.resolve(\n  path.dirname(fileURLToPath(import.meta.url)),\n  '../..'\n);\n\n/**\n * Discovers the active Python binary (python3 or python).\n */\nexport async function getPythonBinary() {\n  try {\n    await execFileAsync('python3', ['--version']);\n    return 'python3';\n  } catch {\n    try {\n      await execFileAsync('python', ['--version']);\n      return 'python';\n    } catch {\n      throw new Error(\n        'Python 3 is required but neither \"python3\" nor \"python\" was found in PATH.'\n      );\n    }\n  }\n}\n\n/**\n * Runs an internal VVA Python script while using the target repository\n * as the working directory.\n *\n * @param {string} scriptRelativePath Path relative to the VVA package root.\n * @param {string[]} args Command-line arguments.\n * @param {string} cwd Target repository working directory.\n */\nexport async function invokePythonModule(\n  scriptRelativePath,\n  args = [],\n  cwd = process.cwd()\n) {\n  const pythonBin = await getPythonBinary();\n\n  // Internal scripts belong to VVA, not the target repository.\n  const scriptPath = path.resolve(VVA_PACKAGE_ROOT, scriptRelativePath);\n\n  try {\n    await fs.access(scriptPath);\n  } catch {\n    throw new Error(`VVA Python module not found at: ${scriptPath}`);\n  }\n\n  try {\n    const { stdout, stderr } = await execFileAsync(\n      pythonBin,\n      [scriptPath, ...args],\n      {\n        cwd,\n        maxBuffer: 20 * 1024 * 1024,\n        env: {\n          ...process.env,\n          PYTHONUNBUFFERED: '1'\n        }\n      }\n    );\n\n    if (stderr?.trim()) {\n      process.stderr.write(`[VVA Python warning] ${stderr.trim()}\\n`);\n    }\n\n    return stdout.trim();\n  } catch (error) {\n    throw new Error(\n      `Python execution failed for ${scriptRelativePath}: ${\n        error.stderr || error.message\n      }`\n    );\n  }\n}"
