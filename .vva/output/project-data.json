      "content": "export type FileStatus = 'A' | 'M' | 'D';\n\nexport interface ChangedFile {\n  file: string;\n  status: FileStatus; // A = Added, M = Modified, D = Deleted\n  additions: number;\n  deletions: number;\n  content: string; // Committed file content or pre-deletion content\n  diff: string; // The specific patch\n}\n\nexport interface GitCommit {\n  hash: string;\n  shortHash: string;\n  parentHash?: string;\n  author: string;\n  email: string;\n  date: string;\n  message: string;\n  branch: string;\n  changedFiles: ChangedFile[];\n  diffSummary: {\n    filesChanged: number;\n    insertions: number;\n    deletions: number;\n  };\n}\n\nexport interface Repository {\n  id: string;\n  name: string;\n  description: string;\n  path: string;\n  currentBranch: string;\n  branches: string[];\n  commits: GitCommit[];\n}\n\nexport interface ProjectDataJSON {\n  vvaVersion: string;\n  timestamp: string;\n  repository: string;\n  repositoryPath: string;\n  branch: string;\n  analyzedCommit: string;\n  parentCommit: string | null;\n  author: {\n    name: string;\n    email: string;\n    date: string;\n  };\n  commitMessage: string;\n  summary: {\n    filesChanged: number;\n    insertions: number;\n    deletions: number;\n  };\n  changedFiles: {\n    file: string;\n    status: FileStatus;\n    additions: number;\n    deletions: number;\n    content: string;\n  }[];\n  diff: string;\n}\n\nexport interface AIStructuredResponse {\n  title: string;\n  summary: string;\n  purposeAndRationale: string;\n  changedComponents: string[];\n  technicalChanges: string[];\n  technologies: string[];\n  architecturalImpact: string;\n  observationsAndLimitations: string[];\n  confidenceScore: number;\n  model: string;\n  processingTimeMs: number;\n}\n\nexport interface GeneratedDocument {\n  id: string;\n  type: 'pdf' | 'docx' | 'pptx';\n  filename: string;\n  title: string;\n  commitHash: string;\n  repository: string;\n  generatedAt: string;\n  fileSizeBytes: number;\n  content: any;\n}\n\nexport interface VVAConfig {\n  version: string;\n  defaultFormat: 'pdf' | 'docx' | 'pptx' | 'all';\n  outputDir: string;\n  aiProvider: 'nvidia' | 'gemini';\n  aiModel: string;\n  maxDiffSizeBytes: number;\n  includePreviousVersionOnDelete: boolean;\n  team: {\n    leadOrchestration: string;\n    aiEngine: string;\n    documentEngine: string;\n  };\n}"
